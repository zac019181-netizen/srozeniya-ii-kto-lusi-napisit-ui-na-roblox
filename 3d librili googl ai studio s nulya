function SoundManager:Play(soundName, volumeMult)
    if not Library.SoundEnabled then return end
    local id = self.Sounds[soundName] or soundName
    if not id then return end

    local sound = Instance.new("Sound")
    sound.SoundId = id
    sound.Volume = Library.SoundVolume * (volumeMult or 1)
    sound.Parent = workspace
    sound:Play()

    sound.Ended:Connect(function()
        sound:Destroy()
    end)
    task.delay(3, function()
        if sound and sound.Parent then
            sound:Destroy()
        end
    end)
end

