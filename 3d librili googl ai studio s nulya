-- ============================================================================
-- [8] GLOBAL LIBRARY CONTROLS
-- ============================================================================
function Library:Notify(config)
    NotificationManager:Notify(config)
end

function Library:SetTheme(themeName)
    ThemeManager:ApplyTheme(themeName)
end

function Library:RegisterTheme(name, themeData)
    ThemeManager.Themes[name] = themeData
end

function Library:SetFont(font, boldFont)
    FontManager:ApplyFont(font, boldFont)
end

function Library:SetScale(scaleValue)
    Library.UIScale = scaleValue
    if Library.ActiveWindow and Library.ActiveWindow.Gui then
        local scale = Library.ActiveWindow.Gui:FindFirstChildOfClass("UIScale")
        if scale then scale.Scale = scaleValue end
    end
end

function Library:SetAnimations(state)
    Library.AnimationsEnabled = state
end

function Library:SetSoundEnabled(state)
    Library.SoundEnabled = state
end

function Library:SetSoundVolume(vol)
    Library.SoundVolume = math.clamp(vol, 0, 1)
end

function Library:ToggleUI()
    if not Library.ActiveWindow or not Library.ActiveWindow.Root then return end
    Library.Toggled = not Library.Toggled
    Library.ActiveWindow.Root.Visible = Library.Toggled
end

function Library:SaveConfig(name)
    return ConfigManager:Save(name)
end

function Library:LoadConfig(name)
    return ConfigManager:Load(name)
end

function Library:DeleteConfig(name)
    return ConfigManager:Delete(name)
end

function Library:GetConfigs()
    return ConfigManager:GetConfigs()
end

function Library:Destroy()
    Library.Unloaded = true
    if Library.ActiveWindow and Library.ActiveWindow.Maid then
        Library.ActiveWindow.Maid:DoCleaning()
    end
    table.clear(Library.Registry)
    table.clear(Library.Signals)
    table.clear(Library.Flags)
end

return Library
