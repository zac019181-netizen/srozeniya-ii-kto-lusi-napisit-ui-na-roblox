local ConfigManager = {}

function ConfigManager:Init()
    if typeof(isfolder) == "function" and typeof(makefolder) == "function" then
        if not isfolder(Library.Folder) then
            makefolder(Library.Folder)
        end
    end
end

function ConfigManager:Save(name)
    if not name or name == "" then return false, "Invalid Name" end
    local data = {}
    for flag, value in pairs(Library.Flags) do
        if typeof(value) == "EnumItem" then
            data[flag] = { __type = "EnumItem", name = tostring(value) }
        elseif typeof(value) == "Color3" then
            data[flag] = { __type = "Color3", r = value.R, g = value.G, b = value.B }
        else
            data[flag] = value
        end
    end

    local encoded = HttpService:JSONEncode(data)
    if typeof(writefile) == "function" then
        local success, err = pcall(function()
            writefile(Library.Folder .. "/" .. name .. ".json", encoded)
        end)
        if success then
            Library:Notify({ Title = "Config", Description = "Saved config: " .. name, Type = "Success", Duration = 3 })
            return true
        else
            Library:Notify({ Title = "Config Error", Description = tostring(err), Type = "Error", Duration = 4 })
            return false, err
        end
    end
    return false, "FileSystem API not supported"
end

function ConfigManager:Load(name)
    if not name or name == "" then return false, "Invalid Name" end
    local path = Library.Folder .. "/" .. name .. ".json"
    if typeof(readfile) == "function" and typeof(isfile) == "function" then
        if not isfile(path) then
            Library:Notify({ Title = "Config Error", Description = "File not found: " .. name, Type = "Error", Duration = 3 })
            return false, "File not found"
        end

        local success, content = pcall(readfile, path)
        if not success then return false, content end

        local decodeSuccess, data = pcall(HttpService.JSONDecode, HttpService, content)
        if not decodeSuccess then return false, data end

        for flag, val in pairs(data) do
            if Library.Signals[flag] then
                if typeof(val) == "table" and val.__type == "EnumItem" then
                    -- Parse KeyCode
                    local keyName = string.match(val.name, "Enum%.KeyCode%.(.*)")
                    if keyName and Enum.KeyCode[keyName] then
                        Library.Signals[flag](Enum.KeyCode[keyName])
                    end
                else
                    Library.Signals[flag](val)
                end
            end
        end
        Library:Notify({ Title = "Config", Description = "Loaded config: " .. name, Type = "Success", Duration = 3 })
        return true
    end
    return false, "FileSystem API not supported"
end

function ConfigManager:GetConfigs()
    local list = {}
    if typeof(listfiles) == "function" and typeof(isfolder) == "function" then
        if isfolder(Library.Folder) then
            for _, filePath in ipairs(listfiles(Library.Folder)) do
                local name = filePath:match("([^/\\]+)%.json$")
                if name then
                    table.insert(list, name)
                end
            end
        end
    end
    return list
end

function ConfigManager:Delete(name)
    local path = Library.Folder .. "/" .. name .. ".json"
    if typeof(delfile) == "function" and typeof(isfile) == "function" then
        if isfile(path) then
            delfile(path)
            Library:Notify({ Title = "Config", Description = "Deleted config: " .. name, Type = "Info", Duration = 3 })
            return true
        end
    end
    return false
end

