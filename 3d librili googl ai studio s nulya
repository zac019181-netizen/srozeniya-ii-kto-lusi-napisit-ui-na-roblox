-- ─────────────────────────────────────────────────────────────────────────────
-- HELPER FUNCTIONS & CREATORS
-- ─────────────────────────────────────────────────────────────────────────────
local function GetThemeColor(key: string): Color3
    local theme = Library.Themes[Library.CurrentTheme] or Library.Themes.Dark
    return theme[key] or Color3.fromRGB(255, 255, 255)
end

function Library:RegisterThemeElement(instance: GuiObject, property: string, themeKey: string)
    table.insert(Library.ThemeElements, {
        Instance = instance,
        Property = property,
        ThemeKey = themeKey
    })
    (instance :: any)[property] = GetThemeColor(themeKey)
end

function Library:RegisterFontElement(instance: TextLabel | TextButton | TextBox)
    table.insert(Library.FontElements, instance)
    instance.Font = Library.CurrentFont
end

local function CreateInstance<T>(className: string, properties: { [string]: any }): T
    local inst = Instance.new(className)
    for prop, val in pairs(properties) do
        if prop == "ThemeColor" then
            Library:RegisterThemeElement(inst, val.Property, val.Key)
        elseif prop == "ThemeFont" and (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")) then
            Library:RegisterFontElement(inst)
        else
            (inst :: any)[prop] = val
        end
    end
    return inst :: any
end

function Library:PlaySound(name: string)
    if not self.SoundEnabled or not self.Sounds[name] then return end
    task.spawn(function()
        local sound = Instance.new("Sound")
        sound.SoundId = self.Sounds[name]
        sound.Volume = self.SoundVolume
        sound.Parent = SoundService
        sound:Play()
        sound.Ended:Connect(function()
            sound:Destroy()
        end)
    end)
end

-- ─────────────────────────────────────────────────────────────────────────────
-- 3D CONTAINER & PART MANAGEMENT
-- ─────────────────────────────────────────────────────────────────────────────
local function CalculateTargetCFrame(): CFrame
    if not Library.RootPart then return CFrame.new() end
    local root = Library.RootPart
    local forwardPos = root.Position + (root.CFrame.LookVector * Library.Distance) + Vector3.new(0, Library.VerticalOffset, 0)

    if Library.Floating then
        local floatY = math.sin(os.clock() * Library.FloatingSpeed) * Library.FloatingAmplitude
        forwardPos = forwardPos + Vector3.new(0, floatY, 0)
    end

    local lookTarget = Library.AlwaysFacePlayer and (root.Position + Vector3.new(0, Library.VerticalOffset, 0)) or (forwardPos + root.CFrame.LookVector)
    return CFrame.lookAt(forwardPos, lookTarget)
end

function Library:SetupCharacterTracking()
    local function OnCharacterAdded(char: Model)
        Library.Character = char
        Library.RootPart = char:WaitForChild("HumanoidRootPart", 5) :: BasePart
        if Library.RootPart and Library.IsOpen then
            Library:UpdatePlacement(true)
        end
    end

    if LocalPlayer.Character then
        OnCharacterAdded(LocalPlayer.Character)
    end

    Library.Connections["CharacterAdded"] = LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)
    Library.Connections["CharacterRemoving"] = LocalPlayer.CharacterRemoving:Connect(function()
        Library.Character = nil
        Library.RootPart = nil
    end)
end

function Library:Init3DWorld()
    if self.Container and self.Container.Parent then return end

    local container = Instance.new("Model")
    container.Name = "3D_UI_Container"
    container.Parent = workspace
    self.Container = container

    local part = Instance.new("Part")
    part.Name = "3D_UI_Panel"
    part.Size = self.PanelSize
    part.Anchored = true
    part.CanCollide = false
    part.CanTouch = false
    part.CanQuery = false
    part.CastShadow = false
    part.Material = Enum.Material.SmoothPlastic
    part.Transparency = self.PartTransparency
    part.Color = Color3.fromRGB(0, 0, 0)
    part.Parent = container
    self.PanelPart = part

    local surfaceGui = Instance.new("SurfaceGui")
    surfaceGui.Name = "SurfaceUI"
    surfaceGui.Face = Enum.NormalId.Front
    surfaceGui.CanvasSize = Vector2.new(1000, 625)
    surfaceGui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
    surfaceGui.AlwaysOnTop = self.AlwaysOnTop
    surfaceGui.ClipsDescendants = true
    surfaceGui.Active = true
    surfaceGui.Adornee = part
    surfaceGui.Parent = container
    self.SurfaceGui = surfaceGui

    local mainGroup = Instance.new("CanvasGroup")
    mainGroup.Name = "MainCanvasGroup"
    mainGroup.Size = UDim2.new(1, 0, 1, 0)
    mainGroup.BackgroundTransparency = 1
    mainGroup.GroupTransparency = 0
    mainGroup.Parent = surfaceGui
    self.MainGroup = mainGroup

    -- Global Notification Layer inside SurfaceGui
    local notifyContainer = Instance.new("Frame")
    notifyContainer.Name = "NotificationContainer"
    notifyContainer.Size = UDim2.new(0, 320, 1, -20)
    notifyContainer.Position = UDim2.new(1, -330, 0, 10)
    notifyContainer.BackgroundTransparency = 1
    notifyContainer.ZIndex = 100
    notifyContainer.Parent = mainGroup

    local notifyLayout = Instance.new("UIListLayout")
    notifyLayout.SortOrder = Enum.SortOrder.LayoutOrder
    notifyLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    notifyLayout.Padding = UDim.new(0, 8)
    notifyLayout.Parent = notifyContainer

    self:SetupCharacterTracking()

    -- Central Render/Follow Loop
    self.Connections["FollowLoop"] = RunService.Heartbeat:Connect(function(dt)
        if not self.RootPart or not self.PanelPart or not self.IsOpen then return end
        if self.FollowPlayer or self.Floating then
            local targetCF = CalculateTargetCFrame()
            if self.FollowPlayer then
                self.PanelPart.CFrame = self.PanelPart.CFrame:Lerp(targetCF, math.clamp(dt * 10, 0, 1))
            else
                self.PanelPart.CFrame = targetCF
            end
        end
    end)

    -- Toggle Binding Loop
    self.Connections["InputBinding"] = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == self.ToggleKey then
            self:Toggle()
        end
    end)
end

function Library:UpdatePlacement(instant: boolean)
    if not self.PanelPart or not self.RootPart then return end
    local targetCF = CalculateTargetCFrame()
    if instant then
        self.PanelPart.CFrame = targetCF
    else
        TweenService:Create(self.PanelPart, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            CFrame = targetCF,
            Size = self.PanelSize
        }):Play()
    end
end

-- ─────────────────────────────────────────────────────────────────────────────
-- OPEN / CLOSE ANIMATIONS
-- ─────────────────────────────────────────────────────────────────────────────
function Library:Toggle()
    if self.IsOpen then
        self:Close()
    else
        self:Open()
    end
end

function Library:Open()
    if self.IsOpen or self.IsAnimating or not self.PanelPart or not self.MainGroup or not self.SurfaceGui then return end
    self.IsAnimating = true
    self.IsOpen = true
    self.SurfaceGui.Enabled = true

    self:UpdatePlacement(true)
    self:PlaySound("Open")

    local tweenInfo = TweenInfo.new(self.AnimationSpeed, self.AnimationEasing, self.AnimationDirection)

    if self.OpenAnimation == "Transparency" then
        self.MainGroup.GroupTransparency = 1
        self.PanelPart.Transparency = 1
        local t1 = TweenService:Create(self.MainGroup, tweenInfo, { GroupTransparency = 0 })
        local t2 = TweenService:Create(self.PanelPart, tweenInfo, { Transparency = self.PartTransparency })
        t1:Play()
        t2:Play()
        t1.Completed:Wait()

    elseif self.OpenAnimation == "Slide" then
        local targetCF = self.PanelPart.CFrame
        local slideOffset = (self.SlideDirection == "Down" and Vector3.new(0, -6, 0)) or Vector3.new(0, 6, 0)
        self.PanelPart.CFrame = targetCF + slideOffset
        self.MainGroup.GroupTransparency = 1

        local t1 = TweenService:Create(self.PanelPart, tweenInfo, { CFrame = targetCF })
        local t2 = TweenService:Create(self.MainGroup, tweenInfo, { GroupTransparency = 0 })
        t1:Play()
        t2:Play()
        t1.Completed:Wait()

    elseif self.OpenAnimation == "Collapse" then
        local targetSize = self.PanelSize
        self.PanelPart.Size = Vector3.new(0.01, 0.01, 0.01)
        self.MainGroup.GroupTransparency = 1

        local t1 = TweenService:Create(self.PanelPart, tweenInfo, { Size = targetSize })
        local t2 = TweenService:Create(self.MainGroup, tweenInfo, { GroupTransparency = 0 })
        t1:Play()
        t2:Play()
        t1.Completed:Wait()
    end

    self.IsAnimating = false
end

function Library:Close()
    if not self.IsOpen or self.IsAnimating or not self.PanelPart or not self.MainGroup or not self.SurfaceGui then return end
    self.IsAnimating = true
    self:PlaySound("Close")

    -- Safely close any active dropdown
    if self.ActiveDropdown and self.ActiveDropdown.Close then
        self.ActiveDropdown:Close()
    end

    local tweenInfo = TweenInfo.new(self.AnimationSpeed, self.AnimationEasing, Enum.EasingDirection.In)

    if self.OpenAnimation == "Transparency" then
        local t1 = TweenService:Create(self.MainGroup, tweenInfo, { GroupTransparency = 1 })
        local t2 = TweenService:Create(self.PanelPart, tweenInfo, { Transparency = 1 })
        t1:Play()
        t2:Play()
        t1.Completed:Wait()

    elseif self.OpenAnimation == "Slide" then
        local slideOffset = (self.SlideDirection == "Down" and Vector3.new(0, -6, 0)) or Vector3.new(0, 6, 0)
        local t1 = TweenService:Create(self.PanelPart, tweenInfo, { CFrame = self.PanelPart.CFrame + slideOffset })
        local t2 = TweenService:Create(self.MainGroup, tweenInfo, { GroupTransparency = 1 })
        t1:Play()
        t2:Play()
        t1.Completed:Wait()

    elseif self.OpenAnimation == "Collapse" then
        local t1 = TweenService:Create(self.PanelPart, tweenInfo, { Size = Vector3.new(0.01, 0.01, 0.01) })
        local t2 = TweenService:Create(self.MainGroup, tweenInfo, { GroupTransparency = 1 })
        t1:Play()
        t2:Play()
        t1.Completed:Wait()
        self.PanelPart.Size = self.PanelSize
    end

    self.SurfaceGui.Enabled = false
    self.IsOpen = false
    self.IsAnimating = false
end

-- ─────────────────────────────────────────────────────────────────────────────
-- NOTIFICATION SYSTEM (IN 3D)
-- ─────────────────────────────────────────────────────────────────────────────
export type NotifyConfig = {
    Title: string,
    Description: string,
    Duration: number?,
    Type: ("Success" | "Warning" | "Error" | "Info")?
}

function Library:Notify(config: NotifyConfig)
    if not self.MainGroup then return end
    local container = self.MainGroup:FindFirstChild("NotificationContainer") :: Frame?
    if not container then return end

    local notifType = config.Type or "Info"
    local duration = config.Duration or 4

    self:PlaySound("Notification")

    local card = CreateInstance("Frame", {
        Name = "Notification",
        Size = UDim2.new(1, 0, 0, 75),
        Position = UDim2.new(1, 350, 0, 0),
        BackgroundColor3 = GetThemeColor("Card"),
        BackgroundTransparency = 0.05,
        ClipsDescendants = true,
        Parent = container
    })

    CreateInstance("UICorner", { CornerRadius = UDim.new(0, 8), Parent = card })
    CreateInstance("UIStroke", {
        Color = GetThemeColor(notifType) or GetThemeColor("Border"),
        Thickness = 1.5,
        Parent = card
    })

    local accentBar = CreateInstance("Frame", {
        Size = UDim2.new(0, 4, 1, 0),
        BackgroundColor3 = GetThemeColor(notifType),
        BorderSizePixel = 0,
        Parent = card
    })

    local titleLabel = CreateInstance("TextLabel", {
        Size = UDim2.new(1, -20, 0, 24),
        Position = UDim2.new(0, 14, 0, 6),
        BackgroundTransparency = 1,
        Text = config.Title,
        TextColor3 = GetThemeColor(notifType),
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Left,
        ThemeFont = true,
        Parent = card
    })

    local descLabel = CreateInstance("TextLabel", {
        Size = UDim2.new(1, -20, 0, 40),
        Position = UDim2.new(0, 14, 0, 28),
        BackgroundTransparency = 1,
        Text = config.Description,
        TextColor3 = GetThemeColor("Text"),
        TextSize = 13,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ThemeFont = true,
        Parent = card
    })

    -- Slide in
    TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()

    task.delay(duration, function()
        if not card or not card.Parent then return end
        local outTween = TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 350, 0, 0)
        })
        outTween:Play()
        outTween.Completed:Connect(function()
            card:Destroy()
        end)
    end)
end

-- ─────────────────────────────────────────────────────────────────────────────
-- THEMES & FONTS DYNAMIC SWITCHING
-- ─────────────────────────────────────────────────────────────────────────────
function Library:RegisterTheme(name: string, themeData: { [string]: Color3 })
    self.Themes[name] = themeData
end

function Library:SetTheme(name: string)
    if not self.Themes[name] then return end
    self.CurrentTheme = name
    for _, item in ipairs(self.ThemeElements) do
        if item.Instance and item.Instance.Parent then
            local color = GetThemeColor(item.ThemeKey)
            TweenService:Create(item.Instance, TweenInfo.new(0.25), {
                [item.Property] = color
            }):Play()
        end
    end
end

function Library:SetFont(font: Enum.Font)
    self.CurrentFont = font
    for _, label in ipairs(self.FontElements) do
        if label and label.Parent then
            label.Font = font
        end
    end
end

function Library:SetToggleKey(key: Enum.KeyCode)
    self.ToggleKey = key
end

function Library:GetToggleKey(): Enum.KeyCode
    return self.ToggleKey
end

function Library:SetFollowPlayer(state: boolean)
    self.FollowPlayer = state
    if not state and self.PanelPart then
        self.BaseCFrame = self.PanelPart.CFrame
    end
end

function Library:SetDistance(dist: number)
    self.Distance = dist
    self:UpdatePlacement(false)
end

function Library:SetVerticalOffset(offset: number)
    self.VerticalOffset = offset
    self:UpdatePlacement(false)
end

function Library:SetPanelSize(size: Vector3)
    self.PanelSize = size
    if self.PanelPart then
        self.PanelPart.Size = size
    end
end

function Library:SetSoundEnabled(enabled: boolean)
    self.SoundEnabled = enabled
end

function Library:SetSoundVolume(vol: number)
    self.SoundVolume = math.clamp(vol, 0, 1)
end

function Library:SetSound(name: string, id: string)
    self.Sounds[name] = id
end

-- ─────────────────────────────────────────────────────────────────────────────
-- CONFIG SYSTEM (Safe File System Interop)
-- ─────────────────────────────────────────────────────────────────────────────
local function HasFileSystem(): boolean
    return (type(readfile) == "function" and type(writefile) == "function" and type(isfile) == "function")
end

function Library:SaveConfig(name: string): boolean
    local data = {
        Theme = self.CurrentTheme,
        Font = self.CurrentFont.Name,
        Distance = self.Distance,
        VerticalOffset = self.VerticalOffset,
        PanelSize = { self.PanelSize.X, self.PanelSize.Y, self.PanelSize.Z },
        ToggleKey = self.ToggleKey.Name,
        OpenAnimation = self.OpenAnimation,
        AnimationSpeed = self.AnimationSpeed,
        FollowPlayer = self.FollowPlayer,
        Floating = self.Floating,
        PartTransparency = self.PartTransparency,
        SoundEnabled = self.SoundEnabled,
        SoundVolume = self.SoundVolume,
    }
    local encoded = HttpService:JSONEncode(data)
    if HasFileSystem() then
        pcall(function()
            writefile("3D_UI_Config_" .. name .. ".json", encoded)
        end)
        self:Notify({ Title = "Config Saved", Description = "Config '" .. name .. "' successfully saved.", Type = "Success" })
        return true
    end
    return false
end

function Library:LoadConfig(name: string): boolean
    if not HasFileSystem() then return false end
    local filename = "3D_UI_Config_" .. name .. ".json"
    if not isfile(filename) then
        self:Notify({ Title = "Error", Description = "Config file not found.", Type = "Error" })
        return false
    end

    local success, content = pcall(readfile, filename)
    if not success then return false end

    local parseSuccess, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not parseSuccess or type(data) ~= "table" then return false end

    if data.Theme then self:SetTheme(data.Theme) end
    if data.Font and (Enum.Font :: any)[data.Font] then self:SetFont((Enum.Font :: any)[data.Font]) end
    if data.Distance then self:SetDistance(data.Distance) end
    if data.VerticalOffset then self:SetVerticalOffset(data.VerticalOffset) end
    if data.PanelSize then self:SetPanelSize(Vector3.new(unpack(data.PanelSize))) end
    if data.ToggleKey and (Enum.KeyCode :: any)[data.ToggleKey] then self:SetToggleKey((Enum.KeyCode :: any)[data.ToggleKey]) end
    if data.OpenAnimation then self.OpenAnimation = data.OpenAnimation end
    if data.AnimationSpeed then self.AnimationSpeed = data.AnimationSpeed end
    if data.FollowPlayer ~= nil then self:SetFollowPlayer(data.FollowPlayer) end
    if data.Floating ~= nil then self.Floating = data.Floating end
    if data.PartTransparency ~= nil then self.PartTransparency = data.PartTransparency end
    if data.SoundEnabled ~= nil then self.SoundEnabled = data.SoundEnabled end
    if data.SoundVolume ~= nil then self.SoundVolume = data.SoundVolume end

    self:Notify({ Title = "Config Loaded", Description = "Config '" .. name .. "' loaded successfully.", Type = "Success" })
    return true
end

function Library:DeleteConfig(name: string): boolean
    if not HasFileSystem() then return false end
    local filename = "3D_UI_Config_" .. name .. ".json"
    if isfile(filename) then
        pcall(delfile, filename)
        self:Notify({ Title = "Config Deleted", Description = "Config removed.", Type = "Info" })
        return true
    end
    return false
end

function Library:GetConfigs(): { string }
    local list = {}
    if HasFileSystem() and type(listfiles) == "function" then
        pcall(function()
            for _, path in ipairs(listfiles("")) do
                local match = string.match(path, "3D_UI_Config_(.+)%.json")
                if match then table.insert(list, match) end
            end
        end)
    end
    return list
end

