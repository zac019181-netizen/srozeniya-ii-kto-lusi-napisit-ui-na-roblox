function ThemeManager:GetColor(key)
    local theme = self.Themes[self.CurrentTheme] or self.Themes.Dark
    return theme[key] or Color3.fromRGB(255, 255, 255)
end

function ThemeManager:Subscribe(instance, property, colorKey)
    local entry = { Instance = instance, Property = property, Key = colorKey }
    table.insert(self.Subscribers, entry)
    instance[property] = self:GetColor(colorKey)

    local conn
    conn = instance.AncestryChanged:Connect(function(_, parent)
        if not parent then
            conn:Disconnect()
            for idx, sub in ipairs(self.Subscribers) do
                if sub == entry then
                    table.remove(self.Subscribers, idx)
                    break
                end
            end
        end
    end)
end

function ThemeManager:ApplyTheme(themeName)
    if not self.Themes[themeName] then return end
    self.CurrentTheme = themeName
    for _, sub in ipairs(self.Subscribers) do
        if sub.Instance and sub.Instance.Parent then
            local targetColor = self:GetColor(sub.Key)
            if Library.AnimationsEnabled then
                TweenService:Create(sub.Instance, TweenInfo.new(Library.AnimationSpeed, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    [sub.Property] = targetColor
                }):Play()
            else
                sub.Instance[sub.Property] = targetColor
            end
        end
    end
end

local FontManager = {
    Subscribers = {}
}

function FontManager:Subscribe(textInstance, isBold)
    local entry = { Instance = textInstance, Bold = isBold or false }
    table.insert(self.Subscribers, entry)
    textInstance.Font = isBold and Library.CurrentFontBold or Library.CurrentFont

    local conn
    conn = textInstance.AncestryChanged:Connect(function(_, parent)
        if not parent then
            conn:Disconnect()
            for idx, sub in ipairs(self.Subscribers) do
                if sub == entry then
                    table.remove(self.Subscribers, idx)
                    break
                end
            end
        end
    end)
end

function FontManager:ApplyFont(regularFont, boldFont)
    Library.CurrentFont = regularFont
    Library.CurrentFontBold = boldFont or regularFont
    for _, sub in ipairs(self.Subscribers) do
        if sub.Instance and sub.Instance.Parent then
            sub.Instance.Font = sub.Bold and Library.CurrentFontBold or Library.CurrentFont
        end
    end
end

