            local nameLabel = CreateInstance("TextLabel", {
                Size = UDim2.new(0.6, 0, 0, 20),
                Position = UDim2.new(0, 12, 0, 6),
                BackgroundTransparency = 1,
                Text = sliderConfig.Name,
                TextColor3 = GetThemeColor("Text"),
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                ThemeFont = true,
                Parent = card
            })
            Library:RegisterThemeElement(nameLabel, "TextColor3", "Text")

            local valLabel = CreateInstance("TextLabel", {
                Size = UDim2.new(0.35, 0, 0, 20),
                Position = UDim2.new(0.65, -12, 0, 6),
                BackgroundTransparency = 1,
                Text = tostring(currentVal) .. suffix,
                TextColor3 = GetThemeColor("Accent"),
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Right,
                ThemeFont = true,
                Parent = card
            })
            Library:RegisterThemeElement(valLabel, "TextColor3", "Accent")

            local barBg = CreateInstance("TextButton", {
                Size = UDim2.new(1, -24, 0, 8),
                Position = UDim2.new(0, 12, 0, 32),
                BackgroundColor3 = GetThemeColor("Sidebar"),
                AutoButtonColor = false,
                Text = "",
                Parent = card
            })
            CreateInstance("UICorner", { CornerRadius = UDim.new(1, 0), Parent = barBg })
            Library:RegisterThemeElement(barBg, "BackgroundColor3", "Sidebar")

            local fill = CreateInstance("Frame", {
                Size = UDim2.new((currentVal - min) / (max - min), 0, 1, 0),
                BackgroundColor3 = GetThemeColor("Accent"),
                BorderSizePixel = 0,
                Parent = barBg
            })
            CreateInstance("UICorner", { CornerRadius = UDim.new(1, 0), Parent = fill })
            Library:RegisterThemeElement(fill, "BackgroundColor3", "Accent")

            local SliderObj = {}

            local function Round(num: number, places: number): number
                local mult = 10 ^ places
                return math.floor(num * mult + 0.5) / mult
            end

            local function Update(inputX: number)
                local percent = math.clamp((inputX - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
                local rawVal = min + (max - min) * percent
                currentVal = Round(rawVal, rounding)
                valLabel.Text = tostring(currentVal) .. suffix
                fill.Size = UDim2.new(percent, 0, 1, 0)
                if sliderConfig.Callback then sliderConfig.Callback(currentVal) end
            end

            local isDragging = false

            barBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isDragging = true
                    Update(input.Position.X)
                    Library:PlaySound("Click")
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    isDragging = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    Update(input.Position.X)
                end
            end)

            function SliderObj:SetValue(val: number)
                currentVal = math.clamp(Round(val, rounding), min, max)
                valLabel.Text = tostring(currentVal) .. suffix
                local percent = (currentVal - min) / (max - min)
                fill.Size = UDim2.new(percent, 0, 1, 0)
                if sliderConfig.Callback then sliderConfig.Callback(currentVal) end
            end

            function SliderObj:GetValue(): number
                return currentVal
            end

            function SliderObj:Destroy()
                card:Destroy()
            end

            return SliderObj
        end

