        -- ─────────────────────────────────────────────────────────────────────
        function TabObj:AddSlider(sliderConfig: {
            Name: string,
            Min: number,
            Max: number,
            Default: number?,
            Rounding: number?,
            Suffix: string?,
            Callback: ((number) -> ())?
        })
            local min = sliderConfig.Min or 0
            local max = sliderConfig.Max or 100
            local rounding = sliderConfig.Rounding or 0
            local suffix = sliderConfig.Suffix or ""
            local currentVal = math.clamp(sliderConfig.Default or min, min, max)

            local card = CreateInstance("Frame", {
                Name = "Slider_" .. sliderConfig.Name,
                Size = UDim2.new(1, 0, 0, 52),
                BackgroundColor3 = GetThemeColor("Card"),
                Parent = tabPage
