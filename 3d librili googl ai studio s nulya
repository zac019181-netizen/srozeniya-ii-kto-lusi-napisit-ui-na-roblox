            Arrow.BackgroundTransparency = 1
            Arrow.Text = "▼"
            Arrow.TextColor3 = ThemeManager:GetColor("TextDark")
            Arrow.TextSize = 10
            Arrow.Parent = DropFrame
            ThemeManager:Subscribe(Arrow, "TextColor3", "TextDark")

            local function FormatSelected()
                if Multi then
                    local list = {}
                    for opt, val in pairs(Selected) do
                        if val then table.insert(list, opt) end
                    end
                    return #list > 0 and table.concat(list, ", ") or "None"
                else
                    return tostring(Selected)
                end
            end
            SelectedLabel.Text = FormatSelected()

            -- Overlay Floating Popout Menu
            local Menu = Instance.new("Frame")
            Menu.Name = "DropdownMenu_" .. Name
            Menu.Size = UDim2.new(0, 0, 0, 0)
