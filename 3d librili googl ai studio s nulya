            ValLabel.TextXAlignment = Enum.TextXAlignment.Right
            ValLabel.Parent = SliderFrame
            FontManager:Subscribe(ValLabel, true)
            ThemeManager:Subscribe(ValLabel, "TextColor3", "Accent")

            local Track = Instance.new("Frame")
            Track.Size = UDim2.new(1, -24, 0, 6)
            Track.Position = UDim2.new(0, 12, 0, 32)
            Track.BackgroundColor3 = ThemeManager:GetColor("Tertiary")
            Track.BorderSizePixel = 0
            Track.Parent = SliderFrame
            ThemeManager:Subscribe(Track, "BackgroundColor3", "Tertiary")

            local TrackCorner = Instance.new("UICorner")
            TrackCorner.CornerRadius = UDim.new(1, 0)
            TrackCorner.Parent = Track

            local Fill = Instance.new("Frame")
            local initialPercent = (CurrentValue - Min) / (Max - Min)
            Fill.Size = UDim2.new(initialPercent, 0, 1, 0)
            Fill.BackgroundColor3 = ThemeManager:GetColor("Accent")
            Fill.BorderSizePixel = 0
            Fill.Parent = Track
            ThemeManager:Subscribe(Fill, "BackgroundColor3", "Accent")

            local FillCorner = Instance.new("UICorner")
            FillCorner.CornerRadius = UDim.new(1, 0)
            FillCorner.Parent = Fill

            local Sliding = false

            local function UpdateSlider(input)
                local absPos = Track.AbsolutePosition.X
                local absSize = Track.AbsoluteSize.X
                local inputX = input.Position.X
                local percent = math.clamp((inputX - absPos) / absSize, 0, 1)
                local rawVal = Min + (Max - Min) * percent
                local finalVal = Round(rawVal, Rounding)

                CurrentValue = finalVal
                Library.Flags[Flag] = CurrentValue
                ValLabel.Text = tostring(CurrentValue) .. Suffix
                Fill.Size = UDim2.new(percent, 0, 1, 0)
                SafeCallback(Callback, CurrentValue)
            end

            local function SetValue(val, skipCallback)
                CurrentValue = math.clamp(Round(val, Rounding), Min, Max)
                Library.Flags[Flag] = CurrentValue
                ValLabel.Text = tostring(CurrentValue) .. Suffix
                local percent = (CurrentValue - Min) / (Max - Min)
                AnimationManager:Tween(Fill, { Size = UDim2.new(percent, 0, 1, 0) }, 0.15)
                if not skipCallback then
                    SafeCallback(Callback, CurrentValue)
                end
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Sliding = true
                    UpdateSlider(input)
                end
            end)

            WindowMaid:GiveTask(UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    Sliding = false
                end
            end))

            WindowMaid:GiveTask(UserInputService.InputChanged:Connect(function(input)
                if Sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateSlider(input)
                end
            end))

            Library.Signals[Flag] = SetValue

