                Size = UDim2.new(1, -12, 0, 120),
                Position = UDim2.new(0, 6, 0, 36),
                BackgroundTransparency = 1,
                ScrollBarThickness = 3,
                CanvasSize = UDim2.new(0, 0, 0, 0),
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                BorderSizePixel = 0,
                ZIndex = 51,
                Parent = listHolder
            })

            local listLayout = CreateInstance("UIListLayout", {
                Padding = UDim.new(0, 4),
                SortOrder = Enum.SortOrder.LayoutOrder,
                Parent = scroll
            })

            local DropdownObj = {}

            local function RefreshItems()
                for _, child in ipairs(scroll:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end

                local filter = string.lower(searchBox.Text)

                for _, opt in ipairs(options) do
                    if filter == "" or string.find(string.lower(opt), filter) then
                        local isItemSel = isMulti and table.find(selected, opt) ~= nil or selected == opt

                        local itemBtn = CreateInstance("TextButton", {
                            Size = UDim2.new(1, 0, 0, 26),
                            BackgroundColor3 = isItemSel and GetThemeColor("Accent") or GetThemeColor("Card"),
                            AutoButtonColor = false,
                            Text = "  " .. opt,
                            TextColor3 = isItemSel and Color3.fromRGB(255, 255, 255) or GetThemeColor("Text"),
                            TextSize = 12,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 52,
                            ThemeFont = true,
                            Parent = scroll
                        })
                        CreateInstance("UICorner", { CornerRadius = UDim.new(0, 4), Parent = itemBtn })

                        itemBtn.MouseButton1Click:Connect(function()
                            Library:PlaySound("Click")
                            if isMulti then
                                local idx = table.find(selected, opt)
                                if idx then
                                    table.remove(selected, idx)
                                else
                                    table.insert(selected, opt)
                                end
                                valLabel.Text = #selected > 0 and table.concat(selected, ", ") or "None"
                                if ddConfig.Callback then ddConfig.Callback(selected) end
                                RefreshItems()
                            else
                                selected = opt
                                valLabel.Text = selected
                                DropdownObj:Close()
                                if ddConfig.Callback then ddConfig.Callback(selected) end
                            end
                        end)
                    end
                end
            end

            searchBox:GetPropertyChangedSignal("Text"):Connect(RefreshItems)

            function DropdownObj:Open()
                if Library.ActiveDropdown and Library.ActiveDropdown ~= DropdownObj then
                    Library.ActiveDropdown:Close()
                end
                Library.ActiveDropdown = DropdownObj
                isOpen = true
                Library:PlaySound("DropdownOpen")
                listHolder.Visible = true
                RefreshItems()
                TweenService:Create(listHolder, TweenInfo.new(0.2), { Size = UDim2.new(1, 0, 0, 166) }):Play()
                TweenService:Create(arrow, TweenInfo.new(0.2), { Rotation = 180 }):Play()
            end

            function DropdownObj:Close()
                isOpen = false
                Library:PlaySound("DropdownClose")
                local tw = TweenService:Create(listHolder, TweenInfo.new(0.15), { Size = UDim2.new(1, 0, 0, 0) })
                tw:Play()
                TweenService:Create(arrow, TweenInfo.new(0.15), { Rotation = 0 }):Play()
                task.delay(0.15, function()
                    if not isOpen then listHolder.Visible = false end
                end)
                if Library.ActiveDropdown == DropdownObj then
                    Library.ActiveDropdown = nil
                end
            end

            selectBtn.MouseButton1Click:Connect(function()
                if isOpen then DropdownObj:Close() else DropdownObj:Open() end
            end)

            function DropdownObj:SetOptions(newOpts: { string })
                options = newOpts
                RefreshItems()
            end

            function DropdownObj:SetValue(val: any)
                selected = val
                valLabel.Text = isMulti and table.concat(selected, ", ") or tostring(selected)
                if ddConfig.Callback then ddConfig.Callback(selected) end
            end

            function DropdownObj:GetValue(): any
                return selected
            end

            return DropdownObj
        end

