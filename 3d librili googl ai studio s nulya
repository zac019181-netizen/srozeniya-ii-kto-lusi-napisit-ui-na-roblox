            Menu.BorderSizePixel = 0
            Menu.ClipsDescendants = true
            Menu.Visible = false
            Menu.ZIndex = 550
            Menu.Parent = Window.Overlay
            ThemeManager:Subscribe(Menu, "BackgroundColor3", "Tertiary")

            local MenuCorner = Instance.new("UICorner")
            MenuCorner.CornerRadius = UDim.new(0, 6)
            MenuCorner.Parent = Menu

            local MenuStroke = Instance.new("UIStroke")
            MenuStroke.Color = ThemeManager:GetColor("Border")
            MenuStroke.Thickness = 1
            MenuStroke.Parent = Menu
            ThemeManager:Subscribe(MenuStroke, "Color", "Border")

            local MenuScroll = Instance.new("ScrollingFrame")
            MenuScroll.Size = UDim2.new(1, 0, 1, 0)
            MenuScroll.BackgroundTransparency = 1
            MenuScroll.BorderSizePixel = 0
            MenuScroll.ScrollBarThickness = 2
            MenuScroll.ScrollBarImageColor3 = ThemeManager:GetColor("Accent")
            MenuScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
            MenuScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
            MenuScroll.ZIndex = 551
            MenuScroll.Parent = Menu
            ThemeManager:Subscribe(MenuScroll, "ScrollBarImageColor3", "Accent")

            local MenuLayout = Instance.new("UIListLayout")
            MenuLayout.Padding = UDim.new(0, 2)
            MenuLayout.SortOrder = Enum.SortOrder.LayoutOrder
            MenuLayout.Parent = MenuScroll

            local IsOpen = false

            local function RenderOptions()
                for _, child in ipairs(MenuScroll:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end

                for _, opt in ipairs(Options) do
                    local OptBtn = Instance.new("TextButton")
                    OptBtn.Size = UDim2.new(1, -6, 0, 26)
                    OptBtn.Position = UDim2.new(0, 3, 0, 0)
                    OptBtn.BackgroundColor3 = ThemeManager:GetColor("Secondary")
                    OptBtn.BackgroundTransparency = 1
                    OptBtn.Text = "  " .. tostring(opt)
                    OptBtn.TextColor3 = ThemeManager:GetColor("TextDark")
                    OptBtn.TextSize = 12
                    OptBtn.TextXAlignment = Enum.TextXAlignment.Left
                    OptBtn.ZIndex = 552
                    OptBtn.AutoButtonColor = false
                    OptBtn.Parent = MenuScroll
                    FontManager:Subscribe(OptBtn, false)
                    ThemeManager:Subscribe(OptBtn, "TextColor3", "TextDark")

                    local isChosen = Multi and Selected[opt] or (Selected == opt)
                    if isChosen then
                        OptBtn.TextColor3 = ThemeManager:GetColor("Accent")
                        OptBtn.BackgroundTransparency = 0.8
                    end

                    OptBtn.MouseButton1Click:Connect(function()
                        SoundManager:Play("Click")
                        if Multi then
                            Selected[opt] = not Selected[opt]
                            Library.Flags[Flag] = Selected
                            SelectedLabel.Text = FormatSelected()
                            RenderOptions()
                            SafeCallback(Callback, Selected)
                        else
                            Selected = opt
                            Library.Flags[Flag] = Selected
                            SelectedLabel.Text = FormatSelected()
                            RenderOptions()
                            SafeCallback(Callback, Selected)
                            -- Close Dropdown
                            IsOpen = false
                            AnimationManager:Tween(Menu, { Size = UDim2.new(0, DropFrame.AbsoluteSize.X, 0, 0) }, 0.15).Completed:Connect(function()
                                Menu.Visible = false
                            end)
                            AnimationManager:Tween(Arrow, { Rotation = 0 }, 0.15)
                        end
                    end)
                end
            end

            local function ToggleMenu()
                IsOpen = not IsOpen
                if IsOpen then
                    SoundManager:Play("Dropdown")
                    RenderOptions()

                    local absPos = DropFrame.AbsolutePosition
                    local winPos = Window.Root.AbsolutePosition
                    local relX = absPos.X - winPos.X
                    local relY = absPos.Y - winPos.Y + DropFrame.AbsoluteSize.Y + 4

                    local targetHeight = math.clamp(#Options * 28 + 6, 30, 140)
                    Menu.Position = UDim2.fromOffset(relX, relY)
                    Menu.Size = UDim2.new(0, DropFrame.AbsoluteSize.X, 0, 0)
                    Menu.Visible = true

                    AnimationManager:Tween(Menu, { Size = UDim2.new(0, DropFrame.AbsoluteSize.X, 0, targetHeight) }, 0.2)
                    AnimationManager:Tween(Arrow, { Rotation = 180 }, 0.2)
                else
                    AnimationManager:Tween(Menu, { Size = UDim2.new(0, DropFrame.AbsoluteSize.X, 0, 0) }, 0.15).Completed:Connect(function()
                        if not IsOpen then Menu.Visible = false end
                    end)
                    AnimationManager:Tween(Arrow, { Rotation = 0 }, 0.15)
                end
            end

            local DropBtn = Instance.new("TextButton")
            DropBtn.Size = UDim2.new(1, 0, 1, 0)
            DropBtn.BackgroundTransparency = 1
            DropBtn.Text = ""
            DropBtn.Parent = DropFrame
            DropBtn.MouseButton1Click:Connect(ToggleMenu)

            -- Close upon clicking outside
            WindowMaid:GiveTask(UserInputService.InputBegan:Connect(function(input)
                if IsOpen and input.UserInputType == Enum.UserInputType.MouseButton1 then
                    local mousePos = UserInputService:GetMouseLocation()
                    local menuPos = Menu.AbsolutePosition
                    local menuSize = Menu.AbsoluteSize
                    local framePos = DropFrame.AbsolutePosition
                    local frameSize = DropFrame.AbsoluteSize

                    local inMenu = (mousePos.X >= menuPos.X and mousePos.X <= menuPos.X + menuSize.X and mousePos.Y >= menuPos.Y and mousePos.Y <= menuPos.Y + menuSize.Y)
                    local inFrame = (mousePos.X >= framePos.X and mousePos.X <= framePos.X + frameSize.X and mousePos.Y >= framePos.Y and mousePos.Y <= framePos.Y + frameSize.Y)

                    if not inMenu and not inFrame then
                        ToggleMenu()
                    end
                end
            end))

            local function SetValue(val, skipCallback)
                if Multi and typeof(val) == "table" then
                    Selected = val
                else
                    Selected = val
                end
                Library.Flags[Flag] = Selected
                SelectedLabel.Text = FormatSelected()
                RenderOptions()
                if not skipCallback then
                    SafeCallback(Callback, Selected)
                end
            end

            Library.Signals[Flag] = SetValue

            return {
                SetValue = SetValue,
                GetValue = function() return Selected end,
                SetOptions = function(_, newOptions)
                    Options = newOptions or {}
                    RenderOptions()
                end,
                Destroy = function()
                    Menu:Destroy()
                    DropFrame:Destroy()
                end
            }
        end

