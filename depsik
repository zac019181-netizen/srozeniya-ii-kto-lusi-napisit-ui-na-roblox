local function CreateScreenGui()
    if ScreenGui then return ScreenGui end
    ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "BlackboxUI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = CoreGui -- или PlayerGui? обычно CoreGui для перекрытия
    -- Проверка на наличие CoreGui, если нет - используем PlayerGui
    if not CoreGui:FindFirstChild("BlackboxUI") then
        ScreenGui.Parent = CoreGui
    else
        ScreenGui.Parent = PlayerGui
    end
    -- UIScale для всего интерфейса
    UIScaleObj = Instance.new("UIScale")
    UIScaleObj.Parent = ScreenGui
    UIScaleObj.Scale = CurrentScale
    return ScreenGui
end

local function GetScreenGui()
    return ScreenGui or CreateScreenGui()
end

local function IsValidObject(obj)
    return obj and obj.Parent and obj:IsA("BasePart") or obj:IsA("GuiObject")
end

local function SafeCallback(cb, ...)
    if not cb then return end
    local success, err = pcall(cb, ...)
    if not success then
        warn("[Blackbox UI] Callback error:", err)
    end
end

local function DeepCopy(t)
    local copy = {}
    for k, v in pairs(t) do
        if type(v) == "table" then
            copy[k] = DeepCopy(v)
        else
            copy[k] = v
        end
    end
    return copy
end

local function TableFind(t, value)
    for i, v in ipairs(t) do
        if v == value then return i end
    end
    return nil
end

