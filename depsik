local SoundMap = {}
local SoundInstances = {}

function SoundManager:SetSound(name, assetId)
    SoundMap[name] = assetId
end

function SoundManager:PlaySound(name, volume)
    if not SoundEnabled then return end
    local assetId = SoundMap[name]
    if not assetId then return end
    local sound = Instance.new("Sound")
    sound.SoundId = assetId
    sound.Volume = (volume or SoundVolume) * SoundVolume
    sound.Parent = GetScreenGui()
    sound:Play()
    -- автоудаление после завершения
    game:GetService("Debris"):AddItem(sound, sound.TimeLength + 0.1)
    SoundInstances[#SoundInstances + 1] = sound
end

function SoundManager:SetEnabled(enabled)
    SoundEnabled = enabled
end

function SoundManager:SetVolume(vol)
    SoundVolume = math.clamp(vol, 0, 1)
end

