local Components = {}

-- Базовый класс компонента
local Component = {}
Component.__index = Component

function Component:new(name, parent, opts)
    local obj = setmetatable({}, self)
    obj.Name = name
    obj.Parent = parent
    obj.Opts = opts or {}
    obj.Connections = {}
    obj.Children = {}
    obj.Destroyed = false
    obj.GuiObjects = {}
    obj.DataKey = opts.DataKey or name
    return obj
end

function Component:AddConnection(conn)
    table.insert(self.Connections, conn)
end

function Component:AddChild(child)
    table.insert(self.Children, child)
end

function Component:Destroy()
    if self.Destroyed then return end
    self.Destroyed = true
    for _, conn in ipairs(self.Connections) do
        conn:Disconnect()
    end
    self.Connections = {}
    for _, child in ipairs(self.Children) do
        if child.Destroy then child:Destroy() end
    end
    self.Children = {}
    for _, obj in ipairs(self.GuiObjects) do
        if obj and obj.Parent then obj:Destroy() end
    end
    self.GuiObjects = {}
    -- Удалить из LiveObjects
    for i, obj in ipairs(LiveObjects) do
        if obj == self then
            table.remove(LiveObjects, i)
            break
        end
    end
end

function Component:OnThemeChanged(theme)
    -- переопределяется в наследниках
end

function Component:GetConfigData()
    return self.DataKey, self:GetValue()
end

function Component:ApplyConfigData(data)
    if data[self.DataKey] ~= nil then
        self:SetValue(data[self.DataKey])
    end
end

