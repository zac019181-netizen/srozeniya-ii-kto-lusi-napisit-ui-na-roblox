function Components:CreateKeybind(parent, opts)
    local keybind = Component:new("Keybind", parent, opts)
    local name = opts.Name or "Keybind"
    local defaultKey = opts.Default or Enum.KeyCode.None
    local callback = opts.Callback or function() end
    local currentKey = defaultKey

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 40)
    frame.BackgroundColor3 = ThemeManager:GetCurrentTheme().Secondary
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, -120, 0, 20)
    nameLabel.Position = UDim2.new(0, 10, 0, 10)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = name
    nameLabel.TextColor3 = ThemeManager:GetCurrentTheme().Text
    nameLabel.TextSize = 15
    nameLabel.Font = CurrentFont
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = frame

    local keyLabel = Instance.new("TextButton")
    keyLabel.Size = UDim2.new(0, 100, 0, 28)
    keyLabel.Position = UDim2.new(1, -110, 0.5, -14)
    keyLabel.BackgroundColor3 = ThemeManager:GetCurrentTheme().Background
    keyLabel.BackgroundTransparency = 0.3
    keyLabel.BorderSizePixel = 0
    keyLabel.Text = tostring(currentKey):gsub("Enum.KeyCode.", "")
    keyLabel.TextColor3 = ThemeManager:GetCurrentTheme().Text
    keyLabel.TextSize = 13
    keyLabel.Font = CurrentFont
    local keyCorner = Instance.new("UICorner")
    keyCorner.CornerRadius = UDim.new(0, 4)
    keyCorner.Parent = keyLabel
    keyLabel.Parent = frame

    keybind.GuiObjects = {frame, nameLabel, keyLabel}

    local listening = false
    local function startListening()
        listening = true
        keyLabel.Text = "..."
        SoundManager:PlaySound("Click", 0.2)
    end

    local function stopListening()
        listening = false
        keyLabel.Text = tostring(currentKey):gsub("Enum.KeyCode.", "")
    end

    keyLabel.MouseButton1Click:Connect(function()
        if listening then
            stopListening()
        else
            startListening()
        end
    end)
    keybind:AddConnection(keyLabel.MouseButton1Click)

    local function onKeyPress(input, gameProcessed)
        if gameProcessed then return end
        if not listening then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local key = input.KeyCode
            if key ~= Enum.KeyCode.Unknown then
                currentKey = key
                stopListening()
                SafeCallback(callback, key)
            end
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 then
            currentKey = input.UserInputType
            stopListening()
            SafeCallback(callback, currentKey)
        end
    end

    UserInputService.InputBegan:Connect(onKeyPress)
    keybind:AddConnection(UserInputService.InputBegan)

    keybind.OnThemeChanged = function(theme)
        frame.BackgroundColor3 = theme.Secondary
        nameLabel.TextColor3 = theme.Text
        keyLabel.BackgroundColor3 = theme.Background
        keyLabel.TextColor3 = theme.Text
    end

    keybind.SetKey = function(key)
        currentKey = key
        keyLabel.Text = tostring(key):gsub("Enum.KeyCode.", ""):gsub("Enum.UserInputType.", "")
    end

    keybind.GetKey = function()
        return currentKey
    end

    frame.Parent = parent
    table.insert(LiveObjects, keybind)
    return keybind
end

