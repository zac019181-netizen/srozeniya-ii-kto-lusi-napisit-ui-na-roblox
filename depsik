function NotificationManager:Notify(opts)
    local title = opts.Title or ""
    local description = opts.Description or ""
    local duration = opts.Duration or 4
    local type_ = opts.Type or "Info"
    local icon = opts.Icon or nil

    local container = NotificationsContainer
    if not container then
        NotificationManager:CreateContainer()
        container = NotificationsContainer
    end

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 70)
    frame.BackgroundColor3 = ThemeManager:GetCurrentTheme().Secondary
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    frame.ClipsDescendants = true
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    -- Тень
    local shadow = Instance.new("Frame")
    shadow.Size = UDim2.new(1, 0, 1, 0)
    shadow.Position = UDim2.new(0, 2, 0, 2)
    shadow.BackgroundColor3 = Color3.new(0,0,0)
    shadow.BackgroundTransparency = 0.6
    shadow.BorderSizePixel = 0
    shadow.Parent = frame
    local shadowCorner = Instance.new("UICorner")
    shadowCorner.CornerRadius = UDim.new(0, 8)
    shadowCorner.Parent = shadow

    -- Иконка
    local iconLabel = nil
    if icon then
        iconLabel = Instance.new("ImageLabel")
        iconLabel.Size = UDim2.new(0, 24, 0, 24)
        iconLabel.Position = UDim2.new(0, 10, 0.5, -12)
        iconLabel.BackgroundTransparency = 1
        iconLabel.Image = icon
        iconLabel.Parent = frame
    else
        -- Стандартная иконка по типу
        local emoji = "ℹ️"
        if type_ == "Success" then emoji = "✅"
        elseif type_ == "Warning" then emoji = "⚠️"
        elseif type_ == "Error" then emoji = "❌"
        end
        iconLabel = Instance.new("TextLabel")
        iconLabel.Size = UDim2.new(0, 24, 0, 24)
        iconLabel.Position = UDim2.new(0, 10, 0.5, -12)
        iconLabel.BackgroundTransparency = 1
        iconLabel.Text = emoji
        iconLabel.TextSize = 20
        iconLabel.TextColor3 = Color3.new(1,1,1)
        iconLabel.Font = Enum.Font.Gotham
        iconLabel.Parent = frame
    end

    -- Заголовок
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -50, 0, 22)
    titleLabel.Position = UDim2.new(0, 44, 0, 10)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.TextColor3 = ThemeManager:GetCurrentTheme().Text
    titleLabel.TextSize = 16
    titleLabel.Font = CurrentFont
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.TextYAlignment = Enum.TextYAlignment.Top
    titleLabel.Parent = frame

    -- Описание
    local descLabel = Instance.new("TextLabel")
    descLabel.Size = UDim2.new(1, -50, 0, 30)
    descLabel.Position = UDim2.new(0, 44, 0, 34)
    descLabel.BackgroundTransparency = 1
    descLabel.Text = description
    descLabel.TextColor3 = ThemeManager:GetCurrentTheme().TextDark
    descLabel.TextSize = 13
    descLabel.Font = CurrentFont
    descLabel.TextXAlignment = Enum.TextXAlignment.Left
    descLabel.TextYAlignment = Enum.TextYAlignment.Top
    descLabel.TextWrapped = true
    descLabel.Parent = frame

    -- Progress bar
    local progress = Instance.new("Frame")
    progress.Size = UDim2.new(1, 0, 0, 3)
    progress.Position = UDim2.new(0, 0, 1, -3)
    progress.BackgroundColor3 = ThemeManager:GetCurrentTheme().Accent
    progress.BorderSizePixel = 0
    progress.Parent = frame
    local progressCorner = Instance.new("UICorner")
    progressCorner.CornerRadius = UDim.new(0, 3)
    progressCorner.Parent = progress

    -- Закрыть
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 24, 0, 24)
    closeBtn.Position = UDim2.new(1, -30, 0, 8)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Text = "✕"
    closeBtn.TextColor3 = ThemeManager:GetCurrentTheme().TextDark
    closeBtn.TextSize = 14
    closeBtn.Font = CurrentFont
    closeBtn.Parent = frame
    closeBtn.MouseButton1Click:Connect(function()
        NotificationManager:DestroyNotification(frame)
    end)

    frame.Parent = container

    -- Анимация появления
    frame.Position = UDim2.new(0, 50, 0, 0)
    frame.Size = UDim2.new(1, 0, 0, 0)
    frame.BackgroundTransparency = 1
    AnimationManager:Tween(frame, {
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(1, 0, 0, 70),
        BackgroundTransparency = 0.1
    }, 0.3)

    -- Прогресс
    local startTime = tick()
    local endTime = startTime + duration
    local progressConnection = nil
    progressConnection = RunService.Heartbeat:Connect(function()
        local now = tick()
        local elapsed = now - startTime
        local remaining = math.max(0, 1 - elapsed / duration)
        progress.Size = UDim2.new(remaining, 0, 0, 3)
        if remaining <= 0 then
            progressConnection:Disconnect()
            NotificationManager:DestroyNotification(frame)
        end
    end)

    -- Звук
    SoundManager:PlaySound("Notification", 0.3)

    -- Храним данные
    frame._progressConnection = progressConnection
    frame._destroy = function()
        if progressConnection then progressConnection:Disconnect() end
        frame:Destroy()
    end

    return frame
end

function NotificationManager:DestroyNotification(frame)
    if not frame or not frame.Parent then return end
    AnimationManager:Tween(frame, {
        Position = UDim2.new(0, 50, 0, 0),
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1
    }, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    task.wait(0.2)
    if frame._destroy then frame:_destroy() else frame:Destroy() end
end

