    dropdown.GuiObjects = {frame, nameLabel, descLabel, selectedLabel, arrow, dropFrame, scrollContainer, listLayout, searchBox}

    local optionButtons = {}
    local function buildOptions(filter)
        for _, btn in ipairs(optionButtons) do
            btn:Destroy()
        end
        optionButtons = {}
        local filtered = options
        if filter and filter ~= "" then
            filtered = {}
            for _, opt in ipairs(options) do
                if string.lower(opt):find(string.lower(filter)) then
                    table.insert(filtered, opt)
                end
            end
        end
        local y = 30 -- searchBox высота + отступ
        for _, opt in ipairs(filtered) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -10, 0, 24)
            btn.Position = UDim2.new(0, 5, 0, y)
            btn.BackgroundColor3 = ThemeManager:GetCurrentTheme().Secondary
            btn.BackgroundTransparency = 0.3
            btn.BorderSizePixel = 0
            btn.Text = opt
            btn.TextColor3 = ThemeManager:GetCurrentTheme().Text
            btn.TextSize = 13
            btn.Font = CurrentFont
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.TextYAlignment = Enum.TextYAlignment.Center
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 4)
            btnCorner.Parent = btn
            btn.Parent = scrollContainer
            btn.MouseEnter:Connect(function()
                SoundManager:PlaySound("Hover", 0.2)
                btn.BackgroundTransparency = 0.1
            end)
            btn.MouseLeave:Connect(function()
                btn.BackgroundTransparency = 0.3
            end)
            btn.MouseButton1Click:Connect(function()
                SoundManager:PlaySound("Click", 0.3)
                if multi then
                    if type(currentValue) ~= "table" then currentValue = {} end
                    local idx = TableFind(currentValue, opt)
                    if idx then
                        table.remove(currentValue, idx)
                    else
                        table.insert(currentValue, opt)
                    end
                    selectedLabel.Text = table.concat(currentValue, ", ")
                else
                    currentValue = opt
                    selectedLabel.Text = opt
                    closeDropdown()
                end
                SafeCallback(callback, currentValue)
            end)
            table.insert(optionButtons, btn)
            y = y + 26
        end
        scrollContainer.CanvasSize = UDim2.new(0, 0, 0, y + 5)
    end

    local function openDropdown()
        if isOpen then return end
        isOpen = true
        dropFrame.Size = UDim2.new(1, 0, 0, 120)
        dropFrame.BackgroundTransparency = 0.1
        AnimationManager:Tween(dropFrame, {Size = UDim2.new(1, 0, 0, 120)}, 0.2)
        buildOptions(nil)
        SoundManager:PlaySound("Dropdown", 0.2)
    end

    local function closeDropdown()
        if not isOpen then return end
        isOpen = false
        AnimationManager:Tween(dropFrame, {Size = UDim2.new(1, 0, 0, 0)}, 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.wait(0.15)
        dropFrame.Size = UDim2.new(1, 0, 0, 0)
    end

    local function toggleDropdown()
        if isOpen then closeDropdown() else openDropdown() end
    end

    local mainButton = Instance.new("TextButton")
    mainButton.Size = UDim2.new(1, 0, 1, 0)
    mainButton.BackgroundTransparency = 1
    mainButton.Text = ""
    mainButton.Parent = frame
    mainButton.MouseButton1Click:Connect(toggleDropdown)
    dropdown:AddConnection(mainButton.MouseButton1Click)

    -- Закрытие при клике вне
    local function onGlobalClick(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if isOpen then
                local mousePos = input.Position
                local framePos = frame.AbsolutePosition
                local frameSize = frame.AbsoluteSize
                if not (mousePos.X >= framePos.X and mousePos.X <= framePos.X + frameSize.X and
                        mousePos.Y >= framePos.Y and mousePos.Y <= framePos.Y + frameSize.Y) then
                    closeDropdown()
                end
            end
        end
    end
    UserInputService.InputBegan:Connect(onGlobalClick)
    dropdown:AddConnection(UserInputService.InputBegan)

    -- Поиск
    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        buildOptions(searchBox.Text)
    end)
    dropdown:AddConnection(searchBox:GetPropertyChangedSignal("Text"))

    dropdown.OnThemeChanged = function(theme)
        frame.BackgroundColor3 = theme.Secondary
        nameLabel.TextColor3 = theme.Text
        descLabel.TextColor3 = theme.TextDark
        selectedLabel.TextColor3 = theme.Text
        arrow.TextColor3 = theme.TextDark
        dropFrame.BackgroundColor3 = theme.Background
        scrollContainer.ScrollBarImageColor3 = theme.TextDark
        searchBox.BackgroundColor3 = theme.Secondary
        searchBox.PlaceholderColor3 = theme.TextDark
        searchBox.TextColor3 = theme.Text
        for _, btn in ipairs(optionButtons) do
            if btn and btn.Parent then
                btn.BackgroundColor3 = theme.Secondary
                btn.TextColor3 = theme.Text
            end
        end
    end

    dropdown.SetOptions = function(newOptions)
        options = newOptions
        buildOptions(nil)
        if multi then
            currentValue = {}
            selectedLabel.Text = ""
        else
            currentValue = options[1] or ""
            selectedLabel.Text = currentValue
        end
    end

    dropdown.SetValue = function(value)
        if multi then
            currentValue = value or {}
            selectedLabel.Text = table.concat(currentValue, ", ")
        else
            currentValue = value
            selectedLabel.Text = value
        end
        SafeCallback(callback, currentValue)
    end

    dropdown.GetValue = function()
        return currentValue
    end

    dropdown.Refresh = function()
        buildOptions(nil)
    end

    dropdown.Destroy = function()
        closeDropdown()
        Component.Destroy(dropdown)
    end

    -- Начальное значение
    if multi then
        if type(default) == "table" then
            currentValue = default
        else
            currentValue = {}
        end
        selectedLabel.Text = table.concat(currentValue, ", ")
    else
        currentValue = default
        selectedLabel.Text = default
    end
    buildOptions(nil)

    frame.Parent = parent
    table.insert(LiveObjects, dropdown)
    return dropdown
end

