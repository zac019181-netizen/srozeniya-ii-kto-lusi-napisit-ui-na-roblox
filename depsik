-- ============================================================================
-- AnimationManager
-- ============================================================================

function AnimationManager:Tween(obj, properties, duration, easingStyle, easingDirection)
    if not AnimationsEnabled then
        for prop, val in pairs(properties) do
            obj[prop] = val
        end
        return nil
    end
    duration = duration or AnimationSpeed
    easingStyle = easingStyle or Enum.EasingStyle.Quad
    easingDirection = easingDirection or Enum.EasingDirection.Out
    local tween = TweenService:Create(obj, TweenInfo.new(duration, easingStyle, easingDirection), properties)
    tween:Play()
    return tween
end

function AnimationManager:SetEnabled(enabled)
    AnimationsEnabled = enabled
end

function AnimationManager:SetSpeed(speed)
    AnimationSpeed = math.max(0.05, speed)
end

-- ============================================================================
-- ConfigManager
-- ============================================================================

local ConfigData = {} -- имя конфига -> таблица значений
local AutoSaveTimer = nil

function ConfigManager:SaveConfig(name)
    local data = {}
    -- Собираем данные со всех живых объектов, которые имеют метод GetConfigData
    for _, obj in ipairs(LiveObjects) do
        if obj and obj.GetConfigData then
            local key, value = obj:GetConfigData()
            if key then
                data[key] = value
            end
        end
    end
    ConfigData[name] = data
    -- Сохраняем в файл, если доступно
    if isfile and writefile then
        local json = HttpService:JSONEncode(data)
        writefile("BlackboxUI_" .. name .. ".json", json)
    end
end

function ConfigManager:LoadConfig(name)
    local data = nil
    if isfile and readfile then
        local filename = "BlackboxUI_" .. name .. ".json"
        if isfile(filename) then
            local content = readfile(filename)
            data = HttpService:JSONDecode(content)
        end
    end
    if not data then
        data = ConfigData[name]
    end
    if not data then return false end
    -- Применяем данные к объектам
    for _, obj in ipairs(LiveObjects) do
        if obj and obj.ApplyConfigData then
            obj:ApplyConfigData(data)
        end
    end
    return true
end

function ConfigManager:DeleteConfig(name)
    ConfigData[name] = nil
    if isfile then
        local filename = "BlackboxUI_" .. name .. ".json"
        if isfile(filename) then
            delfile(filename)
        end
    end
end

function ConfigManager:GetConfigs()
    local names = {}
    for name, _ in pairs(ConfigData) do
        names[#names + 1] = name
    end
    -- также ищем файлы
    if listfiles then
        for _, file in ipairs(listfiles()) do
            if file:match("BlackboxUI_(.*)%.json") then
                local name = file:match("BlackboxUI_(.*)%.json")
                if not TableFind(names, name) then
                    names[#names + 1] = name
                end
            end
        end
    end
    return names
end

function ConfigManager:SetAutoSave(enabled)
    AutoSave = enabled
    if AutoSave then
        if AutoSaveTimer then
            AutoSaveTimer:Disconnect()
            AutoSaveTimer = nil
        end
        AutoSaveTimer = RunService.Heartbeat:Connect(function()
            -- автосохранение раз в 5 секунд
            if not ConfigLoaded then return end
            -- для простоты сохраняем активный конфиг (можно доработать)
            if Library.ActiveConfig then
                ConfigManager:SaveConfig(Library.ActiveConfig)
            end
        end)
    else
        if AutoSaveTimer then
            AutoSaveTimer:Disconnect()
            AutoSaveTimer = nil
        end
    end
end

