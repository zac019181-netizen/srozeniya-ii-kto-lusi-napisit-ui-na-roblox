        Name = "Auto Save Config",
        Default = AutoSave,
        Callback = function(val)
            ConfigManager:SetAutoSave(val)
        end
    })
    local closeOnKeyToggle = settingsTab:AddToggle({
        Name = "Close on Toggle Key",
        Default = true,
        Callback = function(val)
            -- уже реализовано через Toggle
        end
    })
    local notificationsToggle = settingsTab:AddToggle({
        Name = "Notifications",
        Default = true,
        Callback = function(val)
            -- просто для примера
        end
    })
    -- Configs
    settingsTab:AddSection("Configs")
    local configList = settingsTab:AddDropdown({
        Name = "Load Config",
        Options = ConfigManager:GetConfigs(),
        Default = "",
        Callback = function(val)
            if val and val ~= "" then
                ConfigManager:LoadConfig(val)
                Library.ActiveConfig = val
            end
        end
    })
    settingsTab:AddButton({
        Name = "Save Current Config",
        Callback = function()
            local name = "Config_" .. os.time()
            ConfigManager:SaveConfig(name)
            configList:SetOptions(ConfigManager:GetConfigs())
            configList:SetValue(name)
            Library:Notify({Title = "Saved", Description = "Config saved as " .. name, Type = "Success"})
        end
    })
    settingsTab:AddButton({
        Name = "Delete Selected Config",
        Callback = function()
            local val = configList:GetValue()
            if val and val ~= "" then
                ConfigManager:DeleteConfig(val)
                configList:SetOptions(ConfigManager:GetConfigs())
                configList:SetValue("")
                Library:Notify({Title = "Deleted", Description = "Config deleted", Type = "Warning"})
            end
        end
    })

    return win
end

function Library:Notify(opts)
    NotificationManager:Notify(opts)
end

function Library:SetTheme(themeName)
    CurrentTheme = themeName
    ThemeManager:NotifyThemeChanged()
    -- дополнительно обновить окна
    for _, obj in ipairs(LiveObjects) do
        if obj.OnThemeChanged then
            obj:OnThemeChanged(ThemeManager:GetCurrentTheme())
        end
    end
end

function Library:SetFont(font)
    CurrentFont = font
    -- применить ко всем TextLabel/TextButton/TextBox
    local function applyFont(node)
        if node:IsA("TextLabel") or node:IsA("TextButton") or node:IsA("TextBox") then
            node.Font = font
        end
        for _, child in ipairs(node:GetChildren()) do
            applyFont(child)
        end
    end
    local gui = GetScreenGui()
    applyFont(gui)
end

function Library:SetScale(scale)
    CurrentScale = math.clamp(scale, 0.3, 2)
    if UIScaleObj then
        UIScaleObj.Scale = CurrentScale
    end
end

function Library:SetSoundEnabled(enabled)
    SoundManager:SetEnabled(enabled)
end

function Library:SetSoundVolume(vol)
    SoundManager:SetVolume(vol)
end

function Library:SetSound(name, assetId)
    SoundManager:SetSound(name, assetId)
end

function Library:SetAnimations(enabled)
    AnimationManager:SetEnabled(enabled)
end

function Library:RegisterTheme(name, colors)
    ThemeManager:RegisterTheme(name, colors)
end

function Library:SaveConfig(name)
    ConfigManager:SaveConfig(name)
end

function Library:LoadConfig(name)
    ConfigManager:LoadConfig(name)
end

function Library:DeleteConfig(name)
    ConfigManager:DeleteConfig(name)
end

function Library:GetConfigs()
    return ConfigManager:GetConfigs()
end

function Library:SetAutoSave(enabled)
    ConfigManager:SetAutoSave(enabled)
end

function Library:ToggleUI()
    -- Просто toggle всех окон
    for _, obj in ipairs(LiveObjects) do
        if obj.Toggle then
            obj:Toggle()
        end
    end
end

function Library:Destroy()
    for _, obj in ipairs(LiveObjects) do
        if obj.Destroy then
            obj:Destroy()
        end
    end
    LiveObjects = {}
    if ScreenGui then
        ScreenGui:Destroy()
        ScreenGui = nil
    end
    UIScaleObj = nil
    NotificationsContainer = nil
end

-- Инициализация
CreateScreenGui()
NotificationManager:CreateContainer()

-- ============================================================================
-- Экспорт
-- ============================================================================

return Library
