local Themes = {}

function ThemeManager:RegisterTheme(name, colors)
    Themes[name] = colors
end

function ThemeManager:GetTheme(name)
    return Themes[name] or Themes["Dark"]
end

function ThemeManager:GetCurrentTheme()
    return Themes[CurrentTheme] or Themes["Dark"]
end

function ThemeManager:ApplyThemeToObject(obj, theme)
    if not obj or not theme then return end
    -- рекурсивно обойти все GuiObject и применить стиль по типу
    local function apply(node)
        if node:IsA("GuiObject") then
            -- Определяем тип элемента по имени или атрибутам
            local className = node.ClassName
            local name = node.Name
            if name:find("Background") or name:find("Frame") or name:find("Container") then
                if node:IsA("Frame") or node:IsA("ImageLabel") then
                    -- пропускаем, если есть специальная обработка
                end
            end
            -- Для кнопок, переключателей и т.д. применяем конкретные цвета через их собственные методы
            -- Здесь мы просто передаем сигнал, чтобы компоненты сами обновились
        end
        for _, child in ipairs(node:GetChildren()) do
            apply(child)
        end
    end
    apply(obj)
end

function ThemeManager:NotifyThemeChanged()
    for _, obj in ipairs(LiveObjects) do
        if obj and obj.OnThemeChanged then
            obj:OnThemeChanged(Themes[CurrentTheme])
        end
    end
end

