function Components:CreateSlider(parent, opts)
    local slider = Component:new("Slider", parent, opts)
    local name = opts.Name or "Slider"
    local min = opts.Min or 0
    local max = opts.Max or 100
    local default = opts.Default or (min + max) / 2
    local rounding = opts.Rounding or 0
    local suffix = opts.Suffix or ""
    local callback = opts.Callback or function() end
    local currentValue = default

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 0, 60)
    frame.BackgroundColor3 = ThemeManager:GetCurrentTheme().Secondary
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(0.6, -10, 0, 20)
    nameLabel.Position = UDim2.new(0, 10, 0, 4)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = name
    nameLabel.TextColor3 = ThemeManager:GetCurrentTheme().Text
    nameLabel.TextSize = 15
    nameLabel.Font = CurrentFont
    nameLabel.TextXAlignment = Enum.TextXAlignment.Left
    nameLabel.Parent = frame

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size = UDim2.new(0.3, -10, 0, 20)
    valueLabel.Position = UDim2.new(0.7, 0, 0, 4)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text = tostring(default) .. suffix
    valueLabel.TextColor3 = ThemeManager:GetCurrentTheme().TextDark
    valueLabel.TextSize = 15
    valueLabel.Font = CurrentFont
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.Parent = frame

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -20, 0, 4)
    track.Position = UDim2.new(0, 10, 0, 40)
    track.BackgroundColor3 = ThemeManager:GetCurrentTheme().TextDark
    track.BackgroundTransparency = 0.5
    track.BorderSizePixel = 0
    local trackCorner = Instance.new("UICorner")
    trackCorner.CornerRadius = UDim.new(1, 0)
    trackCorner.Parent = track

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0.5, 0, 1, 0)
    fill.BackgroundColor3 = ThemeManager:GetCurrentTheme().Accent
    fill.BorderSizePixel = 0
    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(1, 0)
    fillCorner.Parent = fill
    fill.Parent = track

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new(0.5, -7, 0.5, -7)
    knob.BackgroundColor3 = ThemeManager:GetCurrentTheme().Accent
    knob.BorderSizePixel = 0
    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = knob
    knob.Parent = track

    slider.GuiObjects = {frame, nameLabel, valueLabel, track, fill, knob}

    local function updateSlider(value)
        value = math.clamp(value, min, max)
        if rounding > 0 then
            value = math.round(value / rounding) * rounding
        end
        currentValue = value
        local percent = (value - min) / (max - min)
        fill.Size = UDim2.new(percent, 0, 1, 0)
        knob.Position = UDim2.new(percent, -7, 0.5, -7)
        valueLabel.Text = tostring(value) .. suffix
        SafeCallback(callback, value)
    end

    local dragging = false
    local function startDrag()
        dragging = true
        SoundManager:PlaySound("Click", 0.2)
    end
    local function endDrag()
        dragging = false
    end
    local function updateFromMouse(mousePos)
        if not dragging then return end
        local trackPos = track.AbsolutePosition
        local trackSize = track.AbsoluteSize.X
        local relativeX = math.clamp((mousePos.X - trackPos.X) / trackSize, 0, 1)
        local value = min + relativeX * (max - min)
        updateSlider(value)
    end

    local function onInputBegan(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if input.Position.X >= track.AbsolutePosition.X and input.Position.X <= track.AbsolutePosition.X + track.AbsoluteSize.X then
                startDrag()
                updateFromMouse(input.Position)
            end
        end
    end

    local function onInputChanged(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
            updateFromMouse(input.Position)
        end
    end

    local function onInputEnded(input, gameProcessed)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            endDrag()
        end
    end

    UserInputService.InputBegan:Connect(onInputBegan)
    UserInputService.InputChanged:Connect(onInputChanged)
    UserInputService.InputEnded:Connect(onInputEnded)
    slider:AddConnection(UserInputService.InputBegan)
    slider:AddConnection(UserInputService.InputChanged)
    slider:AddConnection(UserInputService.InputEnded)

    slider.OnThemeChanged = function(theme)
        frame.BackgroundColor3 = theme.Secondary
        nameLabel.TextColor3 = theme.Text
        valueLabel.TextColor3 = theme.TextDark
        track.BackgroundColor3 = theme.TextDark
        fill.BackgroundColor3 = theme.Accent
        knob.BackgroundColor3 = theme.Accent
    end

    slider.SetValue = function(value)
        updateSlider(value)
    end

    slider.GetValue = function()
        return currentValue
    end

    updateSlider(default)

    frame.Parent = parent
    table.insert(LiveObjects, slider)
    return slider
end

