        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(17, 17),
        BackgroundTransparency = 0,
    }, switch)

    StyleFrame(component, knob, "Text", 0)

    component.Value = value
    component.Frame = holder
    component.Switch = switch
    component.Knob = knob
    component.Title = title
    component.Configurable = options.Configurable ~= false

    local switchUnbind = component:BindTheme(
        switch,
        "BackgroundColor3",
        value and "Accent" or "Border"
    )

    local knobUnbind = component:BindTheme(
        knob,
        "BackgroundColor3",
        "Text"
    )

    component._refreshVisual = function()
        if component.Destroyed then
            return
        end

        local accent = ThemeManager:GetColor("Accent")
        local border = ThemeManager:GetColor("Border")

        if Library.AnimationsEnabled then
            AnimationManager:Tween(switch, {
                BackgroundColor3 = component.Value and accent or border,
            })

            AnimationManager:Tween(knob, {
                Position = component.Value
                    and UDim2.new(1, -20, 0.5, 0)
                    or UDim2.new(0, 3, 0.5, 0),
            })
        else
            switch.BackgroundColor3 = component.Value and accent or border
            knob.Position = component.Value
                and UDim2.new(1, -20, 0.5, 0)
                or UDim2.new(0, 3, 0.5, 0)
        end
    end

    function component:SetValue(newValue, fireCallback)
        if self.Destroyed then
            return
        end

        self.Value = newValue == true

        self._refreshVisual()

        if fireCallback ~= false then
            self:SafeCallback(options.Callback, self.Value)
        end

        ConfigManager:QueueAutoSave()
    end

    function component:GetValue()
        return self.Value
    end

    holder.Activated:Connect(function()
        if component.Destroyed then
            return
        end

        SoundManager:Play("Click", 0.4)
        component:SetValue(not component.Value)
    end)

    table.insert(self.Components, component)

    component:_refreshVisual()

    return component
end

