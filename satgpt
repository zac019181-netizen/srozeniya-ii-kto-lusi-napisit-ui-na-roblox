function Tab:_registerComponent(component, options)
    table.insert(self.Components, component)

    if options and options.Configurable ~= false and options.Name then
        local baseKey = options.Flag or options.Name

        baseKey = tostring(baseKey)
            :gsub("%s+", "_")
            :gsub("[^%w_]", "")

        if baseKey == "" then
            baseKey = "Control_" .. tostring(#self.Components)
        end

        local original = baseKey
        local index = 2

        while ConfigManager.Controls[baseKey] do
            baseKey = original .. "_" .. index
            index += 1
        end

        component.ConfigKey = self.Name .. "." .. baseKey

        ConfigManager:Register(component)

        component:AddCleanup(function()
            ConfigManager:Unregister(component)
        end)
    end

    return component
end

