    if options.Description then
        description = MakeLabel(component, holder, {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(14, 33),
            Size = UDim2.new(1, -28, 20, 0),
            Text = options.Description,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
        }, "TextDark")
    end

    local hoverOverlay = Utility.Create("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 20,
        ClipsDescendants = true,
    }, holder)

    Utility.Create("UICorner", {
        CornerRadius = UDim.new(0, 10),
    }, hoverOverlay)

    component.Frame = holder
    component.Button = holder
    component.Enabled = true

    function component:SetEnabled(enabled)
        self.Enabled = enabled == true

        holder.Active = self.Enabled
        holder.AutoButtonColor = false

        if self.Enabled then
            component:BindTheme(holder, "BackgroundColor3", "Element")
            title.TextTransparency = 0
        else
            title.TextTransparency = 0.55
        end
    end

    function component:GetEnabled()
        return self.Enabled
    end

    holder.MouseEnter:Connect(function()
        if component.Destroyed or not component.Enabled then
            return
        end

        if Library.AnimationsEnabled then
            AnimationManager:Tween(holder, {
                Size = UDim2.new(1, 2, 0, options.Description and 63 or 47),
            })

            local color = ThemeManager:GetColor("ElementHover")

            AnimationManager:Tween(holder, {
                BackgroundColor3 = color,
            })
        else
            holder.BackgroundColor3 = ThemeManager:GetColor("ElementHover")
        end

        SoundManager:Play("Hover", 0.3)
    end)

    holder.MouseLeave:Connect(function()
        if component.Destroyed or not component.Enabled then
            return
        end

        if Library.AnimationsEnabled then
            AnimationManager:Tween(holder, {
                Size = UDim2.new(1, 0, 0, options.Description and 62 or 46),
                BackgroundColor3 = ThemeManager:GetColor("Element"),
            })
        else
            holder.Size = UDim2.new(1, 0, 0, options.Description and 62 or 46)
            holder.BackgroundColor3 = ThemeManager:GetColor("Element")
        end
    end)

    holder.InputBegan:Connect(function(input)
        if component.Destroyed or not component.Enabled then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then

            return
        end

        SoundManager:Play("Click", 0.45)

        local ripple = Utility.Create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundTransparency = 0.65,
            Position = UDim2.fromOffset(
                input.Position.X - holder.AbsolutePosition.X,
                input.Position.Y - holder.AbsolutePosition.Y
            ),
            Size = UDim2.fromOffset(4, 4),
            ZIndex = 30,
        }, hoverOverlay)

        component:BindTheme(ripple, "BackgroundColor3", "Accent")

        Utility.Create("UICorner", {
            CornerRadius = UDim.new(1, 0),
        }, ripple)

        local targetSize = math.max(
            holder.AbsoluteSize.X,
            holder.AbsoluteSize.Y
        ) * 2

        local tween = AnimationManager:Tween(ripple, {
            Size = UDim2.fromOffset(targetSize, targetSize),
            BackgroundTransparency = 1,
        }, "Sine")

        if tween then
            tween.Completed:Once(function()
                if ripple and ripple.Parent then
                    ripple:Destroy()
                end
            end)
        else
            ripple:Destroy()
        end
    end)

    holder.Activated:Connect(function()
        if component.Destroyed or not component.Enabled then
            return
        end

        component:SafeCallback(options.Callback)
    end)

    table.insert(self.Components, component)

    return component
end

