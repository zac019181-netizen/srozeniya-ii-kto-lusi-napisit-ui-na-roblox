function Tab:AddTextbox(options)
    options = options or {}

    local component = Component.new(self.Library, self.Window, self.Page)

    local holder = Utility.Create("Frame", {
        Name = "Textbox",
        Size = UDim2.new(1, 0, 0, options.Description and 76 or 62),
        BackgroundTransparency = 0,
        LayoutOrder = #self.Components + 1,
    }, self.Page)

    StyleFrame(component, holder, "Element", 0)
    StyleStroke(component, holder, "Border", 0.35)

    local title = MakeLabel(component, holder, {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, options.Description and 8 or 7),
        Size = UDim2.new(1, -28, 0, 18),
        Text = options.Name or "Textbox",
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, "Text")

    if options.Description then
        MakeLabel(component, holder, {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(14, 28),
            Size = UDim2.new(1, -28, 0, 16),
            Text = options.Description,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, "TextDark")
    end

    local inputHeight = options.Description and 30 or 30

    local textBox = Utility.Create("TextBox", {
        BackgroundTransparency = 0,
        Position = UDim2.new(0, 10, 1, -inputHeight - 8),
        Size = UDim2.new(1, -20, 0, inputHeight),
        Text = tostring(options.Default or ""),
        PlaceholderText = options.Placeholder or "",
        ClearTextOnFocus = options.ClearOnFocus == true,
        MultiLine = options.MultiLine == true,
        TextWrapped = options.MultiLine == true,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, holder)

    if options.MultiLine then
        textBox.TextYAlignment = Enum.TextYAlignment.Top
    else
        textBox.TextYAlignment = Enum.TextYAlignment.Center
    end

    StyleFrame(component, textBox, "Panel", 0)
    StyleStroke(component, textBox, "Border", 0.25)
    component:BindTheme(textBox, "TextColor3", "Text")
    component:BindTheme(textBox, "PlaceholderColor3", "TextDark")
    component:BindFont(textBox)

    Utility.Create("UIPadding", {
        PaddingLeft = UDim.new(0, 9),
        PaddingRight = UDim.new(0, 9),
    }, textBox)

    component.Frame = holder
    component.TextBox = textBox
    component.Value = textBox.Text

    local passwordOverlay

    if options.Password then
        textBox.TextTransparency = 1

        passwordOverlay = MakeLabel(component, textBox.Parent, {
            BackgroundTransparency = 1,
            Position = textBox.Position,
            Size = textBox.Size,
            Text = "",
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Center,
            ZIndex = textBox.ZIndex + 1,
        }, "Text")

        Utility.Create("UIPadding", {
            PaddingLeft = UDim.new(0, 9),
            PaddingRight = UDim.new(0, 9),
        }, passwordOverlay)

        component.PasswordOverlay = passwordOverlay

        local function refreshPassword()
            local current = textBox.Text
            passwordOverlay.Text = string.rep("•", #current)
        end

        textBox:GetPropertyChangedSignal("Text"):Connect(refreshPassword)

        refreshPassword()
    end

    function component:SetValue(value, fireCallback)
        if self.Destroyed then
            return
        end

        textBox.Text = tostring(value or "")
        self.Value = textBox.Text

        if passwordOverlay then
            passwordOverlay.Text = string.rep("•", #textBox.Text)
        end

        if fireCallback ~= false then
            self:SafeCallback(options.Callback, self.Value)
        end

        ConfigManager:QueueAutoSave()
    end

    function component:GetValue()
        return textBox.Text
    end

    textBox.FocusLost:Connect(function()
        if component.Destroyed then
            return
        end

        component.Value = textBox.Text
        component:SafeCallback(options.Callback, component.Value)

        ConfigManager:QueueAutoSave()
    end)

    table.insert(self.Components, component)

    return component
end

