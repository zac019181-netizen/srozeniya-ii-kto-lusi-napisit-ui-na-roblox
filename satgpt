function Tab:AddKeybind(options)
    options = options or {}

    local component = Component.new(self.Library, self.Window, self.Page)

    local holder = Utility.Create("TextButton", {
        Name = "Keybind",
        Size = UDim2.new(1, 0, 0, options.Description and 62 or 50),
        BackgroundTransparency = 0,
        AutoButtonColor = false,
        Text = "",
        LayoutOrder = #self.Components + 1,
    }, self.Page)

    StyleFrame(component, holder, "Element", 0)
    StyleStroke(component, holder, "Border", 0.35)

    local title = MakeLabel(component, holder, {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, options.Description and 9 or 0),
        Size = UDim2.new(1, -100, options.Description and 22 or 50, 0),
        Text = options.Name or "Keybind",
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = options.Description and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
    }, "Text")

    if options.Description then
        MakeLabel(component, holder, {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(14, 33),
            Size = UDim2.new(1, -100, 18, 0),
            Text = options.Description,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, "TextDark")
    end

    local badge = Utility.Create("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.fromOffset(76, 28),
        BackgroundTransparency = 0,
    }, holder)

    StyleFrame(component, badge, "Panel", 0)
    StyleStroke(component, badge, "Border", 0.3)

    local badgeText = MakeLabel(component, badge, {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, "TextDark")

    component.Frame = holder
    component.Badge = badgeText
    component.Value = options.Default or Enum.KeyCode.Unknown
    component.Capturing = false

    local function formatKey(key)
        if typeof(key) ~= "EnumItem" then
            return "None"
        end

        if key.EnumType == Enum.KeyCode then
            return key.Name
        end

        if key.EnumType == Enum.UserInputType then
            local mapping = {
                MouseButton1 = "Mouse1",
                MouseButton2 = "Mouse2",
                MouseButton3 = "Mouse3",
            }

            return mapping[key.Name] or key.Name
        end

        return key.Name
    end

    local function validInput(input)
        if input.UserInputType == Enum.UserInputType.Keyboard then
            return input.KeyCode ~= Enum.KeyCode.Unknown
        end

        return input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.MouseButton2
    end

    local function fireChange()
        component:SafeCallback(options.OnChanged, component.Value)
    end

    local function setKey(key, fireCallback)
        if typeof(key) ~= "EnumItem" then
            return
        end

        component.Value = key
        badgeText.Text = formatKey(key)

        if fireCallback ~= false then
            fireChange()
        end

        ConfigManager:QueueAutoSave()
    end

    function component:SetKey(key, fireCallback)
        setKey(key, fireCallback)
    end

    function component:GetKey()
        return self.Value
    end

    function component:SetValue(key, fireCallback)
        setKey(key, fireCallback)
    end

    function component:GetValue()
        return self.Value
    end

    holder.Activated:Connect(function()
        if component.Destroyed then
            return
        end

        component.Capturing = true
        badgeText.Text = "Press key..."
        SoundManager:Play("Click", 0.35)
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if component.Destroyed or not component.Capturing then
            return
        end

        if gameProcessed then
            return
        end

        if not validInput(input) then
            return
        end

        component.Capturing = false

        local key

        if input.UserInputType == Enum.UserInputType.Keyboard then
            key = input.KeyCode
        else
            key = input.UserInputType
        end

        setKey(key, true)
        SoundManager:Play("Click", 0.35)
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if component.Destroyed
            or component.Capturing
            or gameProcessed then

            return
        end

        local matches = false

        if component.Value.EnumType == Enum.KeyCode then
            matches = input.UserInputType == Enum.UserInputType.Keyboard
                and input.KeyCode == component.Value
        elseif component.Value.EnumType == Enum.UserInputType then
            matches = input.UserInputType == component.Value
        end

        if matches then
            component:SafeCallback(options.Callback, component.Value)
        end
    end)

    badgeText.Text = formatKey(component.Value)

    table.insert(self.Components, component)

    return component
end

