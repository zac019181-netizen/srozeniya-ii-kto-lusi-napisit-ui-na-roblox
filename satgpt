            shadow:Destroy()
        end
    end)

    rootComponent:AddCleanup(function()
        if window.PopupLayer and window.PopupLayer.Parent then
            window.PopupLayer:Destroy()
        end
    end)

    window.RootComponent = rootComponent

    minimizeButton.Activated:Connect(function()
        if window.Minimized then
            window:Maximize()
        else
            window:Minimize()
        end

        SoundManager:Play("Click", 0.35)
    end)

    closeButton.Activated:Connect(function()
        window:Close()
        SoundManager:Play("Click", 0.35)

        if self.CloseOnToggleKey then
            return
        end
    end)

    ----------------------------------------------------------------
    -- Drag
    ----------------------------------------------------------------

    local dragging = false
    local dragInput
    local dragStart
    local startPosition

    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragInput = input
            dragStart = input.Position
            startPosition = root.Position
        end
    end)

    topBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging or input ~= dragInput or window.Destroyed then
            return
        end

        local delta = input.Position - dragStart

        local camera = workspace.CurrentCamera

        if not camera then
            return
        end

        local viewport = camera.ViewportSize
        local size = root.AbsoluteSize

        local desiredX = startPosition.X.Offset + delta.X
        local desiredY = startPosition.Y.Offset + delta.Y

        local centerX = viewport.X / 2
        local centerY = viewport.Y / 2

        local halfW = size.X / 2
        local halfH = size.Y / 2

        desiredX = math.clamp(
            centerX + (desiredX - centerX),
            halfW,
            viewport.X - halfW
        )

        desiredY = math.clamp(
            centerY + (desiredY - centerY),
            halfH,
            viewport.Y - halfH
        )

        root.Position = UDim2.fromOffset(desiredX, desiredY)
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = false
        end
    end)

    ----------------------------------------------------------------
    -- UI Toggle Key
    ----------------------------------------------------------------

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if window.Destroyed or gameProcessed then
            return
        end

        if input.UserInputType == Enum.UserInputType.Keyboard
            and input.KeyCode == window.ToggleKey then

            if root.Visible then
                window:Close()
            else
                window:Open()
            end

            SoundManager:Play("Click", 0.4)
        end
    end)

    ----------------------------------------------------------------
    -- Open animation
    ----------------------------------------------------------------

    if self.AnimationsEnabled then
        root.Size = UDim2.fromOffset(
            window.OriginalSize.X.Offset * 0.92,
            window.OriginalSize.Y.Offset * 0.92
        )

        root.BackgroundTransparency = 1

        AnimationManager:Tween(root, {
            Size = window.OriginalSize,
            BackgroundTransparency = 0,
        }, "Back")

        AnimationManager:Tween(shadow, {
            Size = window.OriginalSize + UDim2.fromOffset(18, 18),
            BackgroundTransparency = 0.75,
        }, "Sine")
    end

    self.Windows[window] = true

    return window
end

