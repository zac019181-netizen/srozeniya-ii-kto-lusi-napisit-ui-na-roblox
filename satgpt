local function StyleFrame(component, frame, colorToken, transparency)
    component:BindTheme(frame, "BackgroundColor3", colorToken)
    component:RegisterTransparency(frame, transparency or 0)

    local corner = Utility.Create("UICorner", {
        CornerRadius = UDim.new(0, 10),
    }, frame)

    return frame, corner
end

local function StyleStroke(component, object, token, transparency)
