        ZIndex = 8,
    }, "TextDark")

    local arrow = MakeLabel(component, selector, {
        AnchorPoint = Vector2.new(1, 0.5),
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(18, 18),
        Text = "⌄",
        TextSize = 15,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = 8,
    }, "TextDark")

    component.Frame = holder
    component.Selector = selector
    component.SelectedText = selectedText
    component.Arrow = arrow
    component.Open = false

    local popup
    local searchBox
    local listFrame
    local popupLayout
    local outsideConnection
    local positionConnections = {}

    local function getDisplayValue()
        if component.Multi then
            local values = {}

            for _, option in ipairs(component.Options) do
                if component.Value[option] then
                    table.insert(values, option)
                end
            end

            if #values == 0 then
                return "None"
            end

            return table.concat(values, ", ")
        end

        if component.Value == "" then
            return "Select..."
        end

        return tostring(component.Value)
    end

    local function updateDisplay()
        selectedText.Text = getDisplayValue()
    end

    local function clearPositionConnections()
        for _, connection in ipairs(positionConnections) do
            pcall(function()
                connection:Disconnect()
            end)
        end

        table.clear(positionConnections)
    end

    local function positionPopup()
        if not popup or not popup.Parent then
            return
        end

        local absolutePosition = selector.AbsolutePosition
        local absoluteSize = selector.AbsoluteSize

        popup.Position = UDim2.fromOffset(
            absolutePosition.X,
            absolutePosition.Y + absoluteSize.Y + 6
        )

        popup.Size = UDim2.fromOffset(
            math.max(220, absoluteSize.X),
            popup.Size.Y.Offset
        )
    end

    local function closeDropdown()
        if not component.Open then
            return
        end

        component.Open = false

        if outsideConnection then
            outsideConnection:Disconnect()
            outsideConnection = nil
        end

        clearPositionConnections()

        if popup then
            if Library.AnimationsEnabled then
                local tween = AnimationManager:Tween(popup, {
                    Size = UDim2.fromOffset(popup.AbsoluteSize.X, 0),
                    BackgroundTransparency = 1,
                }, "Sine")

                if tween then
                    tween.Completed:Once(function()
                        if popup and popup.Parent then
                            popup:Destroy()
                        end
                    end)
                end
            else
                popup:Destroy()
            end
        end

        popup = nil

        arrow.Text = "⌄"
        SoundManager:Play("Dropdown", 0.35)
    end

    local function openDropdown()
        if component.Destroyed then
            return
        end

        if component.Open then
            closeDropdown()
            return
        end

        if self.Window.OpenDropdown and self.Window.OpenDropdown ~= component then
            pcall(function()
                self.Window.OpenDropdown:_close()
            end)
        end

        self.Window.OpenDropdown = component
        component.Open = true

        local overlay = self.Window.PopupLayer

        popup = Utility.Create("Frame", {
            Name = "DropdownPopup",
            BackgroundTransparency = 0,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(0, 0),
            Size = UDim2.fromOffset(selector.AbsoluteSize.X, 0),
            ZIndex = 200,
        }, overlay)

        StyleFrame(component, popup, "Panel", 0)
        StyleStroke(component, popup, "Border", 0.15)

        Utility.Create("UIPadding", {
            PaddingTop = UDim.new(0, 7),
            PaddingBottom = UDim.new(0, 7),
            PaddingLeft = UDim.new(0, 7),
            PaddingRight = UDim.new(0, 7),
        }, popup)

        searchBox = Utility.Create("TextBox", {
            Name = "Search",
            BackgroundTransparency = 0,
            Size = UDim2.new(1, 0, 0, 30),
            PlaceholderText = "Search...",
            PlaceholderColor3 = ThemeManager:GetColor("TextDark"),
            Text = "",
            ClearTextOnFocus = false,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 202,
        }, popup)

        StyleFrame(component, searchBox, "Element", 0)
        StyleStroke(component, searchBox, "Border", 0.35)

        component:BindTheme(searchBox, "TextColor3", "Text")
        component:BindTheme(searchBox, "PlaceholderColor3", "TextDark")

        component:BindFont(searchBox)

        Utility.Create("UIPadding", {
            PaddingLeft = UDim.new(0, 9),
            PaddingRight = UDim.new(0, 9),
        }, searchBox)

        listFrame = Utility.Create("ScrollingFrame", {
            Name = "Options",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.fromOffset(0, 36),
            Size = UDim2.new(1, 0, 1, -36),
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 3,
            ScrollBarImageTransparency = 0.4,
            ZIndex = 202,
        }, popup)

        popupLayout = Utility.Create("UIListLayout", {
            Padding = UDim.new(0, 4),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, listFrame)

        local function selected(option)
            if component.Multi then
                return component.Value[option] == true
            end

            return component.Value == option
        end

        local function makeOption(option, index)
            local item = Utility.Create("TextButton", {
                Name = "Option",
                BackgroundTransparency = 0,
                Size = UDim2.new(1, -4, 0, 32),
                AutoButtonColor = false,
                Text = "",
                LayoutOrder = index,
                ZIndex = 203,
            }, listFrame)

            StyleFrame(component, item, "Element", 0)

            local label = MakeLabel(component, item, {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(9, 0),
                Size = UDim2.new(1, -32, 1, 0),
                Text = option,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 204,
            }, selected(option) and "Text" or "TextDark")

            local check = MakeLabel(component, item, {
                AnchorPoint = Vector2.new(1, 0.5),
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -9, 0.5, 0),
                Size = UDim2.fromOffset(16, 16),
                Text = selected(option) and "✓" or "",
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Center,
                ZIndex = 204,
            }, "Accent")

            item.MouseEnter:Connect(function()
                if item.Parent then
                    item.BackgroundColor3 = ThemeManager:GetColor("ElementHover")
                end
            end)

            item.MouseLeave:Connect(function()
                if item.Parent then
                    item.BackgroundColor3 = ThemeManager:GetColor("Element")
                end
            end)

            item.Activated:Connect(function()
                if component.Destroyed then
                    return
                end

                SoundManager:Play("Click", 0.35)

                if component.Multi then
                    component.Value[option] = not component.Value[option]
                else
                    component.Value = option
                    closeDropdown()
                end

                updateDisplay()

                if component.Multi then
                    component:SafeCallback(options.Callback, component.Value)
                else
                    component:SafeCallback(options.Callback, component.Value)
                end

                ConfigManager:QueueAutoSave()

                if component.Multi then
                    closeDropdown()
                end
            end)

            return item, label, check
        end

        for index, option in ipairs(component.Options) do
            makeOption(option, index)
        end

        local function applyFilter()
            local query = string.lower(searchBox.Text)

            for _, child in ipairs(listFrame:GetChildren()) do
                if child:IsA("TextButton") then
                    local matches = query == ""
                        or string.find(
                            string.lower(child:FindFirstChildOfClass("TextLabel") and child:FindFirstChildOfClass("TextLabel").Text or ""),
                            query,
                            1,
                            true
                        ) ~= nil

                    child.Visible = matches
                end
            end
        end

        searchBox:GetPropertyChangedSignal("Text"):Connect(applyFilter)

        outsideConnection = UserInputService.InputBegan:Connect(function(input)
            if component.Destroyed or not component.Open then
                return
            end

            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then

                return
            end

            local position = input.Position

            if Utility.PointInside(popup, position)
                or Utility.PointInside(selector, position) then

                return
            end

            closeDropdown()
        end)

        table.insert(positionConnections, selector:GetPropertyChangedSignal("AbsolutePosition"):Connect(positionPopup))
        table.insert(positionConnections, selector:GetPropertyChangedSignal("AbsoluteSize"):Connect(positionPopup))
        table.insert(positionConnections, self.Window.Root:GetPropertyChangedSignal("AbsolutePosition"):Connect(positionPopup))

        if self.Page then
            table.insert(positionConnections, self.Page:GetPropertyChangedSignal("CanvasPosition"):Connect(positionPopup))
        end

        positionPopup()

        local targetHeight = math.min(
            300,
            48 + math.max(32, math.min(#component.Options * 36, 230))
        )

        if Library.AnimationsEnabled then
            AnimationManager:Tween(popup, {
                Size = UDim2.fromOffset(popup.AbsoluteSize.X, targetHeight),
            }, "Sine")
        else
            popup.Size = UDim2.fromOffset(
                popup.AbsoluteSize.X,
                targetHeight
            )
        end

        arrow.Text = "⌃"

        SoundManager:Play("Dropdown", 0.35)
    end

    component._close = closeDropdown

    function component:SetOptions(newOptions)
        if self.Destroyed then
            return
        end

        closeDropdown()

        self.Options = {}

        for _, item in ipairs(newOptions or {}) do
            table.insert(self.Options, tostring(item))
        end

        if self.Multi then
            local newValues = {}

            for option in pairs(self.Value) do
                if table.find(self.Options, option) then
                    newValues[option] = true
                end
            end

            self.Value = newValues
        else
            if not table.find(self.Options, self.Value) then
                self.Value = self.Options[1] or ""
            end
        end

        updateDisplay()
    end

    function component:Refresh()
        self:SetOptions(self.Options)
    end

    function component:SetValue(newValue, fireCallback)
        if self.Destroyed then
            return
        end

        if self.Multi then
            local newValues = {}

            if type(newValue) == "table" then
                if #newValue > 0 then
                    for _, item in ipairs(newValue) do
                        local key = tostring(item)

                        if table.find(self.Options, key) then
                            newValues[key] = true
                        end
                    end
                else
                    for key, enabled in pairs(newValue) do
                        if enabled and table.find(self.Options, tostring(key)) then
                            newValues[tostring(key)] = true
                        end
                    end
                end
            end

            self.Value = newValues
        else
            newValue = tostring(newValue or "")

            if table.find(self.Options, newValue) then
                self.Value = newValue
            end
        end

        updateDisplay()

        if fireCallback ~= false then
            self:SafeCallback(options.Callback, self.Value)
        end

        ConfigManager:QueueAutoSave()
    end

    function component:GetValue()
        if self.Multi then
            return Utility.ShallowCopy(self.Value)
        end

        return self.Value
    end

    function component:Destroy()
        if self.Destroyed then
            return
        end

        closeDropdown()

        Component.Destroy(self)

        if self.Frame and self.Frame.Parent then
            self.Frame:Destroy()
        end
    end

    selector.Activated:Connect(function()
        openDropdown()
    end)

    updateDisplay()

    table.insert(self.Components, component)

    return component
end

