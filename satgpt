function NotificationManager:Notify(options)
    if Library.Destroyed or not self.Container then
        return nil
    end

    options = options or {}

    local titleText = tostring(options.Title or "Notification")
    local descriptionText = tostring(options.Description or "")
    local duration = math.max(0.5, tonumber(options.Duration) or 4)
    local notificationType = tostring(options.Type or "Info")

    local component = Component.new(Library, nil, self.Container)

    local holder = Utility.Create("Frame", {
        Name = "Notification",
        Size = UDim2.fromOffset(310, 78),
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
        LayoutOrder = #self.Notifications + 1,
        ZIndex = 501,
    }, self.Container)

    StyleFrame(component, holder, "Panel", 0)
    StyleStroke(component, holder, "Border", 0.18)

    local accent = Utility.Create("Frame", {
        Position = UDim2.fromOffset(0, 8),
        Size = UDim2.fromOffset(3, 62),
        BackgroundTransparency = 0,
        ZIndex = 503,
    }, holder)

    Utility.Create("UICorner", {
        CornerRadius = UDim.new(1, 0),
    }, accent)

    component:BindTheme(accent, "BackgroundColor3", notificationType)

    local iconMap = {
        Success = "✓",
        Info = "i",
        Warning = "!",
        Error = "×",
    }

    local iconCircle = Utility.Create("Frame", {
        Position = UDim2.fromOffset(14, 15),
        Size = UDim2.fromOffset(30, 30),
        BackgroundTransparency = 0,
        ZIndex = 503,
    }, holder)

    StyleFrame(component, iconCircle, notificationType, 0.1)

    local icon = MakeLabel(component, iconCircle, {
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Text = iconMap[notificationType] or "i",
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
        ZIndex = 504,
    }, notificationType)

    local title = MakeLabel(component, holder, {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(55, 11),
        Size = UDim2.new(1, -70, 0, 20),
        Text = titleText,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 503,
    }, "Text")

    local description = MakeLabel(component, holder, {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(55, 32),
        Size = UDim2.new(1, -70, 0, 28),
        Text = descriptionText,
        TextSize = 10,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 503,
    }, "TextDark")

    local progress = Utility.Create("Frame", {
        Position = UDim2.new(0, 10, 1, -5),
        Size = UDim2.new(1, -20, 0, 2),
        BackgroundTransparency = 0,
        ZIndex = 504,
    }, holder)

    Utility.Create("UICorner", {
        CornerRadius = UDim.new(1, 0),
    }, progress)

    component:BindTheme(progress, "BackgroundColor3", notificationType)

    component.Frame = holder

    table.insert(self.Notifications, component)

    function component:Close()
        if self.Destroyed then
            return
        end

        self.Destroyed = true

        if holder and holder.Parent then
            if Library.AnimationsEnabled then
                local tween = AnimationManager:Tween(holder, {
                    Size = UDim2.fromOffset(310, 0),
                    BackgroundTransparency = 1,
                }, "Sine")

                if tween then
                    tween.Completed:Once(function()
                        if holder and holder.Parent then
                            holder:Destroy()
                        end
                    end)
                else
                    holder:Destroy()
                end
            else
                holder:Destroy()
            end
        end

        Component.Destroy(self)
    end

    if Library.AnimationsEnabled then
        holder.Position = UDim2.fromOffset(30, 0)
        holder.BackgroundTransparency = 1

        AnimationManager:Tween(holder, {
            Position = UDim2.fromOffset(0, 0),
            BackgroundTransparency = 0,
        }, "Back")
    end

    SoundManager:Play("Notification", 0.5)

    local progressTween = AnimationManager:Tween(progress, {
        Size = UDim2.new(0, 0, 0, 2),
    }, "Linear")

    local timer = task.delay(duration, function()
        if not Library.Destroyed and not component.Destroyed then
            component:Close()
        end
    end)

    component:AddCleanup(function()
        pcall(function()
            task.cancel(timer)
        end)

        if progressTween then
            pcall(function()
                progressTween:Cancel()
            end)
        end

        local index = table.find(self.Notifications, component)

        if index then
            table.remove(self.Notifications, index)
        end
    end)

    return component
end

function NotificationManager:Destroy()
    for _, notification in ipairs(self.Notifications) do
        pcall(function()
            notification:Close()
        end)
    end

    table.clear(self.Notifications)

    if self.Container then
        self.Container:Destroy()
        self.Container = nil
    end
end

----------------------------------------------------------------
-- Library Core
----------------------------------------------------------------

function Library:Init()
    if self.ScreenGui then
        return self
    end

    self.ScreenGui = Utility.Create("ScreenGui", {
        Name = "MoonwalkUI",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 999999,
    }, LocalPlayer:WaitForChild("PlayerGui"))

    self.Windows = {}

    NotificationManager:Init()

    return self
end

function Library:RegisterTheme(name, theme)
    ThemeManager:RegisterTheme(name, theme)

    return true
end

function Library:SetTheme(name)
    if ThemeManager:SetTheme(name) then
        TransparencyManager:Reapply()
        return true
    end

    return false
end

function Library:GetTheme()
    return ThemeManager.CurrentTheme
end

function Library:SetFont(font)
    if typeof(font) == "string" then
        font = Enum.Font[font]
    end

    if typeof(font) ~= "EnumItem"
        or font.EnumType ~= Enum.Font then

        return false
    end

    self.Font = font

    FontManager:Reapply()

    return true
end

function Library:SetScale(scale)
    scale = tonumber(scale) or 1
    scale = math.clamp(scale, 0.5, 2)

    self.Scale = scale

    for window in pairs(self.Windows or {}) do
        if window.ScaleObject and window.ScaleObject.Parent then
            window.ScaleObject.Scale = scale
        end
    end

    return true
end

function Library:SetTransparency(value)
    value = tonumber(value) or 0
    value = math.clamp(value, 0, 0.85)

    self.Transparency = value

    TransparencyManager:Reapply()

    return true
end

function Library:SetAnimations(enabled)
    self.AnimationsEnabled = enabled == true
end

function Library:SetAnimationSpeed(speed)
    self.AnimationSpeed = math.max(
        0,
        tonumber(speed) or 0.25
    )
end

function Library:SetSound(name, id)
    SoundManager:SetSound(name, id)
end

function Library:SetSoundEnabled(enabled)
    SoundManager:SetEnabled(enabled)
end

function Library:SetSoundVolume(volume)
    SoundManager:SetVolume(volume)
end

function Library:SetNotificationVolume(volume)
    SoundManager:SetNotificationVolume(volume)
end

function Library:Notify(options)
    return NotificationManager:Notify(options)
end

function Library:SetAutoSave(enabled)
    ConfigManager:SetAutoSave(enabled)
end

function Library:SaveConfig(name)
    return ConfigManager:Save(name)
end

function Library:LoadConfig(name)
    return ConfigManager:Load(name)
end

function Library:DeleteConfig(name)
    return ConfigManager:Delete(name)
end

function Library:GetConfigs()
    return ConfigManager:GetConfigs()
end

function Library:ToggleUI()
    for window in pairs(self.Windows or {}) do
        window:Toggle()
    end
end

function Library:Destroy()
    if self.Destroyed then
        return
    end

    self.Destroyed = true

    for window in pairs(self.Windows or {}) do
        pcall(function()
            window:Destroy()
        end)
    end

    table.clear(self.Windows or {})

    NotificationManager:Destroy()
    AnimationManager:StopAll()
    SoundManager:Destroy()

    ConfigManager:Destroy()
    ThemeManager:Cleanup()
    FontManager:Cleanup()
    TransparencyManager:Cleanup()

    if self.ScreenGui then
        self.ScreenGui:Destroy()
        self.ScreenGui = nil
    end
end

----------------------------------------------------------------
-- Initialize
----------------------------------------------------------------

Library:Init()

return Library
