local ThemeManager = {
    Themes = {},
    CurrentTheme = "Dark",
    Bindings = {},
}

function ThemeManager:RegisterTheme(name, theme)
    assert(type(name) == "string", "Theme name must be a string")
    assert(type(theme) == "table", "Theme must be a table")

    self.Themes[name] = theme
end

function ThemeManager:GetTheme()
    return self.Themes[self.CurrentTheme]
end

function ThemeManager:GetColor(token)
    local theme = self:GetTheme()

    if not theme then
        return Color3.new(1, 1, 1)
    end

    return theme[token] or theme.Text or Color3.new(1, 1, 1)
end

function ThemeManager:Bind(instance, property, token, transform)
    local binding = {
        Instance = instance,
        Property = property,
        Token = token,
        Transform = transform,
        Alive = true,
    }

    table.insert(self.Bindings, binding)

    local value = self:GetColor(token)

    if transform then
        value = transform(value, token, self:GetTheme())
    end

    pcall(function()
        instance[property] = value
    end)

    return function()
        binding.Alive = false
    end
end

function ThemeManager:ReapplyBinding(binding)
    if not binding.Alive then
        return
    end

    if not binding.Instance or not binding.Instance.Parent then
        binding.Alive = false
        return
    end

    local value = self:GetColor(binding.Token)

    if binding.Transform then
        value = binding.Transform(value, binding.Token, self:GetTheme())
    end

    pcall(function()
        binding.Instance[binding.Property] = value
    end)
end

function ThemeManager:SetTheme(name)
    if not self.Themes[name] then
        warn("[Moonwalk UI] Unknown theme:", name)
        return false
    end

    self.CurrentTheme = name

    for _, binding in ipairs(self.Bindings) do
        self:ReapplyBinding(binding)
    end

    return true
end

function ThemeManager:Cleanup()
    table.clear(self.Bindings)
end

