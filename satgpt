----------------------------------------------------------------
-- Font Manager
----------------------------------------------------------------

local FontManager = {
    Bindings = {},
}

function FontManager:Bind(instance)
    local binding = {
        Instance = instance,
        Alive = true,
    }

    table.insert(self.Bindings, binding)

    pcall(function()
        instance.Font = Library.Font
    end)

    return function()
        binding.Alive = false
    end
end

function FontManager:Reapply()
    for _, binding in ipairs(self.Bindings) do
        if not binding.Alive then
            continue
        end

        if not binding.Instance or not binding.Instance.Parent then
            binding.Alive = false
            continue
        end

        pcall(function()
            binding.Instance.Font = Library.Font
        end)
    end
end

function FontManager:Cleanup()
    table.clear(self.Bindings)
end

----------------------------------------------------------------
-- Animation Manager
----------------------------------------------------------------

local AnimationManager = {
    ActiveTweens = {},
}

function AnimationManager:GetInfo(style)
    style = style or "Quad"

    local easingStyle = Enum.EasingStyle.Quad

    if style == "Linear" then
        easingStyle = Enum.EasingStyle.Linear
    elseif style == "Sine" then
        easingStyle = Enum.EasingStyle.Sine
    elseif style == "Back" then
        easingStyle = Enum.EasingStyle.Back
    elseif style == "Quint" then
        easingStyle = Enum.EasingStyle.Quint
    end

    local speed = Library.AnimationSpeed

    if not Library.AnimationsEnabled then
        speed = 0
    end

    return TweenInfo.new(
        speed,
        easingStyle,
        Enum.EasingDirection.Out
    )
end

function AnimationManager:Tween(instance, properties, style)
    if not instance or not instance.Parent then
        return nil
    end

    local info = self:GetInfo(style)

    local tween = TweenService:Create(
        instance,
        info,
        properties
    )

    table.insert(self.ActiveTweens, tween)

    tween.Completed:Connect(function()
        local index = table.find(self.ActiveTweens, tween)

        if index then
            table.remove(self.ActiveTweens, index)
        end
    end)

    tween:Play()

    return tween
end

function AnimationManager:StopAll()
    for _, tween in ipairs(self.ActiveTweens) do
        pcall(function()
            tween:Cancel()
        end)
    end

    table.clear(self.ActiveTweens)
end

----------------------------------------------------------------
-- Sound Manager
----------------------------------------------------------------

local SoundManager = {
    Sounds = {},
    SoundIds = {
        Click = "",
        Hover = "",
        Notification = "",
        Dropdown = "",
    },
}

function SoundManager:_getSound(name)
    local id = self.SoundIds[name]

    if not id or id == "" then
        return nil
    end

    local sound = self.Sounds[name]

    if sound and sound.Parent then
        return sound
    end

    local gui = Library.ScreenGui

    if not gui then
        return nil
    end

    sound = Utility.Create("Sound", {
        Name = "MoonwalkSound_" .. name,
        SoundId = id,
        Volume = 0.5,
    }, gui)

    self.Sounds[name] = sound

    return sound
end

function SoundManager:SetSound(name, id)
    name = tostring(name)

    self.SoundIds[name] = tostring(id or "")

    local sound = self.Sounds[name]

    if sound then
        sound.SoundId = self.SoundIds[name]
    end
end

function SoundManager:SetEnabled(enabled)
    Library.SoundEnabled = enabled == true
end

function SoundManager:SetVolume(volume)
    Library.SoundVolume = math.clamp(tonumber(volume) or 0.5, 0, 1)
end

function SoundManager:SetNotificationVolume(volume)
    Library.NotificationVolume = math.clamp(tonumber(volume) or 0.65, 0, 1)
end

function SoundManager:Play(name, volume)
    if not Library.SoundEnabled then
        return
    end

    local sound = self:_getSound(name)

    if not sound then
        return
    end

    sound.Volume = math.clamp(
        (volume or 1)
            * Library.SoundVolume
            * (name == "Notification" and Library.NotificationVolume or 1),
        0,
        1
    )

    sound.TimePosition = 0

    pcall(function()
        sound:Play()
    end)
end

function SoundManager:Destroy()
    for _, sound in pairs(self.Sounds) do
        pcall(function()
            sound:Destroy()
        end)
    end

    table.clear(self.Sounds)
end

----------------------------------------------------------------
-- Transparency Manager
----------------------------------------------------------------

local TransparencyManager = {
    Objects = {},
}

function TransparencyManager:Register(object, baseTransparency)
    if not object:IsA("GuiObject") then
        return
    end

    local entry = {
        Object = object,
        Base = baseTransparency or object.BackgroundTransparency,
        Alive = true,
    }

    table.insert(self.Objects, entry)

    self:Apply(entry)

    return function()
        entry.Alive = false
    end
end

function TransparencyManager:Apply(entry)
    if not entry.Alive then
        return
    end

    if not entry.Object or not entry.Object.Parent then
        entry.Alive = false
        return
    end

    local base = entry.Base or 0
    local amount = Library.Transparency

    local result = base + ((1 - base) * amount)

    entry.Object.BackgroundTransparency = math.clamp(result, 0, 1)
end

function TransparencyManager:Reapply()
    for _, entry in ipairs(self.Objects) do
        self:Apply(entry)
    end
end

function TransparencyManager:Cleanup()
    table.clear(self.Objects)
end

----------------------------------------------------------------
-- Config Manager
----------------------------------------------------------------

local ConfigManager = {
    FolderName = "MoonwalkUI",
    ConfigFolderName = "Configs",

    Controls = {},
    Pending = {},
    MemoryConfigs = {},

    Loading = false,
    AutoSave = false,
    SaveThread = nil,
    Alive = true,
}

local function serializeValue(value)
    if typeof(value) == "EnumItem" then
        return {
            __type = "EnumItem",
            EnumType = tostring(value.EnumType),
            Name = value.Name,
        }
    end

    if type(value) == "table" then
        local result = {}

        for key, item in pairs(value) do
            result[key] = serializeValue(item)
        end

        return result
    end

    if type(value) == "string"
        or type(value) == "number"
        or type(value) == "boolean"
        or value == nil then

        return value
    end

    return tostring(value)
end

local function deserializeValue(value)
    if type(value) ~= "table" then
        return value
    end

    if value.__type == "EnumItem" then
        local enumObject = Enum[value.EnumType]

        if enumObject then
            local item = enumObject[value.Name]

            if item then
                return item
            end
        end

        return Enum.KeyCode.Unknown
    end

    local result = {}

    for key, item in pairs(value) do
        result[key] = deserializeValue(item)
    end

    return result
end

function ConfigManager:_filePath(name)
    local safeName = Utility.SanitizeFileName(name)

    return self.FolderName
        .. "/"
        .. self.ConfigFolderName
        .. "/"
        .. safeName
        .. ".json"
end

function ConfigManager:_hasFilesystem()
    return type(isfile) == "function"
        and type(readfile) == "function"
        and type(writefile) == "function"
end

function ConfigManager:_ensureFolders()
    if type(makefolder) ~= "function" then
        return
    end

    local folder = self.FolderName
    local configFolder = self.FolderName .. "/" .. self.ConfigFolderName

    if type(isfolder) == "function" then
        if not isfolder(folder) then
            pcall(makefolder, folder)
        end

        if not isfolder(configFolder) then
            pcall(makefolder, configFolder)
        end
    else
        pcall(makefolder, folder)
        pcall(makefolder, configFolder)
    end
end

function ConfigManager:Register(control)
    self.Controls[control.ConfigKey] = control

    local pending = self.Pending[control.ConfigKey]

    if pending ~= nil then
        task.defer(function()
            if control.Destroyed then
                return
            end

            self.Loading = true

            pcall(function()
                control:SetValue(deserializeValue(pending), false)
            end)

            self.Loading = false

            self.Pending[control.ConfigKey] = nil
        end)
    end
end

function ConfigManager:Unregister(control)
    if self.Controls[control.ConfigKey] == control then
        self.Controls[control.ConfigKey] = nil
    end
end

function ConfigManager:BuildData()
    local data = {
        Version = Library.Version,
        Controls = {},
    }

    for key, control in pairs(self.Controls) do
        if not control.Destroyed and type(control.GetValue) == "function" then
            local success, value = pcall(function()
                return control:GetValue()
            end)

            if success then
                data.Controls[key] = serializeValue(value)
            end
        end
    end

    return data
end

function ConfigManager:_write(name, data)
    local encoded = HttpService:JSONEncode(data)

    if self:_hasFilesystem() then
        self:_ensureFolders()

        local path = self:_filePath(name)

        local success, err = pcall(function()
            writefile(path, encoded)
        end)

        if not success then
            warn("[Moonwalk UI] Failed to write config:", err)
            return false
        end

        return true
    end

    self.MemoryConfigs[Utility.SanitizeFileName(name)] = encoded

    return true
end

function ConfigManager:Save(name)
    if not self.Alive then
        return false
    end

    name = name or "Default"

    local data = self:BuildData()

    return self:_write(name, data)
end

function ConfigManager:Load(name)
    name = name or "Default"

    local encoded

    if self:_hasFilesystem() then
        local path = self:_filePath(name)

        if not isfile(path) then
            warn("[Moonwalk UI] Config not found:", name)
            return false
        end

        local success, result = pcall(readfile, path)

        if not success then
            warn("[Moonwalk UI] Failed to read config:", result)
            return false
        end

        encoded = result
    else
        encoded = self.MemoryConfigs[Utility.SanitizeFileName(name)]

        if not encoded then
            warn("[Moonwalk UI] Config not found:", name)
            return false
        end
    end

    local success, data = pcall(function()
        return HttpService:JSONDecode(encoded)
    end)

    if not success or type(data) ~= "table" then
        warn("[Moonwalk UI] Invalid config:", name)
        return false
    end

    self.Loading = true

    self.Pending = {}

    for key, value in pairs(data.Controls or {}) do
        self.Pending[key] = value
    end

    for key, control in pairs(self.Controls) do
        local value = self.Pending[key]

        if value ~= nil then
            pcall(function()
                control:SetValue(deserializeValue(value), false)
            end)

            self.Pending[key] = nil
        end
    end

    self.Loading = false

    return true
end

function ConfigManager:Delete(name)
    name = name or "Default"

    local safeName = Utility.SanitizeFileName(name)

    if self:_hasFilesystem() then
        if type(delfile) ~= "function" then
            return false
        end

        local path = self:_filePath(name)

        if isfile(path) then
            return pcall(delfile, path)
        end

        return false
    end

    if self.MemoryConfigs[safeName] then
        self.MemoryConfigs[safeName] = nil
        return true
    end

    return false
end

function ConfigManager:GetConfigs()
    local configs = {}

    if self:_hasFilesystem() and type(listfiles) == "function" then
        self:_ensureFolders()

        local success, files = pcall(listfiles, self.FolderName .. "/" .. self.ConfigFolderName)

        if success and type(files) == "table" then
            for _, path in ipairs(files) do
                local name = path:match("([^/\\]+)%.json$")

                if name then
                    table.insert(configs, name)
                end
            end
        end
    else
        for name in pairs(self.MemoryConfigs) do
            table.insert(configs, name)
        end
    end

    table.sort(configs)

    return configs
end

function ConfigManager:SetAutoSave(enabled)
    self.AutoSave = enabled == true
end

function ConfigManager:QueueAutoSave()
    if not self.AutoSave
        or self.Loading
        or not self.Alive then

        return
    end

    if self.SaveThread then
        task.cancel(self.SaveThread)
        self.SaveThread = nil
    end

    self.SaveThread = task.delay(0.5, function()
        self.SaveThread = nil

        if not self.Alive then
            return
        end

        self:Save("AutoSave")
    end)
end

function ConfigManager:Destroy()
    self.Alive = false

    if self.SaveThread then
        task.cancel(self.SaveThread)
        self.SaveThread = nil
    end

    table.clear(self.Controls)
    table.clear(self.Pending)
end

----------------------------------------------------------------
-- Component Base
----------------------------------------------------------------

local Component = {}
Component.__index = Component

function Component.new(library, window, parent)
    local self = setmetatable({}, Component)

    self.Library = library
    self.Window = window
    self.Parent = parent

    self.Connections = {}
    self.CleanupTasks = {}
    self.ThemeUnbinds = {}
    self.FontUnbinds = {}

    self.Destroyed = false

    return self
end

function Component:Connect(connection)
    table.insert(self.Connections, connection)
    return connection
end

function Component:BindTheme(instance, property, token, transform)
    local unbind = ThemeManager:Bind(
        instance,
        property,
        token,
        transform
    )

    table.insert(self.ThemeUnbinds, unbind)

    return unbind
end

function Component:BindFont(instance)
    local unbind = FontManager:Bind(instance)

    table.insert(self.FontUnbinds, unbind)

    return unbind
end

function Component:RegisterTransparency(instance, base)
    return TransparencyManager:Register(instance, base)
end

function Component:AddCleanup(callback)
    table.insert(self.CleanupTasks, callback)
end

function Component:SafeCallback(callback, ...)
    if self.Destroyed
        or self.Library.Destroyed then

        return
    end

    Utility.SafeCall(callback, ...)
end

function Component:Destroy()
    if self.Destroyed then
        return
    end

    self.Destroyed = true

    for _, connection in ipairs(self.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(self.Connections)

    for _, unbind in ipairs(self.ThemeUnbinds) do
        pcall(unbind)
    end

    table.clear(self.ThemeUnbinds)

    for _, unbind in ipairs(self.FontUnbinds) do
        pcall(unbind)
    end

    table.clear(self.FontUnbinds)

    for _, callback in ipairs(self.CleanupTasks) do
        pcall(callback)
    end

    table.clear(self.CleanupTasks)
end

