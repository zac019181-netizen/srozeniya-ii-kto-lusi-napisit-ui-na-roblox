function Tab:AddSlider(options)
    options = options or {}

    local minValue = tonumber(options.Min) or 0
    local maxValue = tonumber(options.Max) or 100

    if maxValue <= minValue then
        maxValue = minValue + 1
    end

    local rounding = math.max(0, tonumber(options.Rounding) or 0)
    local suffix = tostring(options.Suffix or "")
    local value = tonumber(options.Default) or minValue

    value = Utility.Clamp(value, minValue, maxValue)
    value = Utility.Round(value, rounding)

    local component = Component.new(self.Library, self.Window, self.Page)

    local holder = Utility.Create("Frame", {
        Name = "Slider",
        Size = UDim2.new(1, 0, 0, 78),
        BackgroundTransparency = 0,
        LayoutOrder = #self.Components + 1,
    }, self.Page)

    StyleFrame(component, holder, "Element", 0)
    StyleStroke(component, holder, "Border", 0.35)

    local title = MakeLabel(component, holder, {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 9),
        Size = UDim2.new(1, -100, 0, 20),
        Text = options.Name or "Slider",
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, "Text")

    local valueLabel = MakeLabel(component, holder, {
        AnchorPoint = Vector2.new(1, 0),
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -14, 0, 9),
        Size = UDim2.fromOffset(80, 20),
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, "TextDark")

    local track = Utility.Create("Frame", {
        Position = UDim2.new(0, 14, 0, 44),
        Size = UDim2.new(1, -28, 0, 6),
        BackgroundTransparency = 0,
    }, holder)

    StyleFrame(component, track, "Border", 0)

    local fill = Utility.Create("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundTransparency = 0,
    }, track)

    Utility.Create("UICorner", {
        CornerRadius = UDim.new(1, 0),
    }, fill)

    component:BindTheme(fill, "BackgroundColor3", "Accent")

    local knob = Utility.Create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(16, 16),
        BackgroundTransparency = 0,
    }, track)

    StyleFrame(component, knob, "Accent", 0)

    component.Frame = holder
    component.Value = value

    local dragging = false

    local function refresh(instant)
        local percent = (component.Value - minValue) / (maxValue - minValue)
        percent = math.clamp(percent, 0, 1)

        valueLabel.Text = tostring(component.Value) .. suffix

        local targetFill = UDim2.new(percent, 0, 1, 0)
        local targetKnob = UDim2.new(percent, 0, 0.5, 0)

        if instant or not Library.AnimationsEnabled then
            fill.Size = targetFill
            knob.Position = targetKnob
        else
            AnimationManager:Tween(fill, {
                Size = targetFill,
            })

            AnimationManager:Tween(knob, {
                Position = targetKnob,
            })
        end
    end

    function component:SetValue(newValue, fireCallback)
        if self.Destroyed then
            return
        end

        newValue = tonumber(newValue)

        if not newValue then
            return
        end

        newValue = Utility.Clamp(newValue, minValue, maxValue)
        newValue = Utility.Round(newValue, rounding)

        self.Value = newValue

        refresh(false)

        if fireCallback ~= false then
            self:SafeCallback(options.Callback, self.Value)
        end

        ConfigManager:QueueAutoSave()
    end

    function component:GetValue()
        return self.Value
    end

    local function setFromPosition(x)
        if component.Destroyed then
            return
        end

        local absolute = track.AbsolutePosition.X
        local width = track.AbsoluteSize.X

        local percent = (x - absolute) / width

        percent = math.clamp(percent, 0, 1)

        local newValue = minValue
            + ((maxValue - minValue) * percent)

        component:SetValue(newValue)
    end

    track.InputBegan:Connect(function(input)
        if component.Destroyed then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true

            SoundManager:Play("Click", 0.3)

            setFromPosition(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if component.Destroyed or not dragging then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            setFromPosition(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = false
        end
    end)

    table.insert(self.Components, component)

    refresh(true)

    return component
end

