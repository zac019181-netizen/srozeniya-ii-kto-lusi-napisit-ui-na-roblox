----------------------------------------------------------------

local Window = {}
Window.__index = Window

function Window:_setTitle(title, subtitle)
    self.TitleLabel.Text = tostring(title or self.TitleLabel.Text)

    if subtitle ~= nil then
        self.SubtitleLabel.Text = tostring(subtitle)
    end
end

function Window:SetToggleKey(key)
    if typeof(key) ~= "EnumItem" then
        return
    end

    if key.EnumType ~= Enum.KeyCode then
        return
    end

    self.ToggleKey = key
end

function Window:SelectTab(tab)
    if self.Destroyed or tab.Destroyed then
        return
    end

    if self.ActiveTab == tab then
        return
    end

    if self.ActiveTab then
        self.ActiveTab.Page.Visible = false
        self.ActiveTab.SelectedBar.BackgroundTransparency = 1
        self.ActiveTab.ButtonBackground.BackgroundTransparency = 1
    end

    self.ActiveTab = tab

    tab.Page.Visible = true
    tab.SelectedBar.BackgroundTransparency = 0

    if Library.AnimationsEnabled then
        AnimationManager:Tween(tab.ButtonBackground, {
            BackgroundTransparency = 0.65,
        })
    else
        tab.ButtonBackground.BackgroundTransparency = 0.65
    end

    SoundManager:Play("Click", 0.25)
end

function Window:AddTab(options)
    if self.Destroyed then
        return nil
    end

    options = options or {}

    local tab = Tab.new(self, options)

    table.insert(self.Tabs, tab)

    if not self.ActiveTab then
        self:SelectTab(tab)
    end

    return tab
end

function Window:Minimize()
    if self.Destroyed or self.Minimized then
        return
    end

    self.Minimized = true

    if self.Library.AnimationsEnabled then
        AnimationManager:Tween(self.Root, {
            Size = UDim2.fromOffset(self.OriginalSize.X.Offset, 62),
        }, "Sine")

        self.Content.Visible = false
        self.Sidebar.Visible = false
    else
        self.Root.Size = UDim2.fromOffset(self.OriginalSize.X.Offset, 62)
        self.Content.Visible = false
        self.Sidebar.Visible = false
    end
end

function Window:Maximize()
    if self.Destroyed then
        return
    end

    self.Minimized = false

    self.Content.Visible = true
    self.Sidebar.Visible = true

    if self.Library.AnimationsEnabled then
        AnimationManager:Tween(self.Root, {
            Size = self.OriginalSize,
        }, "Sine")
    else
        self.Root.Size = self.OriginalSize
    end
end

function Window:Toggle()
    if self.Destroyed then
        return
    end

    if self.Root.Visible then
        self.Root.Visible = false
    else
        self.Root.Visible = true
    end
end

function Window:Close()
    if self.Destroyed then
        return
    end

    if self.Root.Visible then
        self.Root.Visible = false
    end
end

function Window:Open()
    if self.Destroyed then
        return
    end

    self.Root.Visible = true
end

function Window:Destroy()
    if self.Destroyed then
        return
    end

    self.Destroyed = true

    if self.OpenDropdown and self.OpenDropdown._close then
        pcall(function()
            self.OpenDropdown:_close()
        end)
    end

    for _, connection in ipairs(self.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(self.Connections)

    for _, tab in ipairs(self.Tabs) do
        tab.Destroyed = true

        for _, component in ipairs(tab.Components) do
            pcall(function()
                component:Destroy()
            end)
        end

        if tab.PageComponent then
            pcall(function()
                tab.PageComponent:Destroy()
            end)
        end

        pcall(function()
            if tab.Page and tab.Page.Parent then
                tab.Page:Destroy()
            end
        end)

        pcall(function()
            if tab.SidebarButton and tab.SidebarButton.Parent then
                tab.SidebarButton:Destroy()
            end
        end)
    end

    table.clear(self.Tabs)

    if self.Root then
        self.Root:Destroy()
    end

    if self.PopupLayer then
        self.PopupLayer:Destroy()
    end

    if Library.Windows[self] then
        Library.Windows[self] = nil
    end
end

