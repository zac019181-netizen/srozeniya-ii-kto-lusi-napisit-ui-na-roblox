            table.insert(Tab.Sections, Section)
            return Section
        end

        return Tab
    end

    --================================================================--
    --                     BUILT-IN SETTINGS TAB                      --
    --================================================================--
    function Window:AddSettingsTab()
        local SettingsTab = Window:AddTab({
            Name = "Settings",
            Icon = "rbxassetid://6031280882"
        })

        local secUI = SettingsTab:AddSection("Interface")
        
        secUI:AddDropdown({
            Name = "Theme",
            Options = {"Dark", "Midnight", "Moonwalk", "Cyan", "Red", "Green"},
            Default = Library.CurrentTheme,
            Callback = function(theme)
                Library:SetTheme(theme)
            end
        })

        secUI:AddSlider({
            Name = "UI Scale",
            Min = 0.8,
            Max = 1.4,
            Default = Library.Scale,
            Rounding = 2,
            Suffix = "x",
            Callback = function(val)
                Library:SetScale(val)
            end
        })

        secUI:AddToggle({
            Name = "Animations",
            Default = Library.AnimationsEnabled,
            Callback = function(val)
                Library.AnimationsEnabled = val
            end
        })

        local secAudio = SettingsTab:AddSection("Audio")
        
        secAudio:AddToggle({
            Name = "UI Sounds",
            Default = SoundManager.Enabled,
            Callback = function(val)
                Library:SetSoundEnabled(val)
            end
        })

        secAudio:AddSlider({
            Name = "Master Volume",
            Min = 0,
            Max = 100,
            Default = SoundManager.MasterVolume * 100,
            Rounding = 0,
            Suffix = "%",
            Callback = function(val)
                Library:SetSoundVolume(val / 100)
            end
        })

        local secConfigs = SettingsTab:AddSection("Profiles")
        local configInput = ""

        secConfigs:AddTextbox({
            Name = "Profile Name",
            Placeholder = "MyConfig",
            Callback = function(val)
                configInput = val
            end
        })

        secConfigs:AddButton({
            Name = "Save Profile",
            Callback = function()
                if configInput ~= "" then
                    local ok = Library:SaveConfig(configInput)
                    Library:Notify({
                        Title = ok and "Config Saved" or "Save Failed",
                        Description = ok and ("Saved config as: " .. configInput) or "Filesystem write failed",
                        Type = ok and "Success" or "Error",
                        Duration = 3
                    })
                end
            end
        })

        secConfigs:AddButton({
            Name = "Load Profile",
            Callback = function()
                if configInput ~= "" then
                    local ok = Library:LoadConfig(configInput)
                    Library:Notify({
                        Title = ok and "Config Loaded" or "Load Failed",
                        Description = ok and ("Loaded: " .. configInput) or "Profile does not exist",
                        Type = ok and "Success" or "Error",
                        Duration = 3
                    })
                end
            end
        })

        return SettingsTab
    end

    table.insert(Library.Windows, Window)
    return Window
end

return Library
