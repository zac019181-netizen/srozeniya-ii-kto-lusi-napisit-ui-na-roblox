            -- IMAGE COMPONENT
            function Section:AddImage(imgOptions)
                imgOptions = imgOptions or {}
                local image = imgOptions.Image or ""
                local height = imgOptions.Height or 120

                local imgContainer = Utility.Create("Frame", {
                    Size = UDim2.new(1, 0, 0, height),
                    Parent = sectionFrame
                }, {
                    Utility.Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
                    Utility.Create("UIStroke", {
                        Thickness = 1,
                        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                    })
                })
                ThemeManager:Bind(imgContainer, "BackgroundColor3", "Tertiary")
                ThemeManager:Bind(imgContainer:FindFirstChildOfClass("UIStroke"), "Color", "Border")

                local img = Utility.Create("ImageLabel", {
