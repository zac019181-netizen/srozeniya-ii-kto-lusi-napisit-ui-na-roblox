                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = sliderFrame
                })
                FontManager:Bind(titleTxt, true)
                ThemeManager:Bind(titleTxt, "TextColor3", "Text")

                local valueTxt = Utility.Create("TextLabel", {
                    Size = UDim2.new(0.3, 0, 0, 16),
                    Position = UDim2.new(0.7, 0, 0, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(default) .. suffix,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    Parent = sliderFrame
                })
                FontManager:Bind(valueTxt, false)
                ThemeManager:Bind(valueTxt, "TextColor3", "TextDark")

                -- Track & Fill
                local track = Utility.Create("TextButton", {
                    Size = UDim2.new(1, 0, 0, 6),
                    Position = UDim2.new(0, 0, 0, 28),
                    AutoButtonColor = false,
                    Text = "",
                    Parent = sliderFrame
                }, {
                    Utility.Create("UICorner", { CornerRadius = UDim.new(1, 0) })
                })
                ThemeManager:Bind(track, "BackgroundColor3", "Border")

                local fill = Utility.Create("Frame", {
                    Size = UDim2.new(0, 0, 1, 0),
                    Parent = track
                }, {
                    Utility.Create("UICorner", { CornerRadius = UDim.new(1, 0) })
                })
                ThemeManager:Bind(fill, "BackgroundColor3", "Accent")

                local function UpdateFromProgress(progress, animate)
                    local rawVal = min + (max - min) * progress
                    local roundedVal = Utility.Round(rawVal, rounding)
                    roundedVal = Utility.Clamp(roundedVal, min, max)
                    Slider.Value = roundedVal
                    valueTxt.Text = tostring(roundedVal) .. suffix
                    
                    local fillSize = UDim2.new(Utility.Clamp(progress, 0, 1), 0, 1, 0)
                    if animate then
                        AnimationManager.Tween(fill, { Size = fillSize }, 0.08)
                    else
                        fill.Size = fillSize
                    end
                end

                local dragging = false
                local function ProcessInput(input)
                    local trackAbsPos = track.AbsolutePosition.X
                    local trackAbsSize = track.AbsoluteSize.X
                    local progress = (input.Position.X - trackAbsPos) / trackAbsSize
                    progress = Utility.Clamp(progress, 0, 1)
                    UpdateFromProgress(progress, true)
                    Utility.SafeCallback(callback, Slider.Value)
                end

                track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        ProcessInput(input)
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        ProcessInput(input)
                    end
                end)

                function Slider:SetValue(val)
                    val = Utility.Clamp(Utility.Round(val, rounding), min, max)
                    local progress = (val - min) / (max - min)
                    UpdateFromProgress(progress, false)
                    Utility.SafeCallback(callback, Slider.Value)
                end

                function Slider:GetValue()
                    return Slider.Value
                end

                function Slider:Destroy()
                    sliderFrame:Destroy()
                end

                Slider:SetValue(default)
                ConfigManager:Register(flag, Slider)
                return Slider
            end

