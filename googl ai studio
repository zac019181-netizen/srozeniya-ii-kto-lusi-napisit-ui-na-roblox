local FontManager = {
    Bindings = {}
}

function FontManager:Bind(instance, isBold)
    table.insert(self.Bindings, { Instance = instance, IsBold = isBold })
    instance.Font = isBold and Library.CurrentFontBold or Library.CurrentFont
    
    instance.Destroying:Connect(function()
        for i, b in ipairs(self.Bindings) do
            if b.Instance == instance then
                table.remove(self.Bindings, i)
                break
            end
        end
    end)
end

function FontManager:Update()
    for _, b in ipairs(self.Bindings) do
        if b.Instance and b.Instance.Parent then
            b.Instance.Font = b.IsBold and Library.CurrentFontBold or Library.CurrentFont
        end
    end
end

function Library:SetFont(font, boldFont)
    Library.CurrentFont = font or Enum.Font.Gotham
    Library.CurrentFontBold = boldFont or Enum.Font.GothamBold
    FontManager:Update()
end

--====================================================================--
--                         CONFIG MANAGER                             --
--====================================================================--
local ConfigManager = {
    Elements = {},
    AutoSave = false,
    Folder = "MoonwalkConfigs"
}

function ConfigManager:Register(flag, component)
    if not flag then return end
    self.Elements[flag] = component
end

function ConfigManager:GetSaveData()
    local data = {}
    for flag, comp in pairs(self.Elements) do
        if comp.GetValue then
            data[flag] = comp:GetValue()
        end
    end
    return data
end

function ConfigManager:Save(name)
    local data = self:GetSaveData()
    local json = HttpService:JSONEncode(data)
    
    if writefile then
        if not isfolder or not isfolder(self.Folder) then
            if makefolder then makefolder(self.Folder) end
        end
        writefile(self.Folder .. "/" .. name .. ".json", json)
        return true
    end
    return false
end

function ConfigManager:Load(name)
    local filePath = self.Folder .. "/" .. name .. ".json"
    local json
    
    if isfile and isfile(filePath) and readfile then
        json = readfile(filePath)
    else
        return false
    end
    
    local success, decoded = pcall(function()
        return HttpService:JSONDecode(json)
    end)
    
    if success and typeof(decoded) == "table" then
        for flag, value in pairs(decoded) do
            local comp = self.Elements[flag]
            if comp and comp.SetValue then
                comp:SetValue(value)
            end
        end
        return true
    end
    return false
end

function ConfigManager:GetConfigs()
    local configs = {}
    if listfiles and isfolder and isfolder(self.Folder) then
        for _, file in ipairs(listfiles(self.Folder)) do
            if file:sub(-5) == ".json" then
                local name = file:match("([^/\\]+)%.json$")
                if name then table.insert(configs, name) end
            end
        end
    end
    return configs
end

function Library:SaveConfig(name) return ConfigManager:Save(name) end
function Library:LoadConfig(name) return ConfigManager:Load(name) end
function Library:GetConfigs() return ConfigManager:GetConfigs() end
function Library:SetAutoSave(state) ConfigManager.AutoSave = state end

