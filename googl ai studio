function ThemeManager:GetColor(themeKey)
    local theme = self.Themes[Library.CurrentTheme] or self.Themes.Dark
    return theme[themeKey] or Color3.fromRGB(255, 255, 255)
end

function ThemeManager:Bind(instance, property, themeKey)
    if not instance then return end
    
    local entry = { Instance = instance, Property = property, Key = themeKey }
    table.insert(self.Bindings, entry)
    
    -- Initial color application
    instance[property] = self:GetColor(themeKey)
    
    -- Auto-clean destroyed instances
    local conn
    conn = instance.Destroying:Connect(function()
        conn:Disconnect()
        for i, b in ipairs(self.Bindings) do
            if b.Instance == instance and b.Property == property then
                table.remove(self.Bindings, i)
                break
            end
        end
    end)
end

function ThemeManager:Update()
    for _, binding in ipairs(self.Bindings) do
        if binding.Instance and binding.Instance.Parent then
            AnimationManager.Tween(binding.Instance, {
                [binding.Property] = self:GetColor(binding.Key)
            }, 0.3)
        end
    end
end

function Library:RegisterTheme(name, themeData)
    ThemeManager.Themes[name] = themeData
end

function Library:SetTheme(themeName)
    if ThemeManager.Themes[themeName] then
        Library.CurrentTheme = themeName
        ThemeManager:Update()
    end
end

