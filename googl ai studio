local function InitializeRoot()
    if Library.ScreenGui then return end
    
    local parent = GetSafeGuiParent()
    Library.ScreenGui = Utility.Create("ScreenGui", {
        Name = "MoonwalkLibrary",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 100,
        Parent = parent
    })
    
    Library.UIScale = Utility.Create("UIScale", {
        Scale = Library.Scale,
        Parent = Library.ScreenGui
    })
    
    Library.OverlayFrame = Utility.Create("Frame", {
        Name = "OverlayPortal",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        ZIndex = 5000,
        Parent = Library.ScreenGui
    })
    
    -- Global Toggle Key Connection
    local toggleCon = UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == Library.ToggleKey then
            Library:ToggleUI()
        end
    end)
    table.insert(Library.Connections, toggleCon)
end

function Library:ToggleUI()
    self.Open = not self.Open
    for _, win in ipairs(self.Windows) do
        if self.Open then
            win.MainFrame.Visible = true
            AnimationManager.Tween(win.MainFrame, {
                GroupTransparency = 0,
                Size = win.InitialSize
            }, 0.25)
        else
            local t = AnimationManager.Tween(win.MainFrame, {
                GroupTransparency = 1,
                Size = UDim2.new(win.InitialSize.X.Scale, win.InitialSize.X.Offset, win.InitialSize.Y.Scale, win.InitialSize.Y.Offset - 20)
            }, 0.2)
            if t then
                t.Completed:Connect(function()
                    if not self.Open then
                        win.MainFrame.Visible = false
                    end
                end)
            else
                win.MainFrame.Visible = false
            end
        end
    end
end

function Library:SetScale(scale)
    self.Scale = Utility.Clamp(scale, 0.5, 2.0)
    if self.UIScale then
        self.UIScale.Scale = self.Scale
    end
end

