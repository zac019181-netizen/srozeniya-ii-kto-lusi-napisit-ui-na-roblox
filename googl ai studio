                closeTween.Completed:Connect(function()
                    notifFrame:Destroy()
                end)
            else
                notifFrame:Destroy()
            end
        end
    end)
end

--====================================================================--
--                         INPUT & DRAG                               --
--====================================================================--
local function EnableDragging(frame, dragHandle)
    dragHandle = dragHandle or frame
    local dragging = false
    local dragInput, mousePos, framePos

    local con1 = dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            mousePos = input.Position
            framePos = frame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    local con2 = dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    local con3 = UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - mousePos
            local viewportSize = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
            
            local newX = framePos.X.Offset + delta.X
            local newY = framePos.Y.Offset + delta.Y
            
            -- Clamp inside viewport safely
            newX = Utility.Clamp(newX, 0, viewportSize.X - frame.AbsoluteSize.X)
            newY = Utility.Clamp(newY, 0, viewportSize.Y - frame.AbsoluteSize.Y)
            
            AnimationManager.Tween(frame, {
                Position = UDim2.fromOffset(newX, newY)
            }, 0.08)
        end
    end)

    return { con1, con2, con3 }
end

