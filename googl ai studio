                        SortOrder = Enum.SortOrder.LayoutOrder,
                        Padding = UDim.new(0, 2)
                    }),
                    Utility.Create("UIPadding", {
                        PaddingLeft = UDim.new(0, 4),
                        PaddingRight = UDim.new(0, 4),
                        PaddingTop = UDim.new(0, 4),
                        PaddingBottom = UDim.new(0, 4)
                    })
                })
                ThemeManager:Bind(scroll, "ScrollBarImageColor3", "Border")

                local function UpdatePreview()
                    if multi then
                        local selected = {}
                        for opt, state in pairs(Dropdown.Value) do
                            if state then table.insert(selected, opt) end
                        end
                        selectionPreview.Text = #selected > 0 and table.concat(selected, ", ") or "None"
                    else
                        selectionPreview.Text = tostring(Dropdown.Value or "None")
                    end
                end

                local function CloseDropdown()
                    Dropdown.IsOpen = false
                    AnimationManager.Tween(arrow, { Rotation = 0 }, 0.2)
                    local t = AnimationManager.Tween(menuList, { Size = UDim2.fromOffset(dropdownFrame.AbsoluteSize.X, 0) }, 0.15)
                    if t then
                        t.Completed:Connect(function()
                            if not Dropdown.IsOpen then menuList.Visible = false end
                        end)
                    else
                        menuList.Visible = false
                    end
                end

                local function OpenDropdown()
                    Dropdown.IsOpen = true
                    menuList.Position = UDim2.fromOffset(dropdownFrame.AbsolutePosition.X, dropdownFrame.AbsolutePosition.Y + dropdownFrame.AbsoluteSize.Y + 4)
                    menuList.Size = UDim2.fromOffset(dropdownFrame.AbsoluteSize.X, 0)
                    menuList.Visible = true
                    
                    local totalHeight = math.min(#Dropdown.Options * 30 + 8, 160)
                    AnimationManager.Tween(arrow, { Rotation = 180 }, 0.2)
                    AnimationManager.Tween(menuList, { Size = UDim2.fromOffset(dropdownFrame.AbsoluteSize.X, totalHeight) }, 0.2)
                end

                local function BuildOptions()
                    for _, child in ipairs(scroll:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end

                    for _, option in ipairs(Dropdown.Options) do
                        local optBtn = Utility.Create("TextButton", {
                            Size = UDim2.new(1, 0, 0, 28),
                            AutoButtonColor = false,
                            Text = "",
                            Parent = scroll
                        }, {
                            Utility.Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
                            Utility.Create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) })
                        })
                        ThemeManager:Bind(optBtn, "BackgroundColor3", "Tertiary")

                        local optLabel = Utility.Create("TextLabel", {
                            Size = UDim2.new(1, 0, 1, 0),
                            BackgroundTransparency = 1,
                            Text = option,
                            TextSize = 12,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            Parent = optBtn
                        })
                        FontManager:Bind(optLabel, false)
                        ThemeManager:Bind(optLabel, "TextColor3", "Text")

                        optBtn.MouseButton1Click:Connect(function()
                            SoundManager:Play("Click")
                            if multi then
                                Dropdown.Value[option] = not Dropdown.Value[option]
                                optLabel.TextColor3 = Dropdown.Value[option] and ThemeManager:GetColor("Accent") or ThemeManager:GetColor("Text")
                            else
                                Dropdown.Value = option
                                CloseDropdown()
                            end
                            UpdatePreview()
                            Utility.SafeCallback(callback, Dropdown.Value)
                        end)

                        optBtn.MouseEnter:Connect(function()
                            AnimationManager.Tween(optBtn, { BackgroundColor3 = ThemeManager:GetColor("Border") }, 0.1)
                        end)
                        optBtn.MouseLeave:Connect(function()
                            AnimationManager.Tween(optBtn, { BackgroundColor3 = ThemeManager:GetColor("Tertiary") }, 0.1)
                        end)
                    end
                end

                dropdownFrame.MouseButton1Click:Connect(function()
                    SoundManager:Play("Dropdown")
                    if Dropdown.IsOpen then
                        CloseDropdown()
                    else
                        OpenDropdown()
                    end
                end)

                -- Close when clicking outside
                local closeCon = UserInputService.InputBegan:Connect(function(input)
                    if Dropdown.IsOpen and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                        local mPos = UserInputService:GetMouseLocation()
                        local inFrame = mPos.X >= dropdownFrame.AbsolutePosition.X and mPos.X <= dropdownFrame.AbsolutePosition.X + dropdownFrame.AbsoluteSize.X and
                                        mPos.Y >= dropdownFrame.AbsolutePosition.Y and mPos.Y <= dropdownFrame.AbsolutePosition.Y + dropdownFrame.AbsoluteSize.Y
                        local inList = mPos.X >= menuList.AbsolutePosition.X and mPos.X <= menuList.AbsolutePosition.X + menuList.AbsoluteSize.X and
                                       mPos.Y >= menuList.AbsolutePosition.Y and mPos.Y <= menuList.AbsolutePosition.Y + menuList.AbsoluteSize.Y
                        if not inFrame and not inList then
                            CloseDropdown()
                        end
                    end
                end)
                table.insert(Window.Connections, closeCon)

                function Dropdown:SetOptions(newOptions)
                    Dropdown.Options = newOptions or {}
                    BuildOptions()
                end

                function Dropdown:SetValue(val)
                    Dropdown.Value = val
                    UpdatePreview()
                    Utility.SafeCallback(callback, Dropdown.Value)
                end

                function Dropdown:GetValue()
                    return Dropdown.Value
                end

                function Dropdown:Destroy()
                    menuList:Destroy()
                    dropdownFrame:Destroy()
                end

                BuildOptions()
                if default then Dropdown:SetValue(default) end
                ConfigManager:Register(flag, Dropdown)
                return Dropdown
            end

            -- TEXTBOX COMPONENT
            function Section:AddTextbox(textboxOptions)
                textboxOptions = textboxOptions or {}
                local name = textboxOptions.Name or "Textbox"
                local desc = textboxOptions.Description
                local placeholder = textboxOptions.Placeholder or "Type here..."
                local default = textboxOptions.Default or ""
                local clearOnFocus = textboxOptions.ClearOnFocus or false
                local callback = textboxOptions.Callback or function() end
                local flag = textboxOptions.Flag

                local Textbox = { Value = default }

                local tbFrame = Utility.Create("Frame", {
                    Size = UDim2.new(1, 0, 0, desc and 44 or 36),
                    Parent = sectionFrame
                }, {
                    Utility.Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
                    Utility.Create("UIStroke", {
                        Thickness = 1,
                        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                    }),
                    Utility.Create("UIPadding", {
                        PaddingLeft = UDim.new(0, 12),
                        PaddingRight = UDim.new(0, 12)
                    })
                })
                ThemeManager:Bind(tbFrame, "BackgroundColor3", "Tertiary")
                ThemeManager:Bind(tbFrame:FindFirstChildOfClass("UIStroke"), "Color", "Border")

                local titleTxt = Utility.Create("TextLabel", {
                    Size = UDim2.new(0.5, 0, 0, 16),
                    Position = UDim2.new(0, 0, 0, desc and 6 or 10),
                    BackgroundTransparency = 1,
                    Text = name,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = tbFrame
                })
                FontManager:Bind(titleTxt, true)
                ThemeManager:Bind(titleTxt, "TextColor3", "Text")

                if desc then
                    local descTxt = Utility.Create("TextLabel", {
                        Size = UDim2.new(0.5, 0, 0, 14),
                        Position = UDim2.new(0, 0, 0, 24),
                        BackgroundTransparency = 1,
                        Text = desc,
                        TextSize = 11,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Parent = tbFrame
                    })
                    FontManager:Bind(descTxt, false)
                    ThemeManager:Bind(descTxt, "TextColor3", "TextDark")
                end

                local boxContainer = Utility.Create("Frame", {
                    Size = UDim2.new(0.45, 0, 0, 24),
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    Parent = tbFrame
                }, {
                    Utility.Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
                    Utility.Create("UIStroke", {
                        Thickness = 1,
                        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                    }),
                    Utility.Create("UIPadding", {
                        PaddingLeft = UDim.new(0, 6),
                        PaddingRight = UDim.new(0, 6)
                    })
                })
                ThemeManager:Bind(boxContainer, "BackgroundColor3", "Secondary")
                ThemeManager:Bind(boxContainer:FindFirstChildOfClass("UIStroke"), "Color", "Border")

                local input = Utility.Create("TextBox", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = default,
                    PlaceholderText = placeholder,
                    ClearTextOnFocus = clearOnFocus,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = boxContainer
                })
                FontManager:Bind(input, false)
                ThemeManager:Bind(input, "TextColor3", "Text")
                ThemeManager:Bind(input, "PlaceholderColor3", "TextDark")

                input.Focused:Connect(function()
                    AnimationManager.Tween(boxContainer:FindFirstChildOfClass("UIStroke"), { Color = ThemeManager:GetColor("Accent") }, 0.15)
                end)

                input.FocusLost:Connect(function(enterPressed)
                    AnimationManager.Tween(boxContainer:FindFirstChildOfClass("UIStroke"), { Color = ThemeManager:GetColor("Border") }, 0.15)
                    Textbox.Value = input.Text
                    Utility.SafeCallback(callback, Textbox.Value, enterPressed)
                end)

                function Textbox:SetValue(val)
                    Textbox.Value = val
                    input.Text = val
                    Utility.SafeCallback(callback, val)
                end

                function Textbox:GetValue()
                    return Textbox.Value
                end

                function Textbox:Destroy()
                    tbFrame:Destroy()
                end

                ConfigManager:Register(flag, Textbox)
                return Textbox
            end

            -- KEYBIND COMPONENT
            function Section:AddKeybind(keybindOptions)
                keybindOptions = keybindOptions or {}
                local name = keybindOptions.Name or "Keybind"
                local default = keybindOptions.Default or Enum.KeyCode.Unknown
                local callback = keybindOptions.Callback or function() end
                local flag = keybindOptions.Flag

                local Keybind = {
                    Value = default,
                    Binding = false
                }

                local kbFrame = Utility.Create("Frame", {
                    Size = UDim2.new(1, 0, 0, 36),
                    Parent = sectionFrame
                }, {
                    Utility.Create("UICorner", { CornerRadius = UDim.new(0, 6) }),
                    Utility.Create("UIStroke", {
                        Thickness = 1,
                        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                    }),
                    Utility.Create("UIPadding", {
                        PaddingLeft = UDim.new(0, 12),
                        PaddingRight = UDim.new(0, 12)
                    })
                })
                ThemeManager:Bind(kbFrame, "BackgroundColor3", "Tertiary")
                ThemeManager:Bind(kbFrame:FindFirstChildOfClass("UIStroke"), "Color", "Border")

                local titleTxt = Utility.Create("TextLabel", {
                    Size = UDim2.new(0.6, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = name,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = kbFrame
                })
                FontManager:Bind(titleTxt, true)
                ThemeManager:Bind(titleTxt, "TextColor3", "Text")

                local bindBtn = Utility.Create("TextButton", {
                    Size = UDim2.fromOffset(70, 22),
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    AutoButtonColor = false,
                    Text = default.Name,
                    TextSize = 11,
                    Parent = kbFrame
                }, {
                    Utility.Create("UICorner", { CornerRadius = UDim.new(0, 4) }),
                    Utility.Create("UIStroke", {
                        Thickness = 1,
                        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                    })
                })
                FontManager:Bind(bindBtn, true)
                ThemeManager:Bind(bindBtn, "BackgroundColor3", "Secondary")
                ThemeManager:Bind(bindBtn, "TextColor3", "TextDark")
                ThemeManager:Bind(bindBtn:FindFirstChildOfClass("UIStroke"), "Color", "Border")

                bindBtn.MouseButton1Click:Connect(function()
                    Keybind.Binding = true
                    bindBtn.Text = "..."
                    ThemeManager:Bind(bindBtn, "TextColor3", "Accent")
                end)

                local bindCon = UserInputService.InputBegan:Connect(function(input, processed)
                    if Keybind.Binding then
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            Keybind.Value = input.KeyCode
                            Keybind.Binding = false
                            bindBtn.Text = input.KeyCode.Name
                            ThemeManager:Bind(bindBtn, "TextColor3", "TextDark")
                        end
                    elseif not processed and input.KeyCode == Keybind.Value then
                        Utility.SafeCallback(callback, Keybind.Value)
                    end
                end)
                table.insert(Window.Connections, bindCon)

                function Keybind:SetKey(k)
                    Keybind.Value = k
                    bindBtn.Text = k.Name
                end

                function Keybind:GetKey()
                    return Keybind.Value
                end

                ConfigManager:Register(flag, Keybind)
                return Keybind
            end

            -- LABEL COMPONENT
