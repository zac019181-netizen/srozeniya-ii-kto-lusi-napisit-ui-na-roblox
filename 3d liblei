                Header.TextColor3 =
                    theme.TextColor

                Header.TextSize =
                    13

                Header.Font =
                    Enum.Font.Gotham

                Header.TextXAlignment =
                    Enum.TextXAlignment.Left

                Header.Parent =
                    Dropdown

                Header.ZIndex =
                    50

                padding(
                    Header,
                    10,
                    10,
                    0,
                    0
                )

                ----------------------------------------------------
                -- OPTIONS
                ----------------------------------------------------

                local List =
                    Instance.new(
                        "Frame"
                    )

                List.Name =
                    "Options"

                List.Position =
                    UDim2.new(
                        0,
                        0,
                        0,
                        CLOSED_HEIGHT
                    )

                List.Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        0
                    )

                List.AutomaticSize =
                    Enum.AutomaticSize.Y

                List.BackgroundTransparency =
                    1

                List.ClipsDescendants =
                    true

                List.Parent =
                    Dropdown

                List.ZIndex =
                    60

                padding(
                    List,
                    4,
                    4,
                    3,
                    4
                )

                local ListLayout =
                    Instance.new(
                        "UIListLayout"
                    )

                ListLayout.Padding =
                    UDim.new(
                        0,
                        3
                    )

                ListLayout.SortOrder =
                    Enum.SortOrder.LayoutOrder

                ListLayout.Parent =
                    List

                local function updateHeader()

                    Header.Text =
                        tostring(
                            name
                        )
                        .. ": "
                        .. tostring(
                            Current
                            or "None"
                        )

                end

                updateHeader()

                ----------------------------------------------------
                -- OPTIONS
                ----------------------------------------------------

                for _, option in ipairs(
                    options
                ) do

                    local Option =
                        Instance.new(
                            "TextLabel"
                        )

                    Option.Name =
                        tostring(
                            option
                        )

                    Option.Size =
                        UDim2.new(
                            1,
                            0,
                            0,
                            OptionHeight
                        )

                    Option.BackgroundColor3 =
                        theme.Background

                    Option.Text =
                        tostring(
                            option
                        )

                    Option.TextColor3 =
                        theme.TextColor

                    Option.TextSize =
                        12

                    Option.Font =
                        Enum.Font.Gotham

                    Option.Parent =
                        List

                    Option.ZIndex =
                        61

                    corner(
                        Option,
                        4
                    )

                    register(
                        Option,
                        function()

                            ------------------------------------------------
                            -- OPTION IS ONLY HIT WHEN List/Dropdown
                            -- IS ACTUALLY VISIBLE.
                            ------------------------------------------------

                            Current =
                                option

                            updateHeader()

                            Opened =
                                false

                            tweenObject(
                                Dropdown,
                                0.18,
                                {
                                    Size =
                                        UDim2.new(
                                            1,
                                            0,
                                            0,
                                            CLOSED_HEIGHT
                                        )
                                },
                                Enum.EasingStyle.Quart
                            )

                            safeCall(
                                callback,
                                Current
                            )

                        end
                    )

                end

                ----------------------------------------------------
                -- OPEN HEIGHT
                ----------------------------------------------------

                local function openHeight()

                    local contentHeight =
                        ListLayout
                            .AbsoluteContentSize.Y

                    return
                        CLOSED_HEIGHT
                        + contentHeight
                        + 7

                end

                ----------------------------------------------------
                -- OPEN/CLOSE
                ----------------------------------------------------

                local function setOpen(
                    state
                )

                    if Opened ==
                        state then

                        return
                    end

                    Opened =
                        state

                    if Opened then

                        ------------------------------------------------
                        -- MAKE OPTIONS VISIBLE BEFORE GROWING
                        ------------------------------------------------

                        List.Visible =
                            true

                        local target =
                            openHeight()

                        tweenObject(
                            Dropdown,
                            0.22,
                            {
                                Size =
                                    UDim2.new(
                                        1,
                                        0,
                                        0,
                                        target
                                    )
                            },
                            Enum.EasingStyle.Quart
                        )

                    else

                        ------------------------------------------------
                        -- SHRINK FIRST
                        ------------------------------------------------

                        local animation =
                            tweenObject(
                                Dropdown,
                                0.18,
                                {
                                    Size =
                                        UDim2.new(
                                            1,
                                            0,
                                            0,
                                            CLOSED_HEIGHT
                                        )
                                },
                                Enum.EasingStyle.Quart
                            )

                        animation.Completed:Once(
                            function()

                                if not Opened then

                                    List.Visible =
                                        false

                                end

                            end
                        )

                    end

                end

                ----------------------------------------------------
                -- HEADER HITBOX ONLY
                ----------------------------------------------------

                register(
                    Header,
                    function()

                        setOpen(
                            not Opened
                        )

                    end
                )

                ----------------------------------------------------
                -- OBJECT
                ----------------------------------------------------

                local Object = {
                    Instance = Dropdown,
                    Header = Header,
                    Options = List,
                }

                function Object:Set(
                    value
                )

                    for _, option in ipairs(
                        options
                    ) do

                        if option ==
                            value then

                            Current =
                                value

                            updateHeader()

                            safeCall(
                                callback,
                                Current
                            )

                            return true

                        end

                    end

                    return false

                end

                function Object:Get()

                    return Current

                end

                function Object:Open()

                    setOpen(
                        true
                    )

                end

                function Object:Close()

                    setOpen(
                        false
                    )

                end

                function Object:IsOpen()

                    return Opened

                end

                return Object

            end

