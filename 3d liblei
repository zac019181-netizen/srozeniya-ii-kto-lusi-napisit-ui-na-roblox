    ----------------------------------------------------------------
    -- CONNECTION TRACKER
    ----------------------------------------------------------------

    local function connect(signal, fn)
        local connection = signal:Connect(fn)
        table.insert(self._connections, connection)
        return connection
    end

    ----------------------------------------------------------------
    -- RAYCAST PARAMS
    ----------------------------------------------------------------
    --
    -- IMPORTANT:
    -- This is an actual RaycastParams object, not a dictionary.
    ----------------------------------------------------------------

    local rayParams = RaycastParams.new()

    rayParams.FilterType =
        Enum.RaycastFilterType.Include

    rayParams.FilterDescendantsInstances = {
        WindowPart
    }

    rayParams.IgnoreWater = true

    ----------------------------------------------------------------
    -- FOLLOW POSITION
    ----------------------------------------------------------------

    local function getFollowCFrame()

        local root = getRoot()

        if not root then
            return nil
        end

        return
            root.CFrame
            * CFrame.new(
                0,
                self.FollowHeight,
                -self.FollowDistance
            )
            * CFrame.Angles(
                0,
                math.rad(180),
                0
            )
    end

    ----------------------------------------------------------------
    -- RAYCAST -> SURFACE POSITION
    ----------------------------------------------------------------

    local function getMouseSurfacePosition()

        if not self.Visible
            or self.Animating
            or self.Destroyed then

            return nil
        end

        local camera = workspace.CurrentCamera

        if not camera then
            return nil
        end

        local mousePosition =
            UserInputService:GetMouseLocation()

        local ray =
            camera:ViewportPointToRay(
                mousePosition.X,
                mousePosition.Y
            )

        local result

        local success = pcall(function()

            result = workspace:Raycast(
                ray.Origin,
                ray.Direction * 1000,
                rayParams
            )

        end)

        if not success then
            return nil
        end

        if not result then
            return nil
        end

        if result.Instance ~= WindowPart then
            return nil
        end

        local localPoint =
            WindowPart.CFrame:PointToObjectSpace(
                result.Position
            )

        local halfX =
            WindowPart.Size.X / 2

        local halfY =
            WindowPart.Size.Y / 2

        local x =
            (
                localPoint.X
                + halfX
            )
            / WindowPart.Size.X

        local y =
            (
                -localPoint.Y
                + halfY
            )
            / WindowPart.Size.Y

        ------------------------------------------------------------
        -- MIRROR X
        ------------------------------------------------------------

        x = 1 - x

        x = math.clamp(x, 0, 1)
        y = math.clamp(y, 0, 1)

        return Vector2.new(
            x * Surface.AbsoluteSize.X,
            y * Surface.AbsoluteSize.Y
        )
    end

    ----------------------------------------------------------------
    -- GUI VISIBILITY
    ----------------------------------------------------------------

    local function isVisibleThroughParents(gui)

        local current = gui

        while current
            and current ~= Surface do

            if current:IsA("GuiObject")
                and not current.Visible then

                return false

            end

            current = current.Parent
        end

        return true
    end

    ----------------------------------------------------------------
    -- POINT INSIDE
    ----------------------------------------------------------------

    local function pointInside(gui, point)

        if not gui
            or not gui.Parent then

            return false
        end

        if not isVisibleThroughParents(gui) then
            return false
        end

        local position =
            gui.AbsolutePosition

        local size =
            gui.AbsoluteSize

        return
            point.X >= position.X
            and point.X <=
                position.X + size.X
            and point.Y >= position.Y
            and point.Y <=
                position.Y + size.Y
    end

    ----------------------------------------------------------------
    -- CLIPPING CHECK
    ----------------------------------------------------------------

    local function pointInsideVisibleParents(
        gui,
        point
    )

        local current = gui

        while current
            and current ~= Surface do

            if current:IsA("GuiObject") then

                if not current.Visible then
                    return false
                end

                if current.ClipsDescendants then

                    if not pointInside(
                        current,
                        point
                    ) then

                        return false
                    end

                end
            end

            current =
                current.Parent
        end

        return true
    end

    ----------------------------------------------------------------
    -- HITBOX REGISTRY
    ----------------------------------------------------------------

    local Hitboxes = {}

    local function register(
        gui,
        callback
    )

        Hitboxes[gui] =
            callback

    end

    local function unregister(gui)
        Hitboxes[gui] = nil
    end

    ----------------------------------------------------------------
    -- HIT TEST
    ----------------------------------------------------------------

    local function getHit(point)

        local selected = nil
        local selectedCallback = nil

        local highestZ = -math.huge

        for gui, callback in pairs(
            Hitboxes
        ) do

            if gui
                and gui.Parent
                and gui:IsA("GuiObject")
                and pointInsideVisibleParents(
                    gui,
                    point
                ) then

                if gui.ZIndex >= highestZ then

                    highestZ =
                        gui.ZIndex

                    selected =
                        gui

                    selectedCallback =
                        callback
                end
            end
        end

        return selected,
            selectedCallback
    end

    ----------------------------------------------------------------
    -- SCROLLBAR VISIBILITY
    ----------------------------------------------------------------

    local function setScrollbarsVisible(
        state
    )

        for _, page in ipairs(
            Pages:GetChildren()
        ) do

            if page:IsA(
                "ScrollingFrame"
            ) then

                page.ScrollBarImageTransparency =
                    state
                    and 0
                    or 1
            end
        end
    end

    ----------------------------------------------------------------
    -- TAB VISUALS
    ----------------------------------------------------------------

    local function clearTabVisuals()

        self.HoveredTab = nil

        for _, tab in ipairs(
            self.Tabs
        ) do

            if tab.Button
                and tab.Button.Parent then

                tab.Button.BackgroundTransparency =
                    1
            end
        end
    end

    local function restoreActiveTab()

        if self.ActiveTab
            and self.ActiveTab.Button
            and self.ActiveTab.Button.Parent
            then

            self.ActiveTab.Button.BackgroundTransparency =
                0
        end
    end

    ----------------------------------------------------------------
    -- ALPHA
    ----------------------------------------------------------------

    local function prepareVisualState()

        for _, object in ipairs(
            Surface:GetDescendants()
        ) do

            if object:IsA(
                "GuiObject"
            ) then

                if object:GetAttribute(
                    "OriginalBG"
                ) == nil then

                    object:SetAttribute(
                        "OriginalBG",
                        object.BackgroundTransparency
                    )

                end

            end

            if object:IsA(
                "TextLabel"
            )
            or object:IsA(
                "TextButton"
            )
            or object:IsA(
                "TextBox"
            ) then

                if object:GetAttribute(
                    "OriginalText"
                ) == nil then

                    object:SetAttribute(
                        "OriginalText",
                        object.TextTransparency
                    )

                end

            elseif object:IsA(
                "ImageLabel"
            )
            or object:IsA(
                "ImageButton"
            ) then

                if object:GetAttribute(
                    "OriginalImage"
                ) == nil then

                    object:SetAttribute(
                        "OriginalImage",
                        object.ImageTransparency
                    )

                end
            end
        end
    end

    local function setAlpha(alpha)

        alpha =
            math.clamp(
                alpha,
                0,
                1
            )

        prepareVisualState()

        for _, object in ipairs(
            Surface:GetDescendants()
        ) do

            if object:IsA("GuiObject") then

                local originalBG =
                    object:GetAttribute(
                        "OriginalBG"
                    )

                if originalBG ~= nil then

                    object.BackgroundTransparency =
                        originalBG
                        + (
                            1 - originalBG
                        ) * alpha
                end
            end

            if object:IsA(
                "TextLabel"
            )
            or object:IsA(
                "TextButton"
            )
            or object:IsA(
                "TextBox"
            ) then

                local original =
                    object:GetAttribute(
                        "OriginalText"
                    )

                if original ~= nil then

                    object.TextTransparency =
                        original
                        + (
                            1 - original
                        ) * alpha
                end

            elseif object:IsA(
                "ImageLabel"
            )
            or object:IsA(
                "ImageButton"
            ) then

                local original =
                    object:GetAttribute(
                        "OriginalImage"
                    )

                if original ~= nil then

                    object.ImageTransparency =
                        original
                        + (
                            1 - original
                        ) * alpha
                end
            end
        end

        setScrollbarsVisible(
            alpha == 0
                and self.Visible
                and not self.Animating
        )
    end

    ----------------------------------------------------------------
    -- DESTROY
    ----------------------------------------------------------------

    function self:Destroy()

        if self.Destroyed then
            return
        end

        self.Destroyed = true
        self.Visible = false
        self.Animating = true

        ------------------------------------------------------------
        -- STOP SLIDER
        ------------------------------------------------------------

        ActiveSlider = nil

        ------------------------------------------------------------
        -- DISCONNECT EVERYTHING
        ------------------------------------------------------------

        for _, connection in ipairs(
            self._connections
        ) do

            if connection then
                pcall(function()
                    connection:Disconnect()
                end)
            end
        end

        table.clear(
            self._connections
        )

        ------------------------------------------------------------
        -- CLEAR REGISTRIES
        ------------------------------------------------------------

        table.clear(Hitboxes)
        table.clear(self.Tabs)

        self.CurrentTab = nil
        self.ActiveTab = nil
        self.HoveredTab = nil

        ------------------------------------------------------------
        -- REMOVE PART
        ------------------------------------------------------------

        if WindowPart
            and WindowPart.Parent then

            WindowPart:Destroy()

        end

        ------------------------------------------------------------
        -- CLEAR REFERENCES
        ------------------------------------------------------------

        self.Part = nil
        self.Surface = nil
        self.Main = nil
        self.Animating = false

    end

    ----------------------------------------------------------------
    -- ANIMATION: RESTORE NORMAL SIZE
    ----------------------------------------------------------------

    local function getNormalSize()

        return Vector3.new(
            self.BaseSize.X
                * self.SizeMultiplier,

            self.BaseSize.Y
                * self.SizeMultiplier,

            self.BaseSize.Z
        )

    end

    ----------------------------------------------------------------
    -- ANIMATION: SETUP
    ----------------------------------------------------------------

    local function restoreNormalSize()

        WindowPart.Size =
            getNormalSize()

        self._savedWorldSize =
            nil
    end

    ----------------------------------------------------------------
    -- SHOW
    ----------------------------------------------------------------

    function self:Show()

        if self.Destroyed
            or self.Visible
            or self.Animating then

            return
        end

        self.Animating = true

        ActiveSlider = nil

        ------------------------------------------------------------
        -- COMPLETELY HIDDEN
        ------------------------------------------------------------

        WindowPart.Transparency = 1

        setAlpha(1)

        ------------------------------------------------------------
        -- RESTORE PART SIZE FIRST
        ------------------------------------------------------------

        if self._savedWorldSize then

            WindowPart.Size =
                self._savedWorldSize

            self._savedWorldSize =
                nil

        else

            WindowPart.Size =
                getNormalSize()
        end

        ------------------------------------------------------------
        -- RESET MAIN POSITION
        ------------------------------------------------------------

        Main.Position =
            UDim2.fromScale(
                0,
                0
            )

        ------------------------------------------------------------
        -- POSITION WHILE INVISIBLE
        ------------------------------------------------------------

        local target =
            getFollowCFrame()

        if target then

            WindowPart.CFrame =
                target
        end

        ------------------------------------------------------------
        -- NOW FREEZE IN WORLD
        ------------------------------------------------------------

        self.Visible = true

        ------------------------------------------------------------
        -- OPEN ANIMATION
        ------------------------------------------------------------

        if self.CloseAnimation == "Fade" then

            for i = 20, 0, -1 do

                local alpha =
                    i / 20

                WindowPart.Transparency =
                    alpha

                setAlpha(alpha)

                task.wait(
                    self.FadeDuration / 20
                )

            end

        elseif self.CloseAnimation == "SlideDown" then

            -- Closed state is above.
            -- Open state moves into its normal location.

            Main.Position =
                UDim2.fromScale(
                    0,
                    -1
                )

            for i = 20, 0, -1 do

                local alpha =
                    i / 20

                Main.Position =
                    UDim2.fromScale(
                        0,
                        -alpha
                    )

                WindowPart.Transparency =
                    alpha

                setAlpha(alpha)

                task.wait(
                    self.FadeDuration / 20
                )

            end

        elseif self.CloseAnimation == "SlideUp" then

            Main.Position =
                UDim2.fromScale(
                    0,
                    1
                )

            for i = 20, 0, -1 do

                local alpha =
                    i / 20

                Main.Position =
                    UDim2.fromScale(
                        0,
                        alpha
                    )

                WindowPart.Transparency =
                    alpha

                setAlpha(alpha)

                task.wait(
                    self.FadeDuration / 20
                )

            end

        elseif self.CloseAnimation == "Collapse"
            or self.CloseAnimation == "Zoom" then

            -- Restore normal size before displaying.
            WindowPart.Size =
                getNormalSize()

            for i = 20, 0, -1 do

                local alpha =
                    i / 20

                local scale =
                    math.max(
                        alpha,
                        0.01
                    )

                WindowPart.Size =
                    Vector3.new(
                        getNormalSize().X * scale,
                        getNormalSize().Y * scale,
                        getNormalSize().Z
                    )

                WindowPart.Transparency =
                    alpha

                setAlpha(alpha)

                task.wait(
                    self.FadeDuration / 20
                )

            end

            WindowPart.Size =
                getNormalSize()
        end

        ------------------------------------------------------------
        -- FINAL
        ------------------------------------------------------------

        Main.Position =
            UDim2.fromScale(
                0,
                0
            )

        WindowPart.Size =
            getNormalSize()

        WindowPart.Transparency =
            0

        setAlpha(0)

        setScrollbarsVisible(true)

        restoreActiveTab()

        self.Animating =
            false

    end

    ----------------------------------------------------------------
    -- HIDE
    ----------------------------------------------------------------

    function self:Hide()

        if self.Destroyed
            or not self.Visible
            or self.Animating then

            return
        end

        self.Animating =
            true

        ActiveSlider =
            nil

        clearTabVisuals()

        setScrollbarsVisible(false)

        ------------------------------------------------------------
        -- FADE
        ------------------------------------------------------------

        if self.CloseAnimation == "Fade" then

            for i = 0, 20 do

                local alpha =
                    i / 20

                WindowPart.Transparency =
                    alpha

                setAlpha(alpha)

                task.wait(
                    self.FadeDuration / 20
                )

            end

        ------------------------------------------------------------
        -- SLIDE DOWN
        ------------------------------------------------------------

        elseif self.CloseAnimation == "SlideDown" then

            for i = 0, 20 do

                local alpha =
                    i / 20

                Main.Position =
                    UDim2.fromScale(
                        0,
                        alpha
                    )

                WindowPart.Transparency =
                    alpha

                setAlpha(alpha)

                task.wait(
                    self.FadeDuration / 20
                )

            end

            Main.Position =
                UDim2.fromScale(
                    0,
                    0
                )

        ------------------------------------------------------------
        -- SLIDE UP
        ------------------------------------------------------------

        elseif self.CloseAnimation == "SlideUp" then

            for i = 0, 20 do

                local alpha =
                    i / 20

                Main.Position =
                    UDim2.fromScale(
                        0,
                        -alpha
                    )

                WindowPart.Transparency =
                    alpha

                setAlpha(alpha)

                task.wait(
                    self.FadeDuration / 20
                )

            end

            Main.Position =
                UDim2.fromScale(
                    0,
                    0
                )

        ------------------------------------------------------------
        -- COLLAPSE
        ------------------------------------------------------------

        elseif self.CloseAnimation == "Collapse"
            or self.CloseAnimation == "Zoom" then

            --------------------------------------------------------
            -- CRITICAL:
            -- ALWAYS SAVE THE NORMAL SIZE.
            -- NEVER SAVE AN ALREADY COLLAPSED SIZE.
            --------------------------------------------------------

            local normalSize =
                getNormalSize()

            self._savedWorldSize =
                normalSize

            --------------------------------------------------------
            -- COLLAPSE
            --------------------------------------------------------

            for i = 0, 20 do

                local alpha =
                    i / 20

                local scale =
                    math.max(
                        1 - alpha,
                        0.01
                    )

                WindowPart.Size =
                    Vector3.new(
                        normalSize.X * scale,
                        normalSize.Y * scale,
                        normalSize.Z
                    )

                WindowPart.Transparency =
                    alpha

                setAlpha(alpha)

                task.wait(
                    self.FadeDuration / 20
                )

            end

        end

        ------------------------------------------------------------
        -- GUARANTEE COMPLETELY HIDDEN
        ------------------------------------------------------------

        WindowPart.Transparency =
            1

        setAlpha(1)

        self.Visible =
            false

        ------------------------------------------------------------
        -- ONLY AFTER DISAPPEARING:
        -- MOVE TO PLAYER
        ------------------------------------------------------------

        local target =
            getFollowCFrame()

        if target then

            WindowPart.CFrame =
                target
        end

        ------------------------------------------------------------
        -- NORMAL POSITION FOR NEXT OPEN
        ------------------------------------------------------------

        Main.Position =
            UDim2.fromScale(
                0,
                0
            )

        self.Animating =
            false

    end

