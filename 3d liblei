function Library.CreateLib(kavName, themeName)

    kavName = kavName or "Windows"

    local theme = getTheme(themeName)

    --------------------------------------------------------
    -- DELETE OLD WINDOW
    --------------------------------------------------------

    local old = workspace:FindFirstChild(kavName)

    if old then
        old:Destroy()
    end

    --------------------------------------------------------
    -- WINDOW PART
    --------------------------------------------------------

    local WindowPart = Instance.new("Part")

    WindowPart.Name = kavName

    WindowPart.Size = Vector3.new(
        10.5,
        6.35,
        0.15
    )

    WindowPart.Anchored = true

    WindowPart.CanCollide = false
    WindowPart.CanTouch = false

    -- IMPORTANT:
    -- mouse raycast needs this to be true
    WindowPart.CanQuery = true

    WindowPart.CastShadow = false

    WindowPart.Material =
        Enum.Material.SmoothPlastic

    WindowPart.Transparency = 1

    WindowPart.Parent = workspace

    --------------------------------------------------------
    -- SURFACE GUI
    --------------------------------------------------------

    local Surface = Instance.new("SurfaceGui")

    Surface.Name = "3DInterface"

    Surface.Face =
        Enum.NormalId.Front

    Surface.AlwaysOnTop = true

    Surface.LightInfluence = 0

    Surface.SizingMode =
        Enum.SurfaceGuiSizingMode.PixelsPerStud

    Surface.PixelsPerStud = 70

    Surface.ClipsDescendants = true

    Surface.Parent = WindowPart

    --------------------------------------------------------
    -- MAIN
    --------------------------------------------------------

    local Main = Instance.new("Frame")

    Main.Name = "Main"

    Main.Size = UDim2.fromScale(1, 1)

    Main.BackgroundColor3 =
        theme.Background

    Main.BorderSizePixel = 0

    Main.Parent = Surface

    addCorner(Main, 7)

    --------------------------------------------------------
    -- HEADER
    --------------------------------------------------------

    local Header = Instance.new("Frame")

    Header.Name = "Header"

    Header.Size =
        UDim2.new(1, 0, 0, 42)

    Header.BackgroundColor3 =
        theme.Header

    Header.BorderSizePixel = 0

    Header.Parent = Main

    addCorner(Header, 7)

    local HeaderCover = Instance.new("Frame")

    HeaderCover.Position =
        UDim2.new(0, 0, 1, -7)

    HeaderCover.Size =
        UDim2.new(1, 0, 0, 7)

    HeaderCover.BackgroundColor3 =
        theme.Header

    HeaderCover.BorderSizePixel = 0

    HeaderCover.Parent = Header

    local Title = Instance.new("TextLabel")

    Title.Name = "Title"

    Title.BackgroundTransparency = 1

    Title.Position =
        UDim2.new(0, 14, 0, 0)

    Title.Size =
        UDim2.new(1, -20, 1, 0)

    Title.Text = kavName

    Title.TextColor3 =
        theme.TextColor

    Title.TextSize = 18

    Title.Font =
        Enum.Font.GothamSemibold

    Title.TextXAlignment =
        Enum.TextXAlignment.Left

    Title.Parent = Header

    --------------------------------------------------------
    -- SIDEBAR
    --------------------------------------------------------

    local Side = Instance.new("Frame")

    Side.Name = "Side"

    Side.Position =
        UDim2.new(0, 0, 0, 42)

    Side.Size =
        UDim2.new(0, 155, 1, -42)

    Side.BackgroundColor3 =
        theme.Header

    Side.BorderSizePixel = 0

    Side.Parent = Main

    addPadding(
        Side,
        5,
        5,
        7,
        5
    )

    local TabList =
        Instance.new("UIListLayout")

    TabList.Padding =
        UDim.new(0, 5)

    TabList.SortOrder =
        Enum.SortOrder.LayoutOrder

    TabList.Parent = Side

    --------------------------------------------------------
    -- PAGES
    --------------------------------------------------------

    local Pages =
        Instance.new("Frame")

    Pages.Name = "Pages"

    Pages.Position =
        UDim2.new(0, 155, 0, 42)

    Pages.Size =
        UDim2.new(1, -155, 1, -42)

    Pages.BackgroundTransparency = 1

    Pages.Parent = Main

    --------------------------------------------------------
    -- LIBRARY STATE
    --------------------------------------------------------

    local self = {}

    self.Part = WindowPart
    self.Surface = Surface
    self.Main = Main
    self.Theme = theme

    self.Visible = false
    self.Animating = false

    self.FadeDuration = 0.25

    self.FollowDistance = 7
    self.FollowHeight = 1.7

    self.SizeMultiplier = 1

    self.ToggleKey =
        Enum.KeyCode.Tab

    self.FollowRotation =
        CFrame.Angles(
            0,
            math.rad(180),
            0
        )

    self.Tabs = {}
    self.Pages = {}

    self.CurrentTab = nil

    self.BaseSize =
        Vector3.new(
            10.5,
            6.35,
            0.15
        )

    --------------------------------------------------------
    -- HITBOX REGISTRY
    --------------------------------------------------------

    local Hitboxes = {}

    local function register(gui, callback)
        Hitboxes[gui] = callback
        return gui
    end

    local function unregister(gui)
        Hitboxes[gui] = nil
    end

    --------------------------------------------------------
    -- RAYCAST PARAMS
    --------------------------------------------------------

    local RaycastParams =
        RaycastParams.new()

    RaycastParams.FilterType =
        Enum.RaycastFilterType.Include

    RaycastParams.FilterDescendantsInstances = {
        WindowPart
    }

    RaycastParams.IgnoreWater = true

    --------------------------------------------------------
    -- GET FOLLOW POSITION
    --------------------------------------------------------

    local function getFollowCFrame()

        local root = getRoot()

        if not root then
            return nil
        end

        return
            root.CFrame
            * CFrame.new(
                0,
                self.FollowHeight,
                -self.FollowDistance
            )
            * self.FollowRotation
    end

    --------------------------------------------------------
    -- REAL 3D MOUSE RAYCAST
    --------------------------------------------------------

    local function getMouseSurfacePosition()

        local camera =
            getCamera()

        if not camera then
            return nil
        end

        local mousePosition =
            UserInputService:GetMouseLocation()

        local ray =
            camera:ViewportPointToRay(
                mousePosition.X,
                mousePosition.Y
            )

        local result =
            workspace:Raycast(
                ray.Origin,
                ray.Direction * 1000,
                RaycastParams
            )

        if not result then
            return nil
        end

        if result.Instance ~= WindowPart then
            return nil
        end

        local localPoint =
            WindowPart.CFrame:PointToObjectSpace(
                result.Position
            )

        local halfX =
            WindowPart.Size.X / 2

        local halfY =
            WindowPart.Size.Y / 2

        local normalizedX =
            (localPoint.X + halfX)
            / WindowPart.Size.X

        local normalizedY =
            (-localPoint.Y + halfY)
            / WindowPart.Size.Y

        normalizedX =
            math.clamp(
                normalizedX,
                0,
                1
            )

        normalizedY =
            math.clamp(
                normalizedY,
                0,
                1
            )

        return Vector2.new(
            normalizedX * Surface.AbsoluteSize.X,
            normalizedY * Surface.AbsoluteSize.Y
        )
    end

    --------------------------------------------------------
    -- GUI HIT TEST
    --------------------------------------------------------

    local function pointInside(
        gui,
        point
    )

        if not gui.Parent then
            return false
        end

        if not gui.Visible then
            return false
        end

        local position =
            gui.AbsolutePosition

        local size =
            gui.AbsoluteSize

        return
            point.X >= position.X
            and point.X <=
                position.X + size.X
            and point.Y >= position.Y
            and point.Y <=
                position.Y + size.Y
    end

    --------------------------------------------------------
    -- FIND TOPMOST ELEMENT
    --------------------------------------------------------

    local function fireAtPoint(point)

        local selectedGui = nil
        local selectedCallback = nil

        local bestZ = -math.huge

        for gui, callback in pairs(Hitboxes) do

            if gui
                and gui.Parent
                and gui:IsA("GuiObject")
                and gui.Visible then

                if pointInside(
                    gui,
                    point
                ) then

                    local z =
                        gui.ZIndex

                    if z >= bestZ then

                        bestZ = z

                        selectedGui =
                            gui

                        selectedCallback =
                            callback

                    end
                end
            end
        end

        if selectedCallback then
            return selectedCallback(
                point,
                selectedGui
            )
        end
    end

    --------------------------------------------------------
    -- GLOBAL RIGHT CLICK
    --------------------------------------------------------

    UserInputService.InputBegan:Connect(
        function(input, processed)

            if processed then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseButton2 then

                return
            end

            if not self.Visible
                or self.Animating then

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            fireAtPoint(point)
        end
    )

    --------------------------------------------------------
    -- ACTIVE SLIDER
    --------------------------------------------------------

    local ActiveSlider = nil

    --------------------------------------------------------
    -- MOUSE MOVE
    --------------------------------------------------------

    UserInputService.InputChanged:Connect(
        function(input)

            if not ActiveSlider then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseMovement then

                return
            end

            if not self.Visible
                or self.Animating then

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            ActiveSlider.Update(
                point.X
            )

        end
    )

    --------------------------------------------------------
    -- MOUSE UP
    --------------------------------------------------------

    UserInputService.InputEnded:Connect(
        function(input)

            if input.UserInputType
                == Enum.UserInputType.MouseButton2 then

                ActiveSlider = nil
            end

        end
    )

    --------------------------------------------------------
    -- SCROLL
    --------------------------------------------------------

    UserInputService.InputChanged:Connect(
        function(input)

            if not self.Visible
                or self.Animating then

                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseWheel then

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            local page =
                self.CurrentTab

            if not page then
                return
            end

            local delta =
                input.Position.Z

            page.CanvasPosition =
                Vector2.new(
                    page.CanvasPosition.X,
                    math.max(
                        0,
                        page.CanvasPosition.Y
                        - delta * 40
                    )
                )

        end
    )

    --------------------------------------------------------
    -- GUI VISUAL ALPHA
    --------------------------------------------------------

    local function setGuiAlpha(
        alpha
    )

        for _, object in ipairs(
            Surface:GetDescendants()
        ) do

            if object:IsA(
                "TextLabel"
            )
            or object:IsA(
                "TextButton"
            )
            or object:IsA(
                "TextBox"
            ) then

                object.TextTransparency =
                    alpha

            elseif object:IsA(
                "ImageLabel"
            )
            or object:IsA(
                "ImageButton"
            ) then

                object.ImageTransparency =
                    alpha
            end

            if object:IsA("GuiObject") then

                local original =
                    object:GetAttribute(
                        "OriginalBackgroundTransparency"
                    )

                if original == nil then

                    original =
                        object.BackgroundTransparency

                    object:SetAttribute(
                        "OriginalBackgroundTransparency",
                        original
                    )

                end

                if original < 1 then

                    object.BackgroundTransparency =
                        original
                        + (
                            1 - original
                        ) * alpha

                end
            end
        end
    end

    --------------------------------------------------------
    -- SHOW
    --------------------------------------------------------

    function self:Show()

        if self.Visible
            or self.Animating then

            return
        end

        self.Animating = true

        ----------------------------------------------------
        -- FIRST:
        -- POSITION WHILE COMPLETELY HIDDEN
        ----------------------------------------------------

        WindowPart.Transparency = 1
        setGuiAlpha(1)

        local target =
            getFollowCFrame()

        if target then
            WindowPart.CFrame =
                target
        end

        ----------------------------------------------------
        -- STOP FOLLOWING BEFORE FADE
        ----------------------------------------------------

        self.Visible = true

        ----------------------------------------------------
        -- FADE IN
        ----------------------------------------------------

        local steps = 20

        for i = steps, 0, -1 do

            local alpha =
                i / steps

            WindowPart.Transparency =
                alpha

            setGuiAlpha(
                alpha
            )

            task.wait(
                self.FadeDuration
                / steps
            )

        end

        WindowPart.Transparency = 0

        setGuiAlpha(0)

        self.Animating = false

    end

    --------------------------------------------------------
    -- HIDE
    --------------------------------------------------------

    function self:Hide()

        if not self.Visible
            or self.Animating then

            return
        end

        self.Animating = true

        ----------------------------------------------------
        -- FADE OUT FIRST
        ----------------------------------------------------

        local steps = 20

        for i = 0, steps do

            local alpha =
                i / steps

            WindowPart.Transparency =
                alpha

            setGuiAlpha(
                alpha
            )

            task.wait(
                self.FadeDuration
                / steps
            )

        end

        ----------------------------------------------------
        -- FULLY INVISIBLE
        ----------------------------------------------------

        WindowPart.Transparency = 1

        setGuiAlpha(1)

        ----------------------------------------------------
        -- ONLY NOW:
        -- HIDDEN STATE
        ----------------------------------------------------

        self.Visible = false

        ----------------------------------------------------
        -- ONLY NOW:
        -- MOVE IT BACK TO PLAYER
        ----------------------------------------------------

        local target =
            getFollowCFrame()

        if target then
            WindowPart.CFrame =
                target
        end

        self.Animating = false

    end

    --------------------------------------------------------
    -- TOGGLE UI
    --------------------------------------------------------

    function self:ToggleUI()

        if self.Animating then
            return
        end

        if self.Visible then
            self:Hide()
        else
            self:Show()
        end

    end

    --------------------------------------------------------
    -- TOGGLE KEY
    --------------------------------------------------------

    function self:SetToggleKey(
        key
    )

        if typeof(key)
            ~= "EnumItem" then

            return false
        end

        if key.EnumType
            ~= Enum.KeyCode then

            return false
        end

        self.ToggleKey =
            key

        return true

    end

    function self:GetToggleKey()
        return self.ToggleKey
    end

    --------------------------------------------------------
    -- GLOBAL TOGGLE LISTENER
    --------------------------------------------------------

    UserInputService.InputBegan:Connect(
        function(
            input,
            processed
        )

            if processed then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.Keyboard then

                return
            end

            if input.KeyCode
                ~= self.ToggleKey then

                return
            end

            self:ToggleUI()

        end
    )

    --------------------------------------------------------
    -- FOLLOW PLAYER WHILE HIDDEN
    --------------------------------------------------------

    RunService.RenderStepped:Connect(
        function()

            if self.Visible
                or self.Animating then

                return
            end

            local target =
                getFollowCFrame()

            if target then
                WindowPart.CFrame =
                    target
            end

        end
    )

    --------------------------------------------------------
    -- WINDOW SIZE
    --------------------------------------------------------

    function self:SetSizeMultiplier(
        value
    )

        value =
            tonumber(value)
            or 1

        value =
            math.clamp(
                value,
                0.5,
                2
            )

        self.SizeMultiplier =
            value

        WindowPart.Size =
            Vector3.new(
                self.BaseSize.X * value,
                self.BaseSize.Y * value,
                self.BaseSize.Z
            )

    end

    function self:GetSizeMultiplier()
        return self.SizeMultiplier
    end

    --------------------------------------------------------
    -- GUI DISTANCE
    --------------------------------------------------------

    function self:SetDistance(
        value
    )

        value =
            tonumber(value)
            or 7

        value =
            math.clamp(
                value,
                2,
                20
            )

        self.FollowDistance =
            value

    end

    function self:GetDistance()
        return self.FollowDistance
    end

    --------------------------------------------------------
    -- GUI HEIGHT
    --------------------------------------------------------

    function self:SetHeight(
        value
    )

        value =
            tonumber(value)
            or 1.7

        value =
            math.clamp(
                value,
                -4,
                6
            )

        self.FollowHeight =
            value

    end

    function self:GetHeight()
        return self.FollowHeight
    end

    --------------------------------------------------------
    -- FADE DURATION
    --------------------------------------------------------

    function self:SetFadeDuration(
        value
    )

        value =
            tonumber(value)
            or 0.25

        value =
            math.clamp(
                value,
                0.05,
                3
            )

        self.FadeDuration =
            value

    end

    function self:GetFadeDuration()
        return self.FadeDuration
    end

    --------------------------------------------------------
