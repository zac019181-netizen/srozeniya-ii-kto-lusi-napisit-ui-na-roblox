                Label.TextSize =
                    13

                Label.Font =
                    Enum.Font.Gotham

                Label.TextXAlignment =
                    Enum.TextXAlignment.Left

                Label.Parent =
                    Picker

                Label.ZIndex =
                    21

                local Preview =
                    Instance.new(
                        "Frame"
                    )

                Preview.Size =
                    UDim2.new(
                        0,
                        27,
                        0,
                        21
                    )

                Preview.Position =
                    UDim2.new(
                        1,
                        -37,
                        0.5,
                        -10
                    )

                Preview.BackgroundColor3 =
                    CurrentColor

                Preview.Parent =
                    Picker

                Preview.ZIndex =
                    22

                corner(
                    Preview,
                    4
                )

                register(
                    Picker,
                    function()

                        local h, s, v =
                            Color3.toHSV(
                                CurrentColor
                            )

                        h =
                            (h + 0.1)
                            % 1

                        CurrentColor =
                            Color3.fromHSV(
                                h,
                                s,
                                v
                            )

                        Preview.BackgroundColor3 =
                            CurrentColor

                        safeCall(
                            callback,
                            CurrentColor
                        )

                    end
                )

                local Object = {
                    Instance =
                        Picker
                }

                function Object:Set(
                    color
                )

                    if typeof(color)
                        ~= "Color3" then

                        return false
                    end

                    CurrentColor =
                        color

                    Preview.BackgroundColor3 =
                        color

                    safeCall(
                        callback,
                        color
                    )

                    return true

                end

                function Object:Get()

                    return CurrentColor

                end

                return Object

            end

