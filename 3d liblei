                == Enum.UserInputType.MouseButton2 then

                ActiveSlider =
                    nil

            end

        end
    )

    ----------------------------------------------------------------
    -- MOUSE WHEEL
    ----------------------------------------------------------------

    connect(
        UserInputService.InputChanged,
        function(input)

            if self.Destroyed
                or not self.Visible
                or self.Animating then

                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseWheel then

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            local page =
                self.CurrentTab

            if not page
                or not page:IsA(
                    "ScrollingFrame"
                ) then

                return
            end

            if not isVisibleThroughParents(
                page
            ) then

                return
            end

            local delta =
                input.Position.Z

            page.CanvasPosition =
                Vector2.new(
                    page.CanvasPosition.X,
                    math.max(
                        0,
                        page.CanvasPosition.Y
                        - delta * 45
                    )
                )

        end
    )

    ----------------------------------------------------------------
    -- TAB HOVER
    ----------------------------------------------------------------

    connect(
        RunService.RenderStepped,
        function()

            if self.Destroyed
                or not self.Visible
                or self.Animating then

                if self.HoveredTab
                    and self.HoveredTab.Parent then

                    self.HoveredTab.BackgroundTransparency =
                        1

                end

                self.HoveredTab =
                    nil

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then

                if self.HoveredTab
                    and self.HoveredTab
                        ~= (
                            self.ActiveTab
                            and self.ActiveTab.Button
                        ) then

                    self.HoveredTab.BackgroundTransparency =
                        1

                end

                self.HoveredTab =
                    nil

                return
            end

            local hovered = nil

            for _, tab in ipairs(
                self.Tabs
            ) do

                if pointInsideVisibleParents(
                    tab.Button,
                    point
                ) then

                    hovered =
                        tab.Button

                    break

                end

            end

            if hovered
                ~= self.HoveredTab then

                if self.HoveredTab
                    and self.HoveredTab.Parent
                    and self.HoveredTab
                        ~= (
                            self.ActiveTab
                            and self.ActiveTab.Button
                        ) then

                    self.HoveredTab.BackgroundTransparency =
                        1

                end

                self.HoveredTab =
                    hovered

                if hovered
                    and hovered
                        ~= (
                            self.ActiveTab
                            and self.ActiveTab.Button
                        ) then

                    hovered.BackgroundTransparency =
                        0.75

                end

            end

        end
    )

