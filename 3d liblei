        self.FollowHeight =
            math.clamp(
                value,
                -4,
                5
            )

    end

    function self:GetHeight()
        return self.FollowHeight
    end

    function self:SetSizeMultiplier(
        value
    )

        value =
            tonumber(value)
            or 1

        value =
            math.clamp(
                value,
                0.5,
                2
            )

        self.SizeMultiplier =
            value

        --------------------------------------------------------
        -- Don't change an active world GUI.
        -- It will use this size next time it moves.
        --------------------------------------------------------

        if not self.Visible
            and not self.Animating then

            WindowPart.Size =
                Vector3.new(
                    self.BaseSize.X
                        * value,

                    self.BaseSize.Y
                        * value,

                    self.BaseSize.Z
                )

        end

    end

    function self:GetSizeMultiplier()
        return self.SizeMultiplier
    end

    function self:SetFadeDuration(
        value
    )

        value =
            tonumber(value)
            or 0.25

        self.FadeDuration =
            math.clamp(
                value,
                0.05,
                3
            )

    end

    function self:GetFadeDuration()
        return self.FadeDuration
    end

    function self:SetCloseAnimation(
        name
    )

        name =
            tostring(name)

        if name == "Fade"
            or name == "SlideDown"
            or name == "Collapse" then

            self.CloseAnimation =
                name

            return true

        end

        return false

    end

    function self:GetCloseAnimation()
        return self.CloseAnimation
    end

