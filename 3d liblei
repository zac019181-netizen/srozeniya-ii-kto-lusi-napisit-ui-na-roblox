            function Elements:NewKeybind(
                name,
                tip,
                default,
                callback
            )

                local CurrentKey =
                    default
                    or Enum.KeyCode.Unknown

                callback =
                    callback or function() end

                local Waiting = false

                local Connection = nil

                local Keybind =
                    Instance.new(
                        "TextLabel"
                    )

                Keybind.Name =
                    name or "Keybind"

                Keybind.Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        38
                    )

                Keybind.BackgroundColor3 =
                    theme.ElementColor

                Keybind.TextColor3 =
                    theme.TextColor

                Keybind.TextSize = 13

                Keybind.Font =
                    Enum.Font.Gotham

                Keybind.Parent =
                    Container

                Keybind.ZIndex = 5

                addCorner(
                    Keybind,
                    5
                )

                local function updateText()

                    Keybind.Text =
                        tostring(
                            name or "Keybind"
                        )
                        .. " ["
                        .. CurrentKey.Name
                        .. "]"

                end

                updateText()

                local function beginBind()

                    if Waiting then
                        return
                    end

                    Waiting = true

                    Keybind.Text =
                        tostring(
                            name or "Keybind"
                        )
                        .. " [PRESS KEY]"

                    if Connection then
                        Connection:Disconnect()
                    end

                    Connection =
                        UserInputService.InputBegan:Connect(
                            function(
                                input,
                                processed
                            )

                                if processed then
                                    return
                                end

                                if input.UserInputType
                                    ~= Enum.UserInputType.Keyboard then

                                    return
                                end

                                CurrentKey =
                                    input.KeyCode

                                Waiting = false

                                updateText()

                                if Connection then
                                    Connection:Disconnect()
                                    Connection = nil
                                end

                                safeCallback(
                                    callback,
                                    CurrentKey
                                )

                            end
                        )
                end

                register(
                    Keybind,
                    function()
                        beginBind()
                    end
                )

                local Object = {
                    Instance = Keybind
                }

                function Object:Set(
                    key
                )

                    if typeof(key)
                        ~= "EnumItem" then

                        return
                    end

                    if key.EnumType
                        ~= Enum.KeyCode then

                        return
                    end

                    CurrentKey =
                        key

                    updateText()

                    safeCallback(
                        callback,
                        CurrentKey
                    )

                end

                function Object:Get()
                    return CurrentKey
                end

                return Object

            end

