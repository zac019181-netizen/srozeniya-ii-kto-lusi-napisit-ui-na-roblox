    -- doesn't cover the center of the window.
    self.FollowHeight = 0.7

    self.SizeMultiplier = 1

    self.ToggleKey =
        Enum.KeyCode.Tab

    self.CloseAnimation =
        "Fade"

    self.BaseSize =
        Vector3.new(
            10.5,
            6.35,
            0.15
        )

    self.Tabs = {}

    self.CurrentTab = nil

    self.ActiveTabButton = nil

    self.HoveredTabButton = nil

    ------------------------------------------------------------
    -- HITBOX REGISTRY
    ------------------------------------------------------------

    local Hitboxes = {}

    local function register(gui, callback)
        Hitboxes[gui] =
            callback

        return gui
    end

    ------------------------------------------------------------
    -- RAYCAST PARAMS
    ------------------------------------------------------------
    -- Use an actual RaycastParams object.
    -- Do not use a dictionary/table here.

    local rayParams =
        RaycastParams.new()

    rayParams.FilterType =
        Enum.RaycastFilterType.Include

    rayParams.FilterDescendantsInstances = {
        WindowPart
    }

    rayParams.IgnoreWater = true

    ------------------------------------------------------------
    -- FOLLOW CFRAME
    ------------------------------------------------------------

    local function getFollowCFrame()

        local root =
            getRoot()

        if not root then
            return nil
        end

        return
            root.CFrame
            * CFrame.new(
                0,
                self.FollowHeight,
                -self.FollowDistance
            )
            * CFrame.Angles(
                0,
                math.rad(180),
                0
            )

    end

    ------------------------------------------------------------
    -- MOUSE -> 3D SURFACE
    ------------------------------------------------------------

    local function getMouseSurfacePosition()

        local camera =
            workspace.CurrentCamera

        if not camera then
            return nil
        end

        local mousePosition =
            UserInputService:GetMouseLocation()

        local ray =
            camera:ViewportPointToRay(
                mousePosition.X,
                mousePosition.Y
            )

        local result =
            workspace:Raycast(
                ray.Origin,
                ray.Direction * 1000,
                rayParams
            )

        if not result then
            return nil
        end

        if result.Instance
            ~= WindowPart then

            return nil
        end

        local localPoint =
            WindowPart.CFrame
            :PointToObjectSpace(
                result.Position
            )

        local halfX =
            WindowPart.Size.X / 2

        local halfY =
            WindowPart.Size.Y / 2

        local x =
            (
                localPoint.X
                + halfX
            )
            / WindowPart.Size.X

        local y =
            (
                -localPoint.Y
                + halfY
            )
            / WindowPart.Size.Y

        --------------------------------------------------------
        -- MIRROR X
        --------------------------------------------------------

        x =
            1 - x

        x =
            math.clamp(
                x,
                0,
                1
            )

        y =
            math.clamp(
                y,
                0,
                1
            )

        return Vector2.new(
            x * Surface.AbsoluteSize.X,
            y * Surface.AbsoluteSize.Y
        )

    end

    ------------------------------------------------------------
    -- VISIBILITY
    ------------------------------------------------------------

    local function isActuallyVisible(gui)

        local current =
            gui

        while current
            and current ~= Surface do

            if current:IsA("GuiObject") then

                if not current.Visible then
                    return false
                end

            end

            current =
                current.Parent

        end

        return true
    end

    ------------------------------------------------------------
    -- POINT INSIDE
    ------------------------------------------------------------

    local function pointInside(
        gui,
        point
    )

        if not gui.Parent then
            return false
        end

        if not isActuallyVisible(
            gui
        ) then
            return false
        end

        local pos =
            gui.AbsolutePosition

        local size =
            gui.AbsoluteSize

        return
            point.X >= pos.X
            and point.X <=
                pos.X + size.X
            and point.Y >= pos.Y
            and point.Y <=
                pos.Y + size.Y

    end

    ------------------------------------------------------------
    -- FIND TOPMOST
    ------------------------------------------------------------

    local function findGuiAtPoint(
        point
    )

        local selected =
            nil

        local selectedCallback =
            nil

        local bestZ =
            -math.huge

        for gui, callback in pairs(
            Hitboxes
        ) do

            if gui
                and gui.Parent
                and gui:IsA("GuiObject")
                and pointInside(
                    gui,
                    point
                ) then

                local z =
                    gui.ZIndex

                if z >= bestZ then

                    bestZ = z

                    selected =
                        gui

                    selectedCallback =
                        callback

                end

            end

        end

        return selected,
            selectedCallback

    end

    ------------------------------------------------------------
    -- CLICK
    ------------------------------------------------------------

    local ActiveSlider =
        nil

    UserInputService.InputBegan:Connect(
        function(
            input,
            processed
        )

            if processed then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseButton2 then

                return
            end

            if not self.Visible
                or self.Animating then

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            local gui, callback =
                findGuiAtPoint(
                    point
                )

            if callback then

                callback(
                    point,
                    gui
                )

            end

        end
    )

    ------------------------------------------------------------
    -- SLIDER MOVE
    ------------------------------------------------------------

    UserInputService.InputChanged:Connect(
        function(
            input
        )

            if not ActiveSlider then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseMovement then

                return
            end

            if not self.Visible then

                ActiveSlider =
                    nil

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            ActiveSlider.Update(
                point.X
            )

        end
    )

    ------------------------------------------------------------
    -- SLIDER RELEASE
    ------------------------------------------------------------

    UserInputService.InputEnded:Connect(
        function(
            input
        )

            if input.UserInputType
                == Enum.UserInputType.MouseButton2 then

                ActiveSlider =
                    nil

            end

        end
    )

    ------------------------------------------------------------
    -- WHEEL
    ------------------------------------------------------------

    UserInputService.InputChanged:Connect(
        function(
            input
        )

            if not self.Visible
                or self.Animating then

                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseWheel then

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            local page =
                self.CurrentTab

            if not page then
                return
            end

            local delta =
                input.Position.Z

            page.CanvasPosition =
                Vector2.new(
                    page.CanvasPosition.X,
                    math.max(
                        0,
                        page.CanvasPosition.Y
                        - delta * 45
                    )
                )

        end
    )

    ------------------------------------------------------------
    -- HOVER
    ------------------------------------------------------------

    RunService.RenderStepped:Connect(
        function()

            if not self.Visible
                or self.Animating then

                if self.HoveredTabButton then

                    self.HoveredTabButton.BackgroundTransparency =
                        1

                    self.HoveredTabButton =
                        nil

                end

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then

                if self.HoveredTabButton
                    and self.HoveredTabButton
                        ~= self.ActiveTabButton then

                    self.HoveredTabButton.BackgroundTransparency =
                        1

                end

                self.HoveredTabButton =
                    nil

                return
            end

            local hoveredTab =
                nil

            for _, tab in ipairs(
                self.Tabs
            ) do

                if tab.Button
                    and pointInside(
                        tab.Button,
                        point
                    ) then

                    hoveredTab =
                        tab.Button

                    break

                end

            end

            if hoveredTab
                ~= self.HoveredTabButton then

                if self.HoveredTabButton
                    and self.HoveredTabButton.Parent
                    and self.HoveredTabButton
                        ~= self.ActiveTabButton then

                    self.HoveredTabButton.BackgroundTransparency =
                        1

                end

                self.HoveredTabButton =
                    hoveredTab

                if self.HoveredTabButton
                    and self.HoveredTabButton
                        ~= self.ActiveTabButton then

                    self.HoveredTabButton.BackgroundTransparency =
                        0.75

                end

            end

        end
    )

    ------------------------------------------------------------
    -- ALPHA
    ------------------------------------------------------------

    local function setAlpha(
        alpha
    )

        alpha =
            math.clamp(
                alpha,
                0,
                1
            )

        for _, object in ipairs(
            Surface:GetDescendants()
        ) do

            if object:IsA("GuiObject") then

                local originalBG =
                    object:GetAttribute(
                        "OriginalBG"
                    )

                if originalBG == nil then

                    originalBG =
                        object.BackgroundTransparency

                    object:SetAttribute(
                        "OriginalBG",
                        originalBG
                    )

                end

                if originalBG < 1 then

                    object.BackgroundTransparency =
                        originalBG
                        + (
                            1 - originalBG
                        ) * alpha

                end

            end

            if object:IsA(
                "TextLabel"
            )
            or object:IsA(
                "TextButton"
            )
            or object:IsA(
                "TextBox"
            ) then

                if object:GetAttribute(
                    "OriginalText"
                ) == nil then

                    object:SetAttribute(
                        "OriginalText",
                        object.TextTransparency
                    )

                end

                local original =
                    object:GetAttribute(
                        "OriginalText"
                    )

                object.TextTransparency =
                    original
                    + (
                        1 - original
                    ) * alpha

            elseif object:IsA(
                "ImageLabel"
            )
            or object:IsA(
                "ImageButton"
            ) then

                if object:GetAttribute(
                    "OriginalImage"
                ) == nil then

                    object:SetAttribute(
                        "OriginalImage",
                        object.ImageTransparency
                    )

                end

                local original =
                    object:GetAttribute(
                        "OriginalImage"
                    )

                object.ImageTransparency =
                    original
                    + (
                        1 - original
                    ) * alpha

            end

        end

    end

    ------------------------------------------------------------
    -- RESET TAB VISUALS
    ------------------------------------------------------------

    local function resetTabVisuals()

        self.HoveredTabButton =
            nil

        for _, tab in ipairs(
            self.Tabs
        ) do

            if tab.Button
                and tab.Button.Parent then

                tab.Button.BackgroundTransparency =
                    1

            end

        end

    end

    ------------------------------------------------------------
    -- RESTORE ACTIVE TAB
    ------------------------------------------------------------

    local function restoreActiveTab()

        if self.ActiveTabButton
            and self.ActiveTabButton.Parent then

            self.ActiveTabButton.BackgroundTransparency =
                0

        end

    end

    ------------------------------------------------------------
    -- SLIDE DOWN HIDE
    ------------------------------------------------------------

    local function slideDownHide()

        local originalPosition =
            Main.Position

        local targetPosition =
            UDim2.new(
                originalPosition.X.Scale,
                originalPosition.X.Offset,
                originalPosition.Y.Scale + 1,
                originalPosition.Y.Offset
            )

        local t =
            tween(
                Main,
                self.FadeDuration,
                {
                    Position =
                        targetPosition
                }
            )

        tween(
            WindowPart,
            self.FadeDuration,
            {
                Transparency = 1
            }
        )

        tween(
            Surface,
            self.FadeDuration,
            {
                ZOffset = -2
            }
        )

        t.Completed:Wait()

        Main.Position =
            originalPosition

        WindowPart.Transparency =
            1

        setAlpha(
            1
        )

        Surface.ZOffset =
            0
    end

    ------------------------------------------------------------
    -- COLLAPSE HIDE
    ------------------------------------------------------------

    local function collapseHide()

        local savedSize =
            WindowPart.Size

        self._SavedCollapseSize =
            savedSize

        local startSize =
            WindowPart.Size

        local targetSize =
            Vector3.new(
                0.01,
                0.01,
                startSize.Z
            )

        local partTween =
            tween(
                WindowPart,
                self.FadeDuration,
                {
                    Size =
                        targetSize,
                    Transparency =
                        1
                }
            )

        setAlpha(
            0
        )

        task.wait(
            self.FadeDuration
        )

        WindowPart.Size =
            Vector3.new(
                0.01,
                0.01,
                startSize.Z
            )

        WindowPart.Transparency =
            1

        setAlpha(
            1
        )
    end

    ------------------------------------------------------------
    -- SHOW
    ------------------------------------------------------------

    function self:Show()

        if self.Visible
            or self.Animating then

            return
        end

        self.Animating =
            true

        --------------------------------------------------------
        -- Completely hidden first
        --------------------------------------------------------

        WindowPart.Transparency =
            1

        setAlpha(
            1
        )

        --------------------------------------------------------
        -- Restore collapsed size BEFORE moving
        --------------------------------------------------------

        if self._SavedCollapseSize then

            WindowPart.Size =
                self._SavedCollapseSize

        else

            WindowPart.Size =
                Vector3.new(
                    self.BaseSize.X
                        * self.SizeMultiplier,

                    self.BaseSize.Y
                        * self.SizeMultiplier,

                    self.BaseSize.Z
                )

        end

        --------------------------------------------------------
        -- Position while invisible
        --------------------------------------------------------

        local target =
            getFollowCFrame()

        if target then
            WindowPart.CFrame =
                target
        end

        --------------------------------------------------------
        -- Reset UI position
        --------------------------------------------------------

        Main.Position =
            UDim2.fromScale(
                0,
                0
            )

        Surface.ZOffset =
            0

        --------------------------------------------------------
        -- Freeze in world
        --------------------------------------------------------

        self.Visible =
            true

        --------------------------------------------------------
        -- Fade in
        --------------------------------------------------------

        local steps = 20

        for i = steps, 0, -1 do

            local alpha =
                i / steps

            WindowPart.Transparency =
                alpha

            setAlpha(
                alpha
            )

            task.wait(
                self.FadeDuration
                / steps
            )

        end

        WindowPart.Transparency =
            0

        setAlpha(
            0
        )

        restoreActiveTab()

        self.Animating =
            false

    end

    ------------------------------------------------------------
    -- HIDE
    ------------------------------------------------------------

    function self:Hide()

        if not self.Visible
            or self.Animating then

            return
        end

        self.Animating =
            true

        --------------------------------------------------------
        -- Make tab hover disappear immediately
        --------------------------------------------------------

        resetTabVisuals()

        --------------------------------------------------------
        -- CLOSE ANIMATION
        --------------------------------------------------------

        if self.CloseAnimation
            == "Fade" then

            local steps = 20

            for i = 0, steps do

                local alpha =
                    i / steps

                WindowPart.Transparency =
                    alpha

                setAlpha(
                    alpha
                )

                task.wait(
                    self.FadeDuration
                    / steps
                )

            end

        elseif self.CloseAnimation
            == "SlideDown" then

            slideDownHide()

        elseif self.CloseAnimation
            == "Collapse" then

            collapseHide()

        end

        --------------------------------------------------------
        -- GUARANTEE FULLY HIDDEN
        --------------------------------------------------------

        WindowPart.Transparency =
            1

        setAlpha(
            1
        )

        --------------------------------------------------------
        -- NOW HIDDEN
        --------------------------------------------------------

        self.Visible =
            false

        --------------------------------------------------------
        -- NOW MOVE TO PLAYER
        --------------------------------------------------------

        local target =
            getFollowCFrame()

        if target then

            WindowPart.CFrame =
                target

        end

        --------------------------------------------------------
        -- Reset size after non-collapse animations
        --------------------------------------------------------

        if self.CloseAnimation
            ~= "Collapse" then

            WindowPart.Size =
                Vector3.new(
                    self.BaseSize.X
                        * self.SizeMultiplier,

                    self.BaseSize.Y
                        * self.SizeMultiplier,

                    self.BaseSize.Z
                )

        end

        Main.Position =
            UDim2.fromScale(
                0,
                0
            )

        Surface.ZOffset =
            0

        self.Animating =
            false

    end

    ------------------------------------------------------------
    -- TOGGLE
    ------------------------------------------------------------

    function self:ToggleUI()

        if self.Animating then
            return
        end

        if self.Visible then
            self:Hide()
        else
            self:Show()
        end

    end

    ------------------------------------------------------------
    -- TOGGLE KEY
    ------------------------------------------------------------

    function self:SetToggleKey(
        key
    )

        if typeof(key)
            ~= "EnumItem" then

            return false
        end

        if key.EnumType
            ~= Enum.KeyCode then

            return false
        end

        self.ToggleKey =
            key

        return true

    end

    function self:GetToggleKey()

        return self.ToggleKey

    end

    ------------------------------------------------------------
    -- TOGGLE KEY INPUT
    ------------------------------------------------------------

    UserInputService.InputBegan:Connect(
        function(
            input,
            processed
        )

            if processed then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.Keyboard then

                return
            end

            if input.KeyCode
                == self.ToggleKey then

                self:ToggleUI()

            end

        end
    )

