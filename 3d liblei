                                S,
                                V
                            )
                        end
                    )

                local Val =
                    makeColorSlider(
                        "V",
                        V,
                        73,
                        function(value)
                            V = value

                            applyHSV(
                                H,
                                S,
                                V
                            )
                        end
                    )

                register(
                    Picker,
                    function()

                        Opened =
                            not Opened

                        Popup.Visible =
                            Opened

                    end
                )

                local Object = {
                    Instance = Picker
                }

                function Object:Set(
                    color
                )

                    if typeof(color)
                        ~= "Color3" then

                        return
                    end

                    CurrentColor =
                        color

                    H, S, V =
                        Color3.toHSV(
                            color
                        )

                    Preview.BackgroundColor3 =
                        color

                    safeCallback(
                        callback,
                        color
                    )

                end

                function Object:Get()
                    return CurrentColor
                end

                return Object

            end

            return Elements

