        UserInputService.InputBegan,
        function(
            input,
            processed
        )

            if processed then
                return
            end

            if self.Destroyed then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.Keyboard then

                return
            end

            if input.KeyCode
                == self.ToggleKey then

                self:ToggleUI()

            end

        end
    )

