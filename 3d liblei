    ------------------------------------------------------------
    -- STATE
    ------------------------------------------------------------

    local self = {}

    self.Part = WindowPart

    self.Surface = Surface

    self.Main = Main

    self.Theme = theme

    self.Visible = false

    self.Animating = false

    self.FadeDuration = 0.25

    self.SizeMultiplier = 1

    self.FollowOffset =
        CFrame.new(0, 1.7, -7)

    self.ToggleKey =
        Enum.KeyCode.Tab

    self.Tabs = {}

    self.CurrentTab = nil

    self.Pages = {}

    self.BaseSize =
        Vector3.new(10.5, 6.35, 0.15)

    ------------------------------------------------------------
    -- HITBOX SYSTEM
    ------------------------------------------------------------

    local Hitboxes = {}

    local function register(gui, callback)
        Hitboxes[gui] = callback
        return gui
    end

    local function unregister(gui)
        Hitboxes[gui] = nil
    end

    ------------------------------------------------------------
    -- GUI TRANSPARENCY
    ------------------------------------------------------------

    local function setGuiTransparency(alpha)

        for _, object in ipairs(
            Surface:GetDescendants()
        ) do

            if object:IsA("TextLabel")
                or object:IsA("TextButton")
                or object:IsA("TextBox") then

                object.TextTransparency = alpha

            elseif object:IsA("ImageLabel")
                or object:IsA("ImageButton") then

                object.ImageTransparency = alpha

            end

            if object:IsA("GuiObject") then

                if object:GetAttribute(
                    "OriginalBackgroundTransparency"
                ) == nil then

                    object:SetAttribute(
                        "OriginalBackgroundTransparency",
                        object.BackgroundTransparency
                    )
                end

                local original =
                    object:GetAttribute(
                        "OriginalBackgroundTransparency"
                    )

                if original ~= nil
                    and original < 1 then

                    object.BackgroundTransparency =
                        original +
                        ((1 - original) * alpha)
                end
            end
        end
    end

    ------------------------------------------------------------
    -- WINDOW SIZE
    ------------------------------------------------------------

    function self:SetSizeMultiplier(value)

        value = tonumber(value) or 1

        value = math.clamp(
            value,
            0.5,
            2
        )

        self.SizeMultiplier = value

        WindowPart.Size =
            Vector3.new(
                self.BaseSize.X * value,
                self.BaseSize.Y * value,
                self.BaseSize.Z
            )

    end

    function self:GetSizeMultiplier()
        return self.SizeMultiplier
    end

    ------------------------------------------------------------
    -- FADE SPEED
    ------------------------------------------------------------

    function self:SetFadeDuration(value)

        value = tonumber(value) or 0.25

        value = math.clamp(
            value,
            0.05,
            2
        )

        self.FadeDuration = value

    end

    function self:GetFadeDuration()
        return self.FadeDuration
    end

    ------------------------------------------------------------
    -- SURFACE POSITION
    ------------------------------------------------------------

    local function getMouseSurfacePosition()
    
        local camera = workspace.CurrentCamera
    
        if not camera then
            return nil
        end
    
        local mousePosition =
            UserInputService:GetMouseLocation()
    
        local ray =
            camera:ViewportPointToRay(
                mousePosition.X,
                mousePosition.Y
            )
    
        local result =
            workspace:Raycast(
                ray.Origin,
                ray.Direction * 1000,
                RaycastParams
            )
    
        if not result then
            return nil
        end
    
        if result.Instance ~= WindowPart then
            return nil
        end
    
        local localPoint =
            WindowPart.CFrame:PointToObjectSpace(
                result.Position
            )
    
        local halfX =
            WindowPart.Size.X / 2
    
        local halfY =
            WindowPart.Size.Y / 2
    
        local normalizedX =
            (localPoint.X + halfX)
            / WindowPart.Size.X
    
        local normalizedY =
            (-localPoint.Y + halfY)
            / WindowPart.Size.Y
    
        ------------------------------------------------
        -- MIRROR X
        ------------------------------------------------
    
        normalizedX =
            1 - normalizedX
    
        ------------------------------------------------
        -- LIMIT
        ------------------------------------------------
    
        normalizedX =
            math.clamp(
                normalizedX,
                0,
                1
            )
    
        normalizedY =
            math.clamp(
                normalizedY,
                0,
                1
            )
    
        return Vector2.new(
            normalizedX
                * Surface.AbsoluteSize.X,
    
            normalizedY
                * Surface.AbsoluteSize.Y
        )
    end

    ------------------------------------------------------------
    -- HIT TEST
    ------------------------------------------------------------

    local function pointInside(gui, point)

        if not gui.Visible then
            return false
        end

        local position =
            gui.AbsolutePosition

        local size =
            gui.AbsoluteSize

        return point.X >= position.X
            and point.X <= position.X + size.X
            and point.Y >= position.Y
            and point.Y <= position.Y + size.Y
    end

    local function fireAtPoint(point)

        local bestCallback = nil

        local bestZ = -math.huge

        for gui, callback in pairs(Hitboxes) do

            if gui
                and gui.Parent
                and gui.Visible then

                if pointInside(
                    gui,
                    point
                ) then

                    local z =
                        gui.ZIndex

                    if z >= bestZ then

                        bestZ = z

                        bestCallback =
                            callback

                    end
                end
            end
        end

        if bestCallback then
            return bestCallback(point)
        end
    end

    ------------------------------------------------------------
    -- ACTIVE SLIDER
    ------------------------------------------------------------

    local ActiveSlider = nil

    ------------------------------------------------------------
    -- RIGHT CLICK
    ------------------------------------------------------------

    UserInputService.InputBegan:Connect(
        function(input, processed)

            if processed then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseButton2 then

                return
            end

            if not self.Visible
                or self.Animating then

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            fireAtPoint(point)
        end
    )

    ------------------------------------------------------------
    -- SLIDER DRAG
    ------------------------------------------------------------

    UserInputService.InputChanged:Connect(
        function(input)

            if not ActiveSlider then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseMovement then

                return
            end

            if not self.Visible then
                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            ActiveSlider.Update(point.X)
        end
    )

    UserInputService.InputEnded:Connect(
        function(input)

            if input.UserInputType
                == Enum.UserInputType.MouseButton2 then

                ActiveSlider = nil
            end

        end
    )

    ------------------------------------------------------------
    -- MOUSE WHEEL SCROLL
    ------------------------------------------------------------

    UserInputService.InputChanged:Connect(
        function(input)

            if not self.Visible then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseWheel then

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            local page =
                self.CurrentTab

            if not page
                or not page:IsA("ScrollingFrame") then

                return
            end

            local delta =
                input.Position.Z

            page.CanvasPosition =
                Vector2.new(
                    page.CanvasPosition.X,
                    math.max(
                        0,
                        page.CanvasPosition.Y
                        - delta * 35
                    )
                )
        end
    )

    ------------------------------------------------------------
    -- POSITION BEFORE SHOW
    ------------------------------------------------------------

    local function getFollowCFrame()

        local root = getRoot()

        if not root then
            return nil
        end

        -- 180 degrees around Y:
        -- makes Front face the player
        return root.CFrame
            * self.FollowOffset
            * CFrame.Angles(
                0,
                math.rad(180),
                0
            )
    end

    ------------------------------------------------------------
    -- SHOW
    ------------------------------------------------------------

    function self:Show()

        if self.Visible
            or self.Animating then

            return
        end

        self.Animating = true

        --------------------------------------------------------
        -- FIRST: POSITION WHILE INVISIBLE
        --------------------------------------------------------

        local target =
            getFollowCFrame()

        if target then
            WindowPart.CFrame = target
        end

        --------------------------------------------------------
        -- SECOND: BECOME VISIBLE
        --------------------------------------------------------

        WindowPart.Transparency = 1

        setGuiTransparency(1)

        self.Visible = true

        --------------------------------------------------------
        -- THIRD: FADE IN
        --------------------------------------------------------

        local steps = 20

        for i = steps, 0, -1 do

            if not self.Visible then
                break
            end

            local alpha =
                i / steps

            WindowPart.Transparency =
                alpha

            setGuiTransparency(alpha)

            task.wait(
                self.FadeDuration / steps
            )
        end

        if self.Visible then

            WindowPart.Transparency = 0

            setGuiTransparency(0)
        end

        self.Animating = false
    end

    ------------------------------------------------------------
    -- HIDE
    ------------------------------------------------------------

    function self:Hide()

        if not self.Visible
            or self.Animating then

            return
        end

        self.Animating = true

        --------------------------------------------------------
        -- FIRST: FULLY DISAPPEAR
        --------------------------------------------------------

        local steps = 20

        for i = 0, steps do

            local alpha =
                i / steps

            WindowPart.Transparency =
                alpha

            setGuiTransparency(alpha)

            task.wait(
                self.FadeDuration / steps
            )
        end

        --------------------------------------------------------
        -- IMPORTANT:
        -- ONLY AFTER FULL INVISIBILITY:
        -- MARK HIDDEN AND MOVE IT
        --------------------------------------------------------

        WindowPart.Transparency = 1

        setGuiTransparency(1)

        self.Visible = false

        local target =
            getFollowCFrame()

        if target then
            WindowPart.CFrame = target
        end

        self.Animating = false
    end

    ------------------------------------------------------------
    -- TOGGLE
    ------------------------------------------------------------

    function self:ToggleUI()

        if self.Animating then
            return
        end

        if self.Visible then
            self:Hide()
        else
            self:Show()
        end

    end

    ------------------------------------------------------------
    -- TOGGLE KEY
    ------------------------------------------------------------

    function self:SetToggleKey(key)

        if typeof(key) ~= "EnumItem" then
            return
        end

        if key.EnumType ~= Enum.KeyCode then
            return
        end

        self.ToggleKey = key

    end

    function self:GetToggleKey()
        return self.ToggleKey
    end

    ------------------------------------------------------------
    -- TOGGLE KEY LISTENER
    ------------------------------------------------------------

    UserInputService.InputBegan:Connect(
        function(input, processed)

            if processed then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.Keyboard then

                return
            end

            if input.KeyCode
                ~= self.ToggleKey then

                return
            end

            self:ToggleUI()

        end
    )

    ------------------------------------------------------------
    -- FOLLOW WHEN HIDDEN
    ------------------------------------------------------------

    RunService.RenderStepped:Connect(
        function()

            if self.Visible
                or self.Animating then

                return
            end

            local target =
                getFollowCFrame()

            if target then
                WindowPart.CFrame = target
            end

        end
    )

