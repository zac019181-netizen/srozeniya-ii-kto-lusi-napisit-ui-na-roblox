        self.BaseSize

    self.Tabs = {}

    self.CurrentTab =
        nil

    self.ActiveTab =
        nil

    self.HoveredTab =
        nil

    self.Connections = {}

    self.Tweens = {}

    ------------------------------------------------------------
    -- TRACK CONNECTION
    ------------------------------------------------------------

    local function connect(signal, callback)

        local connection =
            signal:Connect(callback)

        table.insert(
            self.Connections,
            connection
        )

        return connection
    end

    ------------------------------------------------------------
    -- TRACK TWEEN
    ------------------------------------------------------------

    local function trackTween(t)

        if not t then
            return
        end

        table.insert(
            self.Tweens,
            t
        )

        t.Completed:Connect(
            function()
                local index =
                    table.find(
                        self.Tweens,
                        t
                    )

                if index then
                    table.remove(
                        self.Tweens,
                        index
                    )
                end
            end
        )

        return t
    end

    ------------------------------------------------------------
    -- HITBOXES
    ------------------------------------------------------------

    local Hitboxes = {}

    local TabHitboxes = {}

    ------------------------------------------------------------
    -- RAYCAST
    ------------------------------------------------------------

    local rayParams =
        RaycastParams.new()

    rayParams.FilterType =
        Enum.RaycastFilterType.Include

    rayParams.FilterDescendantsInstances = {
        WindowPart
    }

    rayParams.IgnoreWater = true

    ------------------------------------------------------------
    -- FOLLOW POSITION
    ------------------------------------------------------------

    local function getFollowCFrame()

        local root =
            getRoot()

        if not root then
            return nil
        end

        return
            root.CFrame
            * CFrame.new(
                0,
                self.FollowHeight,
                -self.FollowDistance
            )
            * CFrame.Angles(
                0,
                math.rad(180),
                0
            )

    end

    ------------------------------------------------------------
    -- MOUSE POSITION ON PART
    ------------------------------------------------------------

    local function getMouseSurfacePosition()

        if self.Destroyed then
            return nil
        end

        if not self.Visible then
            return nil
        end

        if self.Animating then
            return nil
        end

        local camera =
            workspace.CurrentCamera

        if not camera then
            return nil
        end

        local mouse =
            UserInputService:GetMouseLocation()

        local ray =
            camera:ViewportPointToRay(
                mouse.X,
                mouse.Y
            )

        local result =
            workspace:Raycast(
                ray.Origin,
                ray.Direction * 1000,
                rayParams
            )

        if not result then
            return nil
        end

        if result.Instance
            ~= WindowPart then

            return nil
        end

        local localPoint =
            WindowPart.CFrame
            :PointToObjectSpace(
                result.Position
            )

        local halfX =
            WindowPart.Size.X / 2

        local halfY =
            WindowPart.Size.Y / 2

        local x =
            (
                localPoint.X +
                halfX
            )
            / WindowPart.Size.X

        local y =
            (
                -localPoint.Y +
                halfY
            )
            / WindowPart.Size.Y

        --------------------------------------------------------
        -- MIRRORED GUI
        --------------------------------------------------------

        x =
            1 - x

        x =
            math.clamp(
                x,
                0,
                1
            )

        y =
            math.clamp(
                y,
                0,
                1
            )

        return Vector2.new(
            x * Surface.AbsoluteSize.X,
            y * Surface.AbsoluteSize.Y
        )

    end

    ------------------------------------------------------------
    -- VISIBILITY CHECK
    ------------------------------------------------------------

    local function isActuallyVisible(gui)

        local current =
            gui

        while current
            and current ~= Surface do

            if current:IsA("GuiObject") then

                if not current.Visible then
                    return false
                end

            end

            current =
                current.Parent

        end

        return true
    end

    ------------------------------------------------------------
    -- POINT INSIDE
    ------------------------------------------------------------

    local function pointInside(
        gui,
        point
    )

        if not gui
            or not gui.Parent then

            return false
        end

        if not isActuallyVisible(
            gui
        ) then

            return false
        end

        local position =
            gui.AbsolutePosition

        local size =
            gui.AbsoluteSize

        return
            point.X >= position.X
            and point.X <=
                position.X + size.X
            and point.Y >= position.Y
            and point.Y <=
                position.Y + size.Y

    end

    ------------------------------------------------------------
    -- GET HIT
    ------------------------------------------------------------

    local function getHit(
        point
    )

        local bestGui =
            nil

        local bestCallback =
            nil

        local bestZ =
            -math.huge

        for gui, callback in pairs(
            Hitboxes
        ) do

            if gui
                and gui.Parent
                and gui:IsA("GuiObject")
                and gui.Visible
                and isActuallyVisible(gui)
                and pointInside(
                    gui,
                    point
                ) then

                local z =
                    gui.ZIndex

                if z >= bestZ then

                    bestZ =
                        z

                    bestGui =
                        gui

                    bestCallback =
                        callback

                end

            end

        end

        return bestGui,
            bestCallback

    end

    ------------------------------------------------------------
    -- RIGHT CLICK
    ------------------------------------------------------------

    connect(
        UserInputService.InputBegan,
        function(
            input,
            processed
        )

            if processed then
                return
            end

            if self.Destroyed then
                return
            end

            if not self.Visible
                or self.Animating then

                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseButton2 then

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            local gui,
                callback =
                getHit(point)

            if callback then

                callback(
                    point,
                    gui
                )

            end

        end
    )

    ------------------------------------------------------------
    -- ACTIVE SLIDER
    ------------------------------------------------------------

    local ActiveSlider =
        nil

    connect(
        UserInputService.InputChanged,
        function(input)

            if not ActiveSlider then
                return
            end

            if self.Destroyed
                or not self.Visible
                or self.Animating then

                ActiveSlider =
                    nil

                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseMovement then

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            ActiveSlider.Update(
                point.X
            )

        end
    )

    connect(
        UserInputService.InputEnded,
        function(input)

            if input.UserInputType
                == Enum.UserInputType.MouseButton2 then

                ActiveSlider =
                    nil

            end

        end
    )

    ------------------------------------------------------------
    -- MOUSE WHEEL
    ------------------------------------------------------------

    connect(
        UserInputService.InputChanged,
        function(input)

            if self.Destroyed
                or not self.Visible
                or self.Animating then

                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseWheel then

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            local page =
                self.CurrentTab

            if not page then
                return
            end

            if not isActuallyVisible(
                page
            ) then

                return
            end

            local delta =
                input.Position.Z

            page.CanvasPosition =
                Vector2.new(
                    page.CanvasPosition.X,
                    math.max(
                        0,
                        page.CanvasPosition.Y
                        - delta * 45
                    )
                )

        end
    )

    ------------------------------------------------------------
    -- ALPHA
    ------------------------------------------------------------

    local function setAlpha(alpha)

        alpha =
            math.clamp(
                alpha,
                0,
                1
            )

        for _, object in ipairs(
            Surface:GetDescendants()
        ) do

            if object:IsA(
                "GuiObject"
            ) then

                local originalBG =
                    object:GetAttribute(
                        "OriginalBG"
                    )

                if originalBG == nil then

                    originalBG =
                        object.BackgroundTransparency

                    object:SetAttribute(
                        "OriginalBG",
                        originalBG
                    )

                end

                if originalBG < 1 then

                    object.BackgroundTransparency =
                        originalBG
                        + (
                            1 -
                            originalBG
                        ) * alpha

                end

            end

            if object:IsA(
                "TextLabel"
            )
            or object:IsA(
                "TextButton"
            )
            or object:IsA(
                "TextBox"
            ) then

                local original =
                    object:GetAttribute(
                        "OriginalText"
                    )

                if original == nil then

                    original =
                        object.TextTransparency

                    object:SetAttribute(
                        "OriginalText",
                        original
                    )

                end

                object.TextTransparency =
                    original
                    + (
                        1 -
                        original
                    ) * alpha

            elseif object:IsA(
                "ImageLabel"
            )
            or object:IsA(
                "ImageButton"
            ) then

                local original =
                    object:GetAttribute(
                        "OriginalImage"
                    )

                if original == nil then

                    original =
                        object.ImageTransparency

                    object:SetAttribute(
                        "OriginalImage",
                        original
                    )

                end

                object.ImageTransparency =
                    original
                    + (
                        1 -
                        original
                    ) * alpha

            end

        end

        --------------------------------------------------------
        -- Scrollbars are explicitly managed
        --------------------------------------------------------

        for _, page in ipairs(
            Pages:GetChildren()
        ) do

            if page:IsA(
                "ScrollingFrame"
            ) then

                page.ScrollBarImageTransparency =
                    (
                        alpha == 0
                        and self.Visible
                        and not self.Animating
                    )
                    and 0
                    or 1

            end

        end

    end

    ------------------------------------------------------------
    -- TAB VISUALS
    ------------------------------------------------------------

    local function resetTabs()

        self.HoveredTab =
            nil

        for _, tab in ipairs(
            self.Tabs
        ) do

            if tab.Button
                and tab.Button.Parent then

                tab.Button.BackgroundTransparency =
                    1

            end

        end

    end

    local function restoreActiveTab()

        if self.ActiveTab
            and self.ActiveTab.Button
            and self.ActiveTab.Button.Parent then

            self.ActiveTab.Button.BackgroundTransparency =
                0

        end

    end

    ------------------------------------------------------------
    -- TAB HOVER
    ------------------------------------------------------------

    connect(
        RunService.RenderStepped,
        function()

            if self.Destroyed then
                return
            end

            if not self.Visible
                or self.Animating then

                resetTabs()

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then

                if self.HoveredTab
                    and self.HoveredTab ~= (
                        self.ActiveTab
                        and self.ActiveTab.Button
                    ) then

                    self.HoveredTab.BackgroundTransparency =
                        1

                end

                self.HoveredTab =
                    nil

                return
            end

            local hovered =
                nil

            for _, tab in ipairs(
                self.Tabs
            ) do

                if pointInside(
                    tab.Button,
                    point
                ) then

                    hovered =
                        tab.Button

                    break

                end

            end

            if hovered
                ~= self.HoveredTab then

                if self.HoveredTab
                    and self.HoveredTab.Parent
                    and self.HoveredTab ~= (
                        self.ActiveTab
                        and self.ActiveTab.Button
                    ) then

                    self.HoveredTab.BackgroundTransparency =
                        1

                end

                self.HoveredTab =
                    hovered

                if hovered
                    and hovered ~= (
                        self.ActiveTab
                        and self.ActiveTab.Button
                    ) then

                    hovered.BackgroundTransparency =
                        0.75

                end

            end

        end
    )

    ------------------------------------------------------------
    -- FOLLOW WHILE HIDDEN
    ------------------------------------------------------------

    connect(
        RunService.RenderStepped,
        function()

            if self.Destroyed then
                return
            end

            if self.Visible
                or self.Animating then

                return
            end

            local target =
                getFollowCFrame()

            if target then

                WindowPart.CFrame =
                    target

            end

        end
    )

    ------------------------------------------------------------
    -- DISTANCE
    ------------------------------------------------------------

    function self:SetDistance(value)

        value =
            tonumber(value)
            or 7

        self.FollowDistance =
            math.clamp(
                value,
                2,
                25
            )

    end

    function self:GetDistance()
        return self.FollowDistance
    end

    ------------------------------------------------------------
    -- HEIGHT
    ------------------------------------------------------------

    function self:SetHeight(value)

        value =
            tonumber(value)
            or 0.7

        self.FollowHeight =
            math.clamp(
                value,
                -4,
                6
            )

    end

    function self:GetHeight()
        return self.FollowHeight
    end

    ------------------------------------------------------------
    -- SIZE
    ------------------------------------------------------------

    function self:SetSizeMultiplier(value)

        value =
            tonumber(value)
            or 1

        value =
            math.clamp(
                value,
                0.5,
                2
            )

        self.SizeMultiplier =
            value

        self.DisplaySize =
            Vector3.new(
                self.BaseSize.X * value,
                self.BaseSize.Y * value,
                self.BaseSize.Z
            )

        if not self.Visible
            and not self.Animating then

            WindowPart.Size =
                self.DisplaySize

        end

    end

    function self:GetSizeMultiplier()
        return self.SizeMultiplier
    end

    ------------------------------------------------------------
    -- FADE SPEED
    ------------------------------------------------------------

    function self:SetFadeDuration(value)

        value =
            tonumber(value)
            or 0.25

        self.FadeDuration =
            math.clamp(
                value,
                0.05,
                3
            )

    end

    function self:GetFadeDuration()
        return self.FadeDuration
    end

    ------------------------------------------------------------
    -- CLOSE ANIMATION
    ------------------------------------------------------------

    function self:SetCloseAnimation(
        animation
    )

        animation =
            tostring(animation)

        local valid = {
            Fade = true,
            SlideDown = true,
            SlideUp = true,
            Collapse = true,
            Zoom = true
        }

        if not valid[animation] then
            return false
        end

        self.CloseAnimation =
            animation

        return true

    end

    function self:GetCloseAnimation()
        return self.CloseAnimation
    end

    ------------------------------------------------------------
    -- TOGGLE KEY
    ------------------------------------------------------------

    function self:SetToggleKey(key)

        if typeof(key) ~= "EnumItem" then
            return false
        end

        if key.EnumType ~= Enum.KeyCode then
            return false
        end

        self.ToggleKey =
            key

        return true

    end

    function self:GetToggleKey()
        return self.ToggleKey
    end

    ------------------------------------------------------------
    -- SHOW
    ------------------------------------------------------------

    function self:Show()

        if self.Destroyed then
            return
        end

        if self.Visible
            or self.Animating then

            return
        end

        self.Animating =
            true

        self.AnimationToken =
            self.AnimationToken + 1

        local token =
            self.AnimationToken

        --------------------------------------------------------
        -- ALWAYS START INVISIBLE
        --------------------------------------------------------

        WindowPart.Transparency =
            1

        setAlpha(
            1
        )

        resetTabs()

        --------------------------------------------------------
        -- ALWAYS RESTORE NORMAL SIZE
        --------------------------------------------------------

        WindowPart.Size =
            self.DisplaySize

        --------------------------------------------------------
        -- RESTORE MAIN POSITION
        --------------------------------------------------------

        Main.Position =
            UDim2.fromScale(
                0,
                0
            )

        --------------------------------------------------------
        -- MOVE WHILE INVISIBLE
        --------------------------------------------------------

        local target =
            getFollowCFrame()

        if target then

            WindowPart.CFrame =
                target

        end

        --------------------------------------------------------
        -- ONLY NOW MARK VISIBLE
        --------------------------------------------------------

        self.Visible =
            true

        --------------------------------------------------------
        -- ANIMATION
        --------------------------------------------------------

        if self.CloseAnimation
            == "Fade" then

            for i = 20, 0, -1 do

                if self.Destroyed
                    or token ~= self.AnimationToken then

                    return
                end

                local alpha =
                    i / 20

                WindowPart.Transparency =
                    alpha

                setAlpha(
                    alpha
                )

                task.wait(
                    self.FadeDuration / 20
                )

            end

        elseif self.CloseAnimation
            == "SlideDown" then

            Main.Position =
                UDim2.fromScale(
                    0,
                    -1
                )

            for i = 20, 0, -1 do

                if self.Destroyed
                    or token ~= self.AnimationToken then

                    return
                end

                local alpha =
                    i / 20

                Main.Position =
                    UDim2.fromScale(
                        0,
                        -alpha
                    )

                WindowPart.Transparency =
                    alpha

                setAlpha(
                    alpha
                )

                task.wait(
                    self.FadeDuration / 20
                )

            end

        elseif self.CloseAnimation
            == "SlideUp" then

            Main.Position =
                UDim2.fromScale(
                    0,
                    1
                )

            for i = 20, 0, -1 do

                if self.Destroyed
                    or token ~= self.AnimationToken then

                    return
                end

                local alpha =
                    i / 20

                Main.Position =
                    UDim2.fromScale(
                        0,
                        alpha
                    )

                WindowPart.Transparency =
                    alpha

                setAlpha(
                    alpha
                )

                task.wait(
                    self.FadeDuration / 20
                )

            end

        elseif self.CloseAnimation
            == "Collapse"
            or self.CloseAnimation
            == "Zoom" then

            local normalSize =
                self.DisplaySize

            WindowPart.Size =
                Vector3.new(
                    0.01,
                    0.01,
                    normalSize.Z
                )

            for i = 0, 20 do

                if self.Destroyed
                    or token ~= self.AnimationToken then

                    return
                end

                local progress =
                    i / 20

                local scale =
                    math.max(
                        progress,
                        0.01
                    )

                WindowPart.Size =
                    Vector3.new(
                        normalSize.X * scale,
                        normalSize.Y * scale,
                        normalSize.Z
                    )

                if self.CloseAnimation
                    == "Zoom" then

                    WindowPart.Transparency =
                        1 - progress

                    setAlpha(
                        1 - progress
                    )

                else

                    WindowPart.Transparency =
                        0

                    setAlpha(
                        0
                    )

                end

                task.wait(
                    self.FadeDuration / 20
                )

            end

            ----------------------------------------------------
            -- THIS IS CRITICAL:
            -- ALWAYS RESTORE FULL NORMAL SIZE
            ----------------------------------------------------

            WindowPart.Size =
                normalSize

        end

        if self.Destroyed
            or token ~= self.AnimationToken then

            return
        end

        WindowPart.Size =
            self.DisplaySize

        WindowPart.Transparency =
            0

        setAlpha(
            0
        )

        restoreActiveTab()

        self.Animating =
            false

    end

    ------------------------------------------------------------
    -- HIDE
    ------------------------------------------------------------

    function self:Hide()

        if self.Destroyed then
            return
        end

        if not self.Visible
            or self.Animating then

            return
        end

        self.Animating =
            true

        self.AnimationToken =
            self.AnimationToken + 1

        local token =
            self.AnimationToken

        ActiveSlider =
            nil

        --------------------------------------------------------
        -- CLEAR HOVER IMMEDIATELY
        --------------------------------------------------------

        resetTabs()

        --------------------------------------------------------
        -- FADE
        --------------------------------------------------------

        if self.CloseAnimation
            == "Fade" then

            for i = 0, 20 do

                if self.Destroyed
                    or token ~= self.AnimationToken then

                    return
                end

                local alpha =
                    i / 20

                WindowPart.Transparency =
                    alpha

                setAlpha(
                    alpha
                )

                task.wait(
                    self.FadeDuration / 20
                )

            end

        --------------------------------------------------------
        -- SLIDE DOWN
        --------------------------------------------------------

        elseif self.CloseAnimation
            == "SlideDown" then

            for i = 0, 20 do

                if self.Destroyed
                    or token ~= self.AnimationToken then

                    return
                end

                local alpha =
                    i / 20

                Main.Position =
                    UDim2.fromScale(
                        0,
                        alpha
                    )

                WindowPart.Transparency =
                    alpha

                setAlpha(
                    alpha
                )

                task.wait(
                    self.FadeDuration / 20
                )

            end

        --------------------------------------------------------
        -- SLIDE UP
        --------------------------------------------------------

        elseif self.CloseAnimation
            == "SlideUp" then

            for i = 0, 20 do

                if self.Destroyed
                    or token ~= self.AnimationToken then

                    return
                end

                local alpha =
                    i / 20

                Main.Position =
                    UDim2.fromScale(
                        0,
                        -alpha
                    )

                WindowPart.Transparency =
                    alpha

                setAlpha(
                    alpha
                )

                task.wait(
                    self.FadeDuration / 20
                )

            end

        --------------------------------------------------------
        -- COLLAPSE
        --------------------------------------------------------

        elseif self.CloseAnimation
            == "Collapse" then

            local normalSize =
                self.DisplaySize

            for i = 0, 20 do

                if self.Destroyed
                    or token ~= self.AnimationToken then

                    return
                end

                local progress =
                    i / 20

                local scale =
                    math.max(
                        1 - progress,
                        0.01
                    )

                WindowPart.Size =
                    Vector3.new(
                        normalSize.X * scale,
                        normalSize.Y * scale,
                        normalSize.Z
                    )

                WindowPart.Transparency =
                    0

                setAlpha(
                    0
                )

                task.wait(
                    self.FadeDuration / 20
                )

            end

        --------------------------------------------------------
        -- ZOOM
        --------------------------------------------------------

        elseif self.CloseAnimation
            == "Zoom" then

            local normalSize =
                self.DisplaySize

            for i = 0, 20 do

                if self.Destroyed
                    or token ~= self.AnimationToken then

                    return
                end

                local progress =
                    i / 20

                local scale =
                    math.max(
                        1 - progress,
                        0.01
                    )

                WindowPart.Size =
                    Vector3.new(
                        normalSize.X * scale,
                        normalSize.Y * scale,
                        normalSize.Z
                    )

                WindowPart.Transparency =
                    progress

                setAlpha(
                    progress
                )

                task.wait(
                    self.FadeDuration / 20
                )

            end

        end

        if self.Destroyed
            or token ~= self.AnimationToken then

            return
        end

        --------------------------------------------------------
        -- GUARANTEE FULLY HIDDEN
        --------------------------------------------------------

        WindowPart.Transparency =
            1

        setAlpha(
            1
        )

        --------------------------------------------------------
        -- RESET TEMPORARY UI POSITION
        --------------------------------------------------------

        Main.Position =
            UDim2.fromScale(
                0,
                0
            )

        --------------------------------------------------------
        -- NORMAL SIZE ALWAYS RESTORED
        -- BEFORE NEXT SHOW
        --------------------------------------------------------

        WindowPart.Size =
            self.DisplaySize

        --------------------------------------------------------
        -- HIDDEN
        --------------------------------------------------------

        self.Visible =
            false

        --------------------------------------------------------
        -- ONLY AFTER INVISIBLE:
        -- MOVE TO FOLLOW POSITION
        --------------------------------------------------------

        local target =
            getFollowCFrame()

        if target then

            WindowPart.CFrame =
                target

        end

        self.Animating =
            false

    end

