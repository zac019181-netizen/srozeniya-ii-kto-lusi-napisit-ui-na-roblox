    ------------------------------------------------------------
    -- HITBOXES
    ------------------------------------------------------------

    local Hitboxes = {}

    local function register(
        gui,
        callback
    )
        Hitboxes[gui] =
            callback

        return gui
    end

    ------------------------------------------------------------
    -- RAYCAST PARAMS
    --
    -- THIS FIXES:
    -- "Unable to cast Dictionary to RaycastParams"
    ------------------------------------------------------------

    local RaycastParams =
        RaycastParams.new()

    RaycastParams.FilterType =
        Enum.RaycastFilterType.Include

    RaycastParams.FilterDescendantsInstances = {
        WindowPart
    }

    RaycastParams.IgnoreWater =
        true

    ------------------------------------------------------------
    -- FOLLOW POSITION
    ------------------------------------------------------------

    local function getFollowCFrame()

        local root =
            getRoot()

        if not root then
            return nil
        end

        return
            root.CFrame
            * CFrame.new(
                0,
                self.FollowHeight,
                -self.FollowDistance
            )
            * CFrame.Angles(
                0,
                math.rad(180),
                0
            )
    end

    ------------------------------------------------------------
    -- REAL RAYCAST MOUSE POSITION
    -- WITH MIRRORED X
    ------------------------------------------------------------

    local function getMouseSurfacePosition()

        local camera =
            workspace.CurrentCamera

        if not camera then
            return nil
        end

        local mouse =
            UserInputService:GetMouseLocation()

        local ray =
            camera:ViewportPointToRay(
                mouse.X,
                mouse.Y
            )

        local result =
            workspace:Raycast(
                ray.Origin,
                ray.Direction * 1000,
                RaycastParams
            )

        if not result then
            return nil
        end

        if result.Instance
            ~= WindowPart then

            return nil
        end

        local localPoint =
            WindowPart.CFrame
                :PointToObjectSpace(
                    result.Position
                )

        local halfX =
            WindowPart.Size.X / 2

        local halfY =
            WindowPart.Size.Y / 2

        local x =
            (
                localPoint.X
                + halfX
            )
            / WindowPart.Size.X

        local y =
            (
                -localPoint.Y
                + halfY
            )
            / WindowPart.Size.Y

        --------------------------------------------------------
        -- MIRROR X
        --------------------------------------------------------

        x = 1 - x

        x =
            math.clamp(
                x,
                0,
                1
            )

        y =
            math.clamp(
                y,
                0,
                1
            )

        return Vector2.new(
            x * Surface.AbsoluteSize.X,
            y * Surface.AbsoluteSize.Y
        )
    end

    ------------------------------------------------------------
    -- IMPORTANT:
    -- Check EVERY parent.
    --
    -- This fixes:
    -- Main click also activating Settings Keybind.
    ------------------------------------------------------------

    local function isActuallyVisible(gui)

        local current =
            gui

        while current
            and current ~= Surface do

            if current:IsA(
                "GuiObject"
            ) then

                if not current.Visible then
                    return false
                end

            end

            current =
                current.Parent
        end

        return true
    end

    ------------------------------------------------------------
    -- POINT INSIDE
    ------------------------------------------------------------

    local function pointInside(
        gui,
        point
    )

        if not gui.Parent then
            return false
        end

        if not isActuallyVisible(
            gui
        ) then
            return false
        end

        local pos =
            gui.AbsolutePosition

        local size =
            gui.AbsoluteSize

        return
            point.X >= pos.X
            and point.X <=
                pos.X + size.X
            and point.Y >= pos.Y
            and point.Y <=
                pos.Y + size.Y
    end

    ------------------------------------------------------------
    -- FIRE CLICK
    ------------------------------------------------------------

    local function fireAtPoint(
        point
    )

        local selected =
            nil

        local selectedCallback =
            nil

        local bestZ =
            -math.huge

        for gui, callback in pairs(
            Hitboxes
        ) do

            if gui
                and gui.Parent
                and gui:IsA("GuiObject") then

                if pointInside(
                    gui,
                    point
                ) then

                    local z =
                        gui.ZIndex

                    if z >= bestZ then

                        bestZ = z

                        selected =
                            gui

                        selectedCallback =
                            callback

                    end

                end

            end

        end

        if selectedCallback then

            return selectedCallback(
                point,
                selected
            )

        end
    end

    ------------------------------------------------------------
    -- RIGHT MOUSE
    ------------------------------------------------------------

    UserInputService.InputBegan:Connect(
        function(
            input,
            processed
        )

            if processed then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseButton2 then

                return
            end

            if not self.Visible
                or self.Animating then

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            fireAtPoint(
                point
            )

        end
    )

    ------------------------------------------------------------
    -- ACTIVE SLIDER
    ------------------------------------------------------------

    local ActiveSlider =
        nil

    ------------------------------------------------------------
    -- MOUSE MOVE
    ------------------------------------------------------------

    UserInputService.InputChanged:Connect(
        function(
            input
        )

            if not ActiveSlider then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseMovement then

                return
            end

            if not self.Visible then

                ActiveSlider = nil

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            ActiveSlider.Update(
                point.X
            )

        end
    )

    ------------------------------------------------------------
    -- MOUSE RELEASE
    ------------------------------------------------------------

    UserInputService.InputEnded:Connect(
        function(
            input
        )

            if input.UserInputType
                == Enum.UserInputType.MouseButton2 then

                ActiveSlider =
                    nil

            end

        end
    )

    ------------------------------------------------------------
    -- WHEEL
    ------------------------------------------------------------

    UserInputService.InputChanged:Connect(
        function(
            input
        )

            if not self.Visible
                or self.Animating then

                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseWheel then

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            local page =
                self.CurrentTab

            if not page then
                return
            end

            local scroll =
                input.Position.Z

            page.CanvasPosition =
                Vector2.new(
                    page.CanvasPosition.X,
                    math.max(
                        0,
                        page.CanvasPosition.Y
                        - scroll * 45
                    )
                )

        end
    )

    ------------------------------------------------------------
    -- FADE
    ------------------------------------------------------------

    local function setGuiAlpha(
        alpha
    )

        for _, object in ipairs(
            Surface:GetDescendants()
        ) do

            if object:IsA(
                "TextLabel"
            )
            or object:IsA(
                "TextButton"
            )
            or object:IsA(
                "TextBox"
            ) then

                object.TextTransparency =
                    alpha

            elseif object:IsA(
                "ImageLabel"
            )
            or object:IsA(
                "ImageButton"
            ) then

                object.ImageTransparency =
                    alpha
            end

            if object:IsA(
                "GuiObject"
            ) then

                local original =
                    object:GetAttribute(
                        "OriginalBG"
                    )

                if original == nil then

                    original =
                        object.BackgroundTransparency

                    object:SetAttribute(
                        "OriginalBG",
                        original
                    )

                end

                if original < 1 then

                    object.BackgroundTransparency =
                        original
                        + (
                            1 - original
                        ) * alpha

                end

            end

        end

    end

    ------------------------------------------------------------
    -- SHOW
    ------------------------------------------------------------

    function self:Show()

        if self.Visible
            or self.Animating then

            return
        end

        self.Animating =
            true

        --------------------------------------------------------
        -- STEP 1:
        -- COMPLETELY HIDDEN
        --------------------------------------------------------

        WindowPart.Transparency =
            1

        setGuiAlpha(
            1
        )

        --------------------------------------------------------
        -- STEP 2:
        -- POSITION WHILE HIDDEN
        --------------------------------------------------------

        local target =
            getFollowCFrame()

        if target then

            WindowPart.CFrame =
                target

        end

        --------------------------------------------------------
        -- STEP 3:
        -- STOP FOLLOWING
        --------------------------------------------------------

        self.Visible =
            true

        --------------------------------------------------------
        -- STEP 4:
        -- FADE IN
        --------------------------------------------------------

        local steps = 20

        for i = steps, 0, -1 do

            local alpha =
                i / steps

            WindowPart.Transparency =
                alpha

            setGuiAlpha(
                alpha
            )

            task.wait(
                self.FadeDuration
                / steps
            )

        end

        WindowPart.Transparency =
            0

        setGuiAlpha(
            0
        )

        self.Animating =
            false

    end

    ------------------------------------------------------------
    -- HIDE
    ------------------------------------------------------------

    function self:Hide()

        if not self.Visible
            or self.Animating then

            return
        end

        self.Animating =
            true

        --------------------------------------------------------
        -- STEP 1:
        -- FADE OUT COMPLETELY
        --------------------------------------------------------

        local steps = 20

        for i = 0, steps do

            local alpha =
                i / steps

            WindowPart.Transparency =
                alpha

            setGuiAlpha(
                alpha
            )

            task.wait(
                self.FadeDuration
                / steps
            )

        end

        --------------------------------------------------------
        -- STEP 2:
        -- NOW FULLY INVISIBLE
        --------------------------------------------------------

        WindowPart.Transparency =
            1

        setGuiAlpha(
            1
        )

        --------------------------------------------------------
        -- STEP 3:
        -- ONLY NOW HIDDEN
        --------------------------------------------------------

        self.Visible =
            false

        --------------------------------------------------------
        -- STEP 4:
        -- ONLY NOW MOVE
        --------------------------------------------------------

        local target =
            getFollowCFrame()

        if target then

            WindowPart.CFrame =
                target

        end

        self.Animating =
            false

    end

    ------------------------------------------------------------
    -- TOGGLE
    ------------------------------------------------------------

    function self:ToggleUI()

        if self.Animating then
            return
        end

        if self.Visible then

            self:Hide()

        else

            self:Show()

        end

    end

    ------------------------------------------------------------
    -- TOGGLE KEY
    ------------------------------------------------------------

    function self:SetToggleKey(
        key
    )

        if typeof(key)
            ~= "EnumItem" then

            return false
        end

        if key.EnumType
            ~= Enum.KeyCode then

            return false
        end

        self.ToggleKey =
            key

        return true

    end

    function self:GetToggleKey()

        return self.ToggleKey

    end

    ------------------------------------------------------------
    -- KEY LISTENER
    ------------------------------------------------------------

    UserInputService.InputBegan:Connect(
        function(
            input,
            processed
        )

            if processed then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.Keyboard then

                return
            end

            if input.KeyCode
                ~= self.ToggleKey then

                return
            end

            self:ToggleUI()

        end
    )

    ------------------------------------------------------------
    -- FOLLOW WHEN HIDDEN
    ------------------------------------------------------------

    RunService.RenderStepped:Connect(
        function()

            if self.Visible
                or self.Animating then

                return
            end

            local target =
                getFollowCFrame()

            if target then

                WindowPart.CFrame =
                    target

            end

        end
    )

    ------------------------------------------------------------
    -- WINDOW SIZE
    ------------------------------------------------------------

    function self:SetSizeMultiplier(
        value
    )

        value =
            tonumber(value)
            or 1

        value =
            math.clamp(
                value,
                0.5,
                2
            )

        self.SizeMultiplier =
            value

        WindowPart.Size =
            Vector3.new(
                self.BaseSize.X
                    * value,

                self.BaseSize.Y
                    * value,

                self.BaseSize.Z
            )

    end

    function self:GetSizeMultiplier()

        return self.SizeMultiplier

    end

    ------------------------------------------------------------
    -- DISTANCE
    ------------------------------------------------------------

    function self:SetDistance(
        value
    )

        value =
            tonumber(value)
            or 7

        self.FollowDistance =
            math.clamp(
                value,
                2,
                20
            )

    end

    function self:GetDistance()

        return self.FollowDistance

    end

    ------------------------------------------------------------
    -- HEIGHT
    ------------------------------------------------------------

    function self:SetHeight(
        value
