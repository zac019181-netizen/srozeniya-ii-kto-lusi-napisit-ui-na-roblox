                        6
                    )

                Bar.Position =
                    UDim2.new(
                        0,
                        10,
                        1,
                        -13
                    )

                Bar.BackgroundColor3 =
                    Color3.fromRGB(
                        55,
                        55,
                        55
                    )

                Bar.Parent =
                    Slider

                Bar.ZIndex = 21

                addCorner(
                    Bar,
                    5
                )

                local Fill =
                    Instance.new("Frame")

                Fill.BackgroundColor3 =
                    theme.SchemeColor

                Fill.Parent =
                    Bar

                Fill.ZIndex = 22

                addCorner(
                    Fill,
                    5
                )

                local function getPercent()

                    if max == min then
                        return 1
                    end

                    return math.clamp(
                        (
                            Value - min
                        )
                        / (
                            max - min
                        ),
                        0,
                        1
                    )

                end

                local function redraw()

                    Fill.Size =
                        UDim2.new(
                            getPercent(),
                            0,
                            1,
                            0
                        )

                    ValueLabel.Text =
                        tostring(
                            Value
                        )

                end

                local function setFromX(
                    mouseX,
                    shouldCallback
                )

                    local barLeft =
                        Bar.AbsolutePosition.X

                    local barWidth =
                        Bar.AbsoluteSize.X

                    if barWidth <= 0 then
                        return
                    end

                    local alpha =
                        math.clamp(
                            (
                                mouseX
                                - barLeft
                            )
                            / barWidth,
                            0,
                            1
                        )

                    if max == min then

                        Value = min

                    else

                        Value =
                            min
                            + (
                                max - min
                            ) * alpha

                        Value =
                            math.floor(
                                Value + 0.5
                            )

                    end

                    redraw()

                    if shouldCallback then

                        safeCallback(
                            callback,
                            Value
                        )

                    end

                end

                redraw()

                register(
                    Slider,
                    function()

                        local point =
                            getMouseSurfacePosition()

                        if not point then
                            return
                        end

                        ActiveSlider = {
                            Update = function(x)

                                setFromX(
                                    x,
                                    true
                                )

                            end
                        }

                        setFromX(
                            point.X,
                            true
                        )

                    end
                )

                local Object = {
                    Instance = Slider
                }

                function Object:Set(
                    value
                )

                    value =
                        tonumber(value)
                        or min

                    value =
                        math.clamp(
                            value,
                            min,
                            max
                        )

                    Value =
                        math.floor(
                            value + 0.5
                        )

                    redraw()

                    safeCallback(
                        callback,
                        Value
                    )

                end

                function Object:Get()
                    return Value
                end

                return Object

            end

