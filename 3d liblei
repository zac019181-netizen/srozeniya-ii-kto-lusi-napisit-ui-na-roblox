                        Fill.Size =
                            UDim2.new(
                                Value,
                                0,
                                1,
                                0
                            )
                    end

                    local object = {}

                    register(
                        Holder,
                        function()

                            local point =
                                getMouseSurfacePosition()

                            if not point then
                                return
                            end

                            local x =
                                Bar.AbsolutePosition.X

                            local width =
                                Bar.AbsoluteSize.X

                            if width <= 0 then
                                return
                            end

                            Value =
                                math.clamp(
                                    (
                                        point.X - x
                                    ) / width,
                                    0,
                                    1
                                )

                            redraw()

                            colorFunction(Value)

                            dragging = true

                            ActiveSlider = {
                                Update = function(mx)

                                    Value =
                                        math.clamp(
                                            (
                                                mx - x
                                            ) / width,
                                            0,
                                            1
                                        )

                                    redraw()

                                    colorFunction(
                                        Value
                                    )

                                end
                            }

                        end
                    )

                    return object
                end

                local function applyHSV(
                    h,
                    s,
                    v
                )

                    CurrentColor =
                        Color3.fromHSV(
                            h,
                            s,
                            v
                        )

                    Preview.BackgroundColor3 =
                        CurrentColor

                    safeCallback(
                        callback,
                        CurrentColor
                    )

                end

                local Hue =
                    makeColorSlider(
                        "H",
                        H,
                        7,
                        function(value)
                            H = value

                            applyHSV(
