            function Elements:NewSlider(
                name,
                tip,
                max,
                min,
                default,
                callback
            )

                callback =
                    callback
                    or function() end

                min =
                    tonumber(min)
                    or 0

                max =
                    tonumber(max)
                    or 100

                if max < min then

                    min, max =
                        max, min

                end

                default =
                    tonumber(default)
                    or min

                default =
                    math.clamp(
                        default,
                        min,
                        max
                    )

                local Value =
                    default

                local Slider =
                    Instance.new(
                        "TextLabel"
                    )

                Slider.Name =
                    name or "Slider"

                Slider.Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        48
                    )

                Slider.BackgroundColor3 =
                    theme.ElementColor

