                                    function(x)

                                        local v =
                                            math.clamp(
                                                (
                                                    x
                                                    - left
                                                )
                                                / width,
                                                0,
                                                1
                                            )

                                        Fill.Size =
                                            UDim2.new(
                                                v,
                                                0,
                                                1,
                                                0
                                            )

                                        onChanged(
                                            v
                                        )

                                    end
                            }

                        end
                    )

                end

                makeHSVSlider(
                    "H",
                    H,
                    6,
                    function(value)

                        H = value

                        applyColor()

                    end
                )

                makeHSVSlider(
                    "S",
                    S,
                    39,
                    function(value)

                        S = value

                        applyColor()

                    end
                )

                makeHSVSlider(
                    "V",
                    V,
                    72,
                    function(value)

                        V = value

                        applyColor()

                    end
                )

                register(
                    Picker,
                    function()

                        Opened =
                            not Opened

                        Popup.Visible =
                            Opened

                    end
                )

                local Object = {
                    Instance = Picker
                }

                function Object:Set(
                    color
                )

                    if typeof(color)
                        ~= "Color3" then

                        return false
                    end

                    CurrentColor =
                        color

                    H, S, V =
                        Color3.toHSV(
                            color
                        )

                    Preview.BackgroundColor3 =
                        CurrentColor

                    safeCallback(
                        callback,
                        CurrentColor
                    )

                    return true

                end

                function Object:Get()
                    return CurrentColor
                end

                return Object

            end

            ------------------------------------------------
            -- RETURN ELEMENT API
            ------------------------------------------------

            return Elements

        end

        table.insert(
            self.Tabs,
            Tab
        )

        return Tab

    end

    --------------------------------------------------------
    -- CHANGE COLOR
    --------------------------------------------------------

    function self:ChangeColor(
        property,
        color
    )

        if self.Theme[property] == nil then
            return false
        end

        self.Theme[property] =
            color

        if property == "Background" then

            Main.BackgroundColor3 =
                color

        elseif property == "Header" then

            Header.BackgroundColor3 =
                color

            HeaderCover.BackgroundColor3 =
                color

            Side.BackgroundColor3 =
                color

        elseif property == "TextColor" then

            Title.TextColor3 =
                color

        elseif property == "SchemeColor" then

            for _, object in ipairs(
                Surface:GetDescendants()
            ) do

                if object:IsA(
                    "TextLabel"
                )
                and object.Parent == Side then

                    object.BackgroundColor3 =
                        color

                end
            end

        end

        return true
    end

