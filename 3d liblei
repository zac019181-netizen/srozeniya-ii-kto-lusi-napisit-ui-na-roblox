            function Elements:NewColorPicker(
                name,
                tip,
                default,
                callback
            )

                callback =
                    callback
                    or function() end

                local CurrentColor =
                    default
                    or Color3.fromRGB(
                        255,
                        255,
                        255
                    )

                local Picker =
                    Instance.new(
                        "Frame"
                    )

                Picker.Name =
                    name
                    or "ColorPicker"

                Picker.Size =
