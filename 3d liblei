    -- MOUSE MOVE
    ----------------------------------------------------------------

    connect(
        UserInputService.InputChanged,
        function(input)

            if not ActiveSlider then
                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseMovement then

                return
            end

            if not self.Visible
                or self.Animating
                or self.Destroyed then

                ActiveSlider =
                    nil

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            ActiveSlider.Update(
                point.X
            )

        end
    )

