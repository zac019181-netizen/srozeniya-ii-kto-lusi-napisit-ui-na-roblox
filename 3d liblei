                Dropdown.BorderSizePixel =
                    0
            
                Dropdown.ClipsDescendants =
                    true
            
                Dropdown.Parent =
                    Container
            
                Dropdown.ZIndex =
                    50
            
                addCorner(
                    Dropdown,
                    5
                )
            
                --------------------------------------------------------
                -- HEADER
                --------------------------------------------------------
            
                local DropHeader =
                    Instance.new("TextLabel")
            
                DropHeader.Name =
                    "Header"
            
                DropHeader.Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        CLOSED_HEIGHT
                    )
            
                DropHeader.BackgroundTransparency =
                    1
            
                DropHeader.TextColor3 =
                    theme.TextColor
            
                DropHeader.TextSize =
                    13
            
                DropHeader.Font =
                    Enum.Font.Gotham
            
                DropHeader.TextXAlignment =
                    Enum.TextXAlignment.Left
            
                DropHeader.Parent =
                    Dropdown
            
                DropHeader.ZIndex =
                    55
            
                addPadding(
                    DropHeader,
                    10,
                    10,
                    0,
                    0
                )
            
                --------------------------------------------------------
                -- OPTION LIST
                --------------------------------------------------------
            
                local List =
                    Instance.new("Frame")
            
                List.Name =
                    "Options"
            
                List.Position =
                    UDim2.new(
                        0,
                        0,
                        0,
                        CLOSED_HEIGHT
                    )
            
                List.Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        0
                    )
            
                List.BackgroundTransparency =
                    1
            
                List.BorderSizePixel =
                    0
            
                List.Visible =
                    false
            
                List.Parent =
                    Dropdown
            
                List.ZIndex =
                    60
            
                addPadding(
                    List,
                    4,
                    4,
                    4,
                    4
                )
            
                --------------------------------------------------------
                -- LIST LAYOUT
                --------------------------------------------------------
            
                local ListLayout =
                    Instance.new(
                        "UIListLayout"
                    )
            
                ListLayout.Padding =
                    UDim.new(
                        0,
                        3
                    )
            
                ListLayout.SortOrder =
                    Enum.SortOrder.LayoutOrder
            
                ListLayout.Parent =
                    List
            
                --------------------------------------------------------
                -- OPTIONS
                --------------------------------------------------------
            
                local OptionObjects =
                    {}
            
                local function updateHeader()
                
                    DropHeader.Text =
                        tostring(
                            name
                        )
                        .. ": "
                        .. tostring(
                            Current
                            or "None"
                        )
            
                end
            
                updateHeader()
            
                --------------------------------------------------------
                -- CREATE OPTIONS
                --------------------------------------------------------
            
                for index, option in ipairs(
                    options
                ) do
            
                    local Option =
                        Instance.new(
                            "TextLabel"
                        )
            
                    Option.Name =
                        tostring(option)
            
                    Option.Size =
                        UDim2.new(
                            1,
                            0,
                            0,
                            OPTION_HEIGHT
                        )
            
                    Option.BackgroundColor3 =
                        theme.Background
            
                    Option.Text =
                        tostring(option)
            
                    Option.TextColor3 =
                        theme.TextColor
            
                    Option.TextSize =
                        12
            
                    Option.Font =
                        Enum.Font.Gotham
            
                    Option.Visible =
                        false
            
                    Option.Parent =
                        List
            
                    Option.ZIndex =
                        65
            
                    addCorner(
                        Option,
                        4
                    )
            
                    table.insert(
                        OptionObjects,
                        Option
                    )
            
                end
            
                --------------------------------------------------------
                -- CALCULATE LIST HEIGHT
                --------------------------------------------------------
            
                local function getListHeight()
                
                    local contentHeight =
                        ListLayout.AbsoluteContentSize.Y
            
                    return contentHeight + 8
            
                end
            
                --------------------------------------------------------
                -- CALCULATE DROPDOWN HEIGHT
                --------------------------------------------------------
            
                local function getOpenHeight()
                
                    return
                        CLOSED_HEIGHT
                        + getListHeight()
            
                end
            
                --------------------------------------------------------
                -- DISABLE OPTIONS
                --------------------------------------------------------
            
                local function disableOptions()
                
                    for _, option in ipairs(
                        OptionObjects
                    ) do
            
                        Hitboxes[option] =
                            nil
            
                        option.Visible =
                            false
            
                    end
            
                    List.Visible =
                        false
            
                    List.Size =
                        UDim2.new(
                            1,
                            0,
                            0,
                            0
                        )
            
                end
            
                --------------------------------------------------------
                -- ENABLE OPTIONS
                --------------------------------------------------------
            
                local function enableOptions()
                
                    List.Visible =
                        true
            
                    ----------------------------------------------------
                    -- THIS WAS THE MISSING PART
                    ----------------------------------------------------
            
                    List.Size =
                        UDim2.new(
                            1,
                            0,
                            0,
                            getListHeight()
                        )
            
                    for index, option in ipairs(
                        OptionObjects
                    ) do
            
                        option.Visible =
                            true
            
                        ------------------------------------------------
                        -- OPTIONS ARE REGISTERED ONLY WHILE OPEN
                        ------------------------------------------------
            
                        Hitboxes[option] =
                            function()
                            
                                if not Opened then
                                    return
                                end
            
                                Current =
                                    options[index]
            
                                updateHeader()
            
                                safeCallback(
                                    callback,
                                    Current
                                )
            
                                Opened =
                                    false
            
                                ------------------------------------------------
                                -- REMOVE ALL OPTION HITBOXES
                                ------------------------------------------------
            
                                for _, optionObject in ipairs(
                                    OptionObjects
                                ) do
            
                                    Hitboxes[
                                        optionObject
                                    ] = nil
            
                                end
            
                                ------------------------------------------------
                                -- ANIMATE LIST CLOSED
                                ------------------------------------------------
            
                                local closeTween =
                                    tween(
                                        Dropdown,
                                        0.18,
                                        {
                                            Size =
                                                UDim2.new(
                                                    1,
                                                    0,
                                                    0,
                                                    CLOSED_HEIGHT
                                                )
                                        }
                                    )
            
                                tween(
                                    List,
                                    0.18,
                                    {
                                        Size =
                                            UDim2.new(
                                                1,
                                                0,
                                                0,
                                                0
                                            )
                                    }
                                )
            
                                closeTween.Completed:Connect(
                                    function()
                                    
                                        if not Dropdown.Parent then
                                            return
                                        end
            
                                        if Opened then
                                            return
                                        end
            
                                        for _, optionObject in ipairs(
                                            OptionObjects
                                        ) do
            
                                            optionObject.Visible =
                                                false
            
                                        end
            
                                        List.Visible =
                                            false
            
                                    end
                                )
            
                            end
            
                    end
            
                end
            
                --------------------------------------------------------
                -- OPEN
                --------------------------------------------------------
            
                local function openDropdown()
                
                    if Opened then
                        return
                    end
            
                    if not self.Visible
                        or self.Animating then
            
                        return
                    end
            
                    Opened =
                        true
            
                    ----------------------------------------------------
                    -- FIRST SHOW OPTIONS
                    ----------------------------------------------------
            
                    enableOptions()
            
                    ----------------------------------------------------
                    -- START FROM ZERO HEIGHT
                    ----------------------------------------------------
            
                    Dropdown.Size =
                        UDim2.new(
                            1,
                            0,
                            0,
                            CLOSED_HEIGHT
                        )
            
                    List.Size =
                        UDim2.new(
                            1,
                            0,
                            0,
                            0
                        )
            
                    local targetListHeight =
                        getListHeight()
            
                    local targetDropdownHeight =
                        CLOSED_HEIGHT
                        + targetListHeight
            
                    ----------------------------------------------------
                    -- DROPDOWN EXPANDS DOWN
                    ----------------------------------------------------
            
                    tween(
                        Dropdown,
                        0.22,
                        {
                            Size =
                                UDim2.new(
                                    1,
                                    0,
                                    0,
                                    targetDropdownHeight
                                )
                        },
                        Enum.EasingStyle.Quart
                    )
            
                    tween(
                        List,
                        0.22,
                        {
                            Size =
                                UDim2.new(
                                    1,
                                    0,
                                    0,
                                    targetListHeight
                                )
                        },
                        Enum.EasingStyle.Quart
                    )
            
                end
            
                --------------------------------------------------------
                -- CLOSE
                --------------------------------------------------------
            
                local function closeDropdown()
                
                    if not Opened then
                        return
                    end
            
                    Opened =
                        false
            
                    ----------------------------------------------------
                    -- REMOVE HITBOXES IMMEDIATELY
                    ----------------------------------------------------
            
                    for _, option in ipairs(
                        OptionObjects
                    ) do
            
                        Hitboxes[option] =
                            nil
            
                    end
            
                    ----------------------------------------------------
                    -- BOTH CONTAINERS SHRINK
                    ----------------------------------------------------
            
                    local dropdownTween =
                        tween(
                            Dropdown,
                            0.18,
                            {
                                Size =
                                    UDim2.new(
                                        1,
                                        0,
                                        0,
                                        CLOSED_HEIGHT
                                    )
                            }
                        )
            
                    tween(
                        List,
                        0.18,
                        {
                            Size =
                                UDim2.new(
                                    1,
                                    0,
                                    0,
                                    0
                                )
                        }
                    )
            
                    dropdownTween.Completed:Connect(
                        function()
                        
                            if not Dropdown.Parent then
                                return
                            end
            
                            if Opened then
                                return
                            end
            
                            for _, option in ipairs(
                                OptionObjects
                            ) do
            
                                option.Visible =
                                    false
            
                            end
            
                            List.Visible =
                                false
            
                        end
                    )
            
                end
            
                --------------------------------------------------------
                -- HEADER HITBOX
                --------------------------------------------------------
            
                Hitboxes[DropHeader] =
                    function()
                    
                        if Opened then
                            closeDropdown()
                        else
                            openDropdown()
                        end
            
                    end
            
                --------------------------------------------------------
                -- REMEMBER DROPDOWN
                --------------------------------------------------------
            
                self._Dropdowns =
                    self._Dropdowns
                    or {}
            
                table.insert(
                    self._Dropdowns,
                    {
                        Close =
                            closeDropdown
                    }
                )
            
                --------------------------------------------------------
                -- OBJECT
                --------------------------------------------------------
            
                local Object = {
                
                    Instance =
                        Dropdown,
            
                    Header =
                        DropHeader,
            
                    Options =
                        List
            
                }
            
                function Object:Set(
                    value
                )
            
                    for index, option in ipairs(
                        options
                    ) do
            
                        if option == value then
                        
                            Current =
                                value
            
                            updateHeader()
            
                            safeCallback(
                                callback,
                                Current
                            )
            
                            return true
            
                        end
            
                    end
            
                    return false
            
                end
            
                function Object:Get()
                
                    return Current
            
                end
            
                function Object:Open()
                
                    openDropdown()
            
                end
            
                function Object:Close()
                
                    closeDropdown()
            
                end
            
                function Object:IsOpen()
                
                    return Opened
            
                end
            
                return Object
            
            end

            ----------------------------------------------------
            -- COLOR PICKER
            ----------------------------------------------------

            function Elements:NewColorPicker(
                name,
                tip,
                default,
                callback
            )

                callback =
                    callback or function() end

                local CurrentColor =
                    default
                    or Color3.fromRGB(
                        255,
                        255,
                        255
                    )

                local Picker =
                    Instance.new(
                        "TextLabel"
                    )

                Picker.Name =
                    name or "ColorPicker"

                Picker.Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        38
                    )

                Picker.BackgroundColor3 =
                    theme.ElementColor

                Picker.Text =
                    tostring(name)

                Picker.TextColor3 =
                    theme.TextColor

                Picker.TextSize =
                    13

                Picker.Font =
                    Enum.Font.Gotham

                Picker.TextXAlignment =
                    Enum.TextXAlignment.Left

                Picker.Parent =
                    Container

                Picker.ZIndex =
                    20

                addCorner(
                    Picker,
                    5
                )

                addPadding(
                    Picker,
                    10,
                    0,
                    0,
                    0
                )

                local Preview =
                    Instance.new(
                        "Frame"
                    )

                Preview.Size =
                    UDim2.new(
                        0,
                        27,
                        0,
                        21
                    )

                Preview.Position =
                    UDim2.new(
                        1,
                        -37,
                        0.5,
                        -10
                    )

                Preview.BackgroundColor3 =
                    CurrentColor

                Preview.Parent =
                    Picker

                Preview.ZIndex =
                    21

                addCorner(
                    Preview,
                    4
                )

                Hitboxes[Picker] =
                    function()

                        local h, s, v =
                            Color3.toHSV(
                                CurrentColor
                            )

                        h =
                            (h + 0.1)
                            % 1

                        CurrentColor =
                            Color3.fromHSV(
                                h,
                                s,
                                v
                            )

                        Preview.BackgroundColor3 =
                            CurrentColor

                        safeCallback(
                            callback,
                            CurrentColor
                        )

                    end

                local Object = {
                    Instance =
                        Picker
                }

                function Object:Set(
                    color
                )

                    if typeof(color)
                        ~= "Color3" then

                        return false

                    end

                    CurrentColor =
                        color

                    Preview.BackgroundColor3 =
                        color

                    safeCallback(
                        callback,
                        color
                    )

                    return true

                end

                function Object:Get()

                    return CurrentColor

                end

                return Object

            end

            return Elements

        end

        table.insert(
            self.Tabs,
            Tab
        )

        return Tab

    end

    ------------------------------------------------------------
    -- CHANGE COLOR
    ------------------------------------------------------------

    function self:ChangeColor(
        property,
        color
    )

        if self.Theme[property] == nil then
            return false
        end

        self.Theme[property] =
            color

        if property ==
            "Background" then

            Main.BackgroundColor3 =
                color

        elseif property ==
            "Header" then

            Header.BackgroundColor3 =
                color

            HeaderCover.BackgroundColor3 =
                color

            Side.BackgroundColor3 =
                color

        elseif property ==
            "TextColor" then

            Title.TextColor3 =
                color

        end

        return true

    end

