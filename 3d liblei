            function Elements:NewKeybind(
                name,
                tip,
                default,
                callback
            )

                callback =
                    callback
                    or function() end

                local CurrentKey =
                    default
                    or Enum.KeyCode.Unknown

                local Waiting =
                    false

                local BindConnection =
                    nil

                local Keybind =
                    Instance.new(
                        "TextLabel"
                    )

                Keybind.Name =
                    name
                    or "Keybind"

                Keybind.Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        38
                    )

                Keybind.BackgroundColor3 =
                    theme.ElementColor

                Keybind.TextColor3 =
                    theme.TextColor

                Keybind.TextSize = 13

                Keybind.Font =
                    Enum.Font.Gotham

                Keybind.Parent =
                    Container

                Keybind.ZIndex = 20

                addCorner(
                    Keybind,
                    5
                )

                local function updateText()

                    if Waiting then

                        Keybind.Text =
                            tostring(
                                name
                                or "Keybind"
                            )
                            .. " [PRESS KEY]"

                    else

                        Keybind.Text =
                            tostring(
                                name
                                or "Keybind"
                            )
                            .. " ["
                            .. CurrentKey.Name
                            .. "]"

                    end

                end

                updateText()

                local function beginBind()

                    if Waiting then
                        return
                    end

                    Waiting = true

                    updateText()

                    if BindConnection then
                        BindConnection:Disconnect()
                        BindConnection = nil
                    end

                    BindConnection =
                        UserInputService.InputBegan:Connect(
                            function(
                                input,
                                processed
                            )

                                if processed then
                                    return
                                end

                                if input.UserInputType
                                    ~= Enum.UserInputType.Keyboard then

                                    return
                                end

                                CurrentKey =
                                    input.KeyCode

                                Waiting = false

                                updateText()

                                if BindConnection then

                                    BindConnection:Disconnect()
                                    BindConnection = nil

                                end

                                safeCallback(
                                    callback,
                                    CurrentKey
                                )

                            end
                        )
                end

                register(
                    Keybind,
                    function()

                        beginBind()

                    end
                )

                local Object = {
                    Instance = Keybind
                }

                function Object:Set(
                    key
                )

                    if typeof(key)
                        ~= "EnumItem" then

                        return false
                    end

                    if key.EnumType
                        ~= Enum.KeyCode then

                        return false
                    end

                    CurrentKey =
                        key

                    Waiting = false

                    updateText()

                    safeCallback(
                        callback,
                        CurrentKey
                    )

                    return true

                end

                function Object:Get()
                    return CurrentKey
                end

                return Object

            end

