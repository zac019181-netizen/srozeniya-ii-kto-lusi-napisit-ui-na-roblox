                List.ZIndex =
                    50

                addPadding(
                    List,
                    4,
                    4,
                    0,
                    4
                )

                local ListLayout =
                    Instance.new(
                        "UIListLayout"
                    )

                ListLayout.Padding =
                    UDim.new(
                        0,
                        3
                    )

                ListLayout.Parent =
                    List

                ------------------------------------------------
                -- TEXT
                ------------------------------------------------

                local function updateText()

                    DropHeader.Text =
                        tostring(
                            name
                        )
                        .. ": "
                        .. tostring(
                            Current
                            or "None"
                        )

                end

                updateText()

                ------------------------------------------------
                -- OPTIONS
                ------------------------------------------------

                for _, option in ipairs(
                    options
                ) do

                    local Option =
                        Instance.new(
                            "TextLabel"
                        )

                    Option.Name =
                        tostring(option)

                    Option.Size =
                        UDim2.new(
                            1,
                            0,
                            0,
                            28
                        )

                    Option.BackgroundColor3 =
                        theme.Background

                    Option.Text =
                        tostring(option)

                    Option.TextColor3 =
                        theme.TextColor

                    Option.TextSize = 12

                    Option.Font =
                        Enum.Font.Gotham

                    Option.ZIndex =
                        51

                    Option.Parent =
                        List

                    addCorner(
                        Option,
                        4
                    )

                    register(
                        Option,
                        function()

                            Current =
                                option

                            updateText()

                            Opened =
                                false

                            local closedHeight =
                                38

                            tween(
                                Dropdown,
                                0.18,
                                {
                                    Size =
                                        UDim2.new(
                                            1,
                                            0,
                                            0,
                                            closedHeight
                                        )
                                }
                            )

                            safeCallback(
                                callback,
                                Current
                            )

                        end
                    )

                end

                ------------------------------------------------
                -- OPEN/CLOSE
                ------------------------------------------------

                local function getOpenHeight()

                    return
                        42
                        + ListLayout
                            .AbsoluteContentSize.Y
                        + 4

                end

                register(
                    DropHeader,
                    function()

                        if Opened then

                            Opened =
                                false

                            tween(
                                Dropdown,
                                0.18,
                                {
                                    Size =
                                        UDim2.new(
                                            1,
                                            0,
                                            0,
                                            38
                                        )
                                }
                            )

                        else

                            Opened =
                                true

                            local height =
                                getOpenHeight()

                            tween(
                                Dropdown,
                                0.22,
                                {
                                    Size =
                                        UDim2.new(
                                            1,
                                            0,
                                            0,
                                            height
                                        )
                                },
                                Enum.EasingStyle.Quart
                            )

                        end

                    end
                )

                ------------------------------------------------
                -- OBJECT WRAPPER
                ------------------------------------------------

                local Object = {
                    Instance =
                        Dropdown,
                    Header =
                        DropHeader
                }

                function Object:Set(
                    value
                )

                    for _, option in ipairs(
                        options
                    ) do

                        if option ==
                            value then

                            Current =
                                value

                            updateText()

                            safeCallback(
                                callback,
                                Current
                            )

                            return true

                        end

                    end

                    return false

                end

                function Object:Get()

                    return Current

                end

                function Object:Open()

                    if Opened then
                        return
                    end

                    Opened =
                        true

                    tween(
                        Dropdown,
                        0.22,
                        {
                            Size =
                                UDim2.new(
                                    1,
                                    0,
                                    0,
                                    getOpenHeight()
                                )
                        }
                    )

                end

                function Object:Close()

                    if not Opened then
                        return
                    end

                    Opened =
                        false

                    tween(
                        Dropdown,
                        0.18,
                        {
                            Size =
                                UDim2.new(
