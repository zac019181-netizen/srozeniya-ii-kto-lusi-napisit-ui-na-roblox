----------------------------------------------------------------
-- HELPERS
----------------------------------------------------------------

local function getTheme(theme)
    if type(theme) == "string" then
        return themes[theme] or themes.RJTheme3
    end

    if type(theme) == "table" then
        return {
            SchemeColor = theme.SchemeColor or Color3.fromRGB(91, 94, 176),
            Background = theme.Background or Color3.fromRGB(15, 15, 15),
            Header = theme.Header or Color3.fromRGB(15, 15, 15),
            TextColor = theme.TextColor or Color3.fromRGB(255, 255, 255),
            ElementColor = theme.ElementColor or Color3.fromRGB(20, 20, 20)
        }
    end

    return themes.RJTheme3
end

local function getRoot()
    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function addCorner(parent, radius)
    local corner = Instance.new("UICorner")

    corner.CornerRadius =
        UDim.new(0, radius or 5)

    corner.Parent = parent

    return corner
end

local function addPadding(
    parent,
    left,
    right,
    top,
    bottom
)
    local padding = Instance.new("UIPadding")

    padding.PaddingLeft =
        UDim.new(0, left or 0)

    padding.PaddingRight =
        UDim.new(0, right or 0)

    padding.PaddingTop =
        UDim.new(0, top or 0)

    padding.PaddingBottom =
        UDim.new(0, bottom or 0)

    padding.Parent = parent

    return padding
end

local function safeCallback(callback, ...)
    if type(callback) ~= "function" then
        return
    end

    pcall(callback, ...)
end

