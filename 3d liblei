        function(input, processed)

            if processed
                or self.Destroyed then

                return
            end

            if input.UserInputType
                ~= Enum.UserInputType.MouseButton2 then

                return
            end

            if not self.Visible
                or self.Animating then

                return
            end

            local point =
                getMouseSurfacePosition()

            if not point then
                return
            end

            local gui,
                callback =
