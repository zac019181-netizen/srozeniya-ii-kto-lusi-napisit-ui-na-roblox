                    Instance.new(
                        "TextLabel"
                    )

                ValueLabel.BackgroundTransparency =
                    1

                ValueLabel.AnchorPoint =
                    Vector2.new(
                        1,
                        0
                    )

                ValueLabel.Position =
                    UDim2.new(
                        1,
                        -10,
                        0,
                        0
                    )

                ValueLabel.Size =
                    UDim2.new(
                        0,
                        70,
                        0,
                        22
                    )

                ValueLabel.Text =
                    tostring(Value)

                ValueLabel.TextColor3 =
                    theme.TextColor

                ValueLabel.TextSize =
                    12

                ValueLabel.Font =
                    Enum.Font.Gotham

                ValueLabel.Parent =
                    Slider

                ValueLabel.ZIndex =
                    21

                local Bar =
                    Instance.new(
                        "Frame"
                    )

                Bar.Size =
                    UDim2.new(
                        1,
                        -20,
                        0,
                        6
                    )

                Bar.Position =
                    UDim2.new(
                        0,
                        10,
                        1,
                        -13
                    )

                Bar.BackgroundColor3 =
                    Color3.fromRGB(
                        55,
                        55,
                        55
                    )

                Bar.Parent =
                    Slider

                Bar.ZIndex =
                    21

                addCorner(
                    Bar,
                    5
                )

                local Fill =
                    Instance.new(
                        "Frame"
                    )

                Fill.BackgroundColor3 =
                    theme.SchemeColor

                Fill.Parent =
                    Bar

                Fill.ZIndex =
                    22

                addCorner(
                    Fill,
                    5
                )

                local function redraw()

                    local percent

                    if max == min then

                        percent = 1

                    else

                        percent =
                            (
                                Value - min
                            )
                            / (
                                max - min
                            )

                    end

                    Fill.Size =
                        UDim2.new(
                            math.clamp(
                                percent,
                                0,
                                1
                            ),
                            0,
                            1,
                            0
                        )

                    ValueLabel.Text =
                        tostring(
                            Value
                        )

                end

                local function updateFromMouse(
                    mouseX
                )

                    local left =
                        Bar.AbsolutePosition.X

                    local width =
                        Bar.AbsoluteSize.X

                    if width <= 0 then
                        return
                    end

                    local alpha =
                        math.clamp(
                            (
                                mouseX - left
                            )
                            / width,
                            0,
                            1
                        )

                    if max == min then

                        Value = min

                    else

                        Value =
                            min
                            + (
                                max - min
                            ) * alpha

                        Value =
                            math.floor(
                                Value + 0.5
                            )

                    end

                    redraw()

                    safeCallback(
                        callback,
                        Value
                    )

                end

                redraw()

                Hitboxes[Slider] =
                    function()

                        local point =
                            getMouseSurfacePosition()

                        if not point then
                            return
                        end

                        ActiveSlider = {

                            Update =
                                function(x)

                                    updateFromMouse(
                                        x
                                    )

                                end
                        }

                        updateFromMouse(
                            point.X
                        )

                    end

                local Object = {
                    Instance =
                        Slider
                }

                function Object:Set(
                    value
                )

                    value =
                        tonumber(value)
                        or min

                    Value =
                        math.clamp(
                            value,
                            min,
                            max
                        )

                    Value =
                        math.floor(
                            Value + 0.5
                        )

                    redraw()

                    safeCallback(
                        callback,
                        Value
                    )

                end

                function Object:Get()
                    return Value
                end

                return Object

            end

