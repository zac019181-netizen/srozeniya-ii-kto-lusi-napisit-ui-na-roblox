    ------------------------------------------------------------
    -- DESTROY
    ------------------------------------------------------------

    function self:Destroy()

        if self.Destroyed then
            return
        end

        self.Destroyed =
            true

        self.AnimationToken =
            self.AnimationToken + 1

        self.Visible =
            false

        self.Animating =
            false

        ActiveSlider =
            nil

        --------------------------------------------------------
        -- CLOSE DROPDOWNS
        --------------------------------------------------------

        if self._Dropdowns then

            for _, dropdown in ipairs(
                self._Dropdowns
            ) do

                if dropdown
                    and dropdown.Close then

                    pcall(
                        dropdown.Close
                    )

                end

            end

            table.clear(
                self._Dropdowns
            )

        end

        --------------------------------------------------------
        -- CANCEL TWEENS
        --------------------------------------------------------

        for _, animation in ipairs(
            self.Tweens
        ) do

            pcall(
                function()
                    animation:Cancel()
                end
            )

        end

        table.clear(
            self.Tweens
        )

        --------------------------------------------------------
        -- DISCONNECT
        --------------------------------------------------------

        for _, connection in ipairs(
            self.Connections
        ) do

            if connection
                and connection.Connected then

                connection:Disconnect()

            end

        end

        table.clear(
            self.Connections
        )

        --------------------------------------------------------
        -- CLEAR HITBOXES
        --------------------------------------------------------

        table.clear(
            Hitboxes
        )

        table.clear(
            TabHitboxes
        )

        --------------------------------------------------------
        -- REMOVE PART
        --------------------------------------------------------

        if WindowPart
            and WindowPart.Parent then

            WindowPart:Destroy()

        end

        --------------------------------------------------------
        -- CLEAR OBJECT REFERENCES
        --------------------------------------------------------

        self.Part =
            nil

        self.Surface =
            nil

        self.Main =
            nil

        self.CurrentTab =
            nil

        self.ActiveTab =
            nil

        self.HoveredTab =
            nil

        self.Tabs =
            {}

    end

    ------------------------------------------------------------
    -- INITIAL STATE
    ------------------------------------------------------------

    WindowPart.Size =
        self.DisplaySize

    WindowPart.Transparency =
        1

    setAlpha(
        1
    )

    for _, page in ipairs(
        Pages:GetChildren()
    ) do

        if page:IsA(
            "ScrollingFrame"
        ) then

            page.ScrollBarImageTransparency =
                1

        end

    end

    local initial =
        getFollowCFrame()

    if initial then
        WindowPart.CFrame =
            initial
    end

    ------------------------------------------------------------
    -- RETURN
    ------------------------------------------------------------

    return self
end

return Library
