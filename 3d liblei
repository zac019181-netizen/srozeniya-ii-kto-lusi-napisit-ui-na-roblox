    ----------------------------------------------------------------
    -- CHANGE COLOR
    ----------------------------------------------------------------

    function self:ChangeColor(
        property,
        color
    )

        if self.Theme[property] == nil then
            return false
        end

        self.Theme[property] =
            color

        if property == "Background" then

            Main.BackgroundColor3 =
                color

        elseif property == "Header" then

            Header.BackgroundColor3 =
                color

            HeaderBottom.BackgroundColor3 =
                color

            Side.BackgroundColor3 =
                color

        elseif property == "TextColor" then

            Title.TextColor3 =
                color

        elseif property == "SchemeColor" then

            for _, tab in ipairs(
                self.Tabs
            ) do

                if tab.Button then

                    tab.Button.BackgroundColor3 =
                        color

                end

            end

        end

        return true

    end

