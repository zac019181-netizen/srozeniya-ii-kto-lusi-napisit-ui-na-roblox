        "",
        Enum.KeyCode.Tab,
        function(key)

            self:SetToggleKey(
                key
            )

        end
    )

    --------------------------------------------------------
    -- GUI SIZE
    --------------------------------------------------------

    Settings:NewSlider(
        "GUI Size",
        "",
        200,
        50,
        100,
        function(value)

            self:SetSizeMultiplier(
                value / 100
            )

        end
    )

    --------------------------------------------------------
    -- GUI DISTANCE
    --------------------------------------------------------

    Settings:NewSlider(
        "GUI Distance",
        "",
        20,
        2,
        7,
        function(value)

            self:SetDistance(
                value
            )

        end
    )

    --------------------------------------------------------
    -- GUI HEIGHT
    --------------------------------------------------------

    Settings:NewSlider(
        "GUI Height",
        "",
        6,
        -3,
        1.7,
        function(value)

            self:SetHeight(
                value
            )

        end
    )

    --------------------------------------------------------
    -- FADE SPEED
    --------------------------------------------------------

    Settings:NewSlider(
        "Fade Speed",
        "",
        300,
        5,
        25,
        function(value)

            self:SetFadeDuration(
                value / 100
            )

        end
    )

    --------------------------------------------------------
    -- INFO
    --------------------------------------------------------

    Settings:NewLabel(
        "RMB = interact"
    )

    Settings:NewLabel(
        "Tab = open / close"
    )

    ------------------------------------------------------------
    -- INITIAL
    ------------------------------------------------------------

    WindowPart.Transparency =
        1

    setGuiAlpha(
        1
    )

    local initial =
        getFollowCFrame()

    if initial then
        WindowPart.CFrame =
            initial
    end

    return self
end

return Library
