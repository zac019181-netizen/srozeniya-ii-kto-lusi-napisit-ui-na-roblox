                    theme.TextColor

                Label.TextSize = 13

                Label.Font =
                    Enum.Font.Gotham

                Label.TextXAlignment =
                    Enum.TextXAlignment.Left

                Label.Parent =
                    Picker

                Label.ZIndex =
                    21

                local Preview =
                    Instance.new(
                        "Frame"
                    )

                Preview.Size =
                    UDim2.new(
                        0,
                        27,
                        0,
                        21
                    )

                Preview.Position =
                    UDim2.new(
                        1,
                        -37,
                        0.5,
                        -10
                    )

                Preview.BackgroundColor3 =
                    CurrentColor

                Preview.Parent =
                    Picker

                Preview.ZIndex =
                    22

                addCorner(
                    Preview,
                    4
                )

                local Opened =
                    false

                local Popup =
                    Instance.new(
                        "Frame"
                    )

                Popup.Name =
                    "Popup"

                Popup.Position =
                    UDim2.new(
                        0,
                        0,
                        0,
                        42
                    )

                Popup.Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        110
                    )

                Popup.BackgroundColor3 =
                    theme.Background

                Popup.BorderSizePixel =
                    0

                Popup.Visible =
                    false

                Popup.ZIndex =
                    90

                Popup.Parent =
                    Picker

                addCorner(
                    Popup,
                    5
                )

                ------------------------------------------------
                -- RGB sliders
                ------------------------------------------------

                local values = {
                    R = CurrentColor.R,
                    G = CurrentColor.G,
                    B = CurrentColor.B
                }

                local function applyColor()

                    CurrentColor =
                        Color3.new(
                            values.R,
                            values.G,
                            values.B
                        )

                    Preview.BackgroundColor3 =
                        CurrentColor

                    safeCallback(
                        callback,
                        CurrentColor
                    )

                end

                local yPositions = {
                    R = 8,
                    G = 38,
                    B = 68
                }

                for channel, y in pairs(
                    yPositions
                ) do

                    local Holder =
                        Instance.new(
                            "TextLabel"
                        )

                    Holder.BackgroundTransparency =
                        1

                    Holder.Position =
                        UDim2.new(
                            0,
                            8,
                            0,
                            y
                        )

                    Holder.Size =
                        UDim2.new(
                            1,
                            -16,
                            0,
                            25
                        )

                    Holder.Text =
                        channel

                    Holder.TextColor3 =
                        theme.TextColor

                    Holder.TextSize = 11

                    Holder.Font =
                        Enum.Font.Gotham

                    Holder.TextXAlignment =
                        Enum.TextXAlignment.Left

                    Holder.Parent =
                        Popup

                    Holder.ZIndex =
                        91

                    local Bar =
                        Instance.new(
                            "Frame"
                        )

                    Bar.Position =
                        UDim2.new(
                            0,
                            20,
                            0.5,
                            1
                        )

                    Bar.Size =
                        UDim2.new(
                            1,
                            -20,
                            0,
                            5
                        )

                    Bar.BackgroundColor3 =
                        Color3.fromRGB(
                            55,
                            55,
                            55
                        )

                    Bar.Parent =
                        Holder

                    Bar.ZIndex =
                        92

                    addCorner(
                        Bar,
                        5
                    )

                    local Fill =
                        Instance.new(
                            "Frame"
                        )

                    Fill.Size =
                        UDim2.new(
                            values[channel],
                            0,
                            1,
                            0
                        )

                    Fill.BackgroundColor3 =
                        theme.SchemeColor

                    Fill.Parent =
                        Bar

                    Fill.ZIndex =
                        93

                    addCorner(
                        Fill,
                        5
                    )

                    register(
                        Holder,
                        function()

                            local point =
                                getMouseSurfacePosition()

                            if not point then
                                return
                            end

                            local left =
                                Bar.AbsolutePosition.X

                            local width =
                                Bar.AbsoluteSize.X

                            local value =
                                math.clamp(
                                    (
                                        point.X
                                        - left
                                    )
                                    / width,
                                    0,
                                    1
                                )

                            values[channel] =
                                value

                            Fill.Size =
                                UDim2.new(
                                    value,
                                    0,
                                    1,
                                    0
                                )

                            applyColor()

                            ActiveSlider = {
                                Update = function(
                                    mouseX
                                )

                                    local v =
                                        math.clamp(
                                            (
                                                mouseX
                                                - left
                                            )
                                            / width,
                                            0,
                                            1
                                        )

                                    values[channel] =
                                        v

                                    Fill.Size =
                                        UDim2.new(
                                            v,
                                            0,
                                            1,
                                            0
                                        )

                                    applyColor()

                                end
                            }

                        end
                    )

                end

                register(
                    Picker,
                    function()

                        Opened =
                            not Opened

                        Popup.Visible =
                            Opened

                    end
                )

                local Object = {
                    Instance =
                        Picker
                }

                function Object:Set(
                    color
                )

                    if typeof(color)
                        ~= "Color3" then

                        return false

                    end

                    CurrentColor =
                        color

                    values.R =
                        color.R

                    values.G =
                        color.G

                    values.B =
                        color.B

                    Preview.BackgroundColor3 =
                        color

                    safeCallback(
                        callback,
                        color
                    )

                    return true

                end

                function Object:Get()

                    return CurrentColor

                end

                return Object

            end

            return Elements

        end

