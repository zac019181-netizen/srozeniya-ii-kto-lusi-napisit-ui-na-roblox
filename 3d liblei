----------------------------------------------------------------
-- HELPERS
----------------------------------------------------------------

local function safeCall(fn, ...)
    if type(fn) ~= "function" then
        return
    end

    pcall(fn, ...)
end

local function getTheme(theme)
    if type(theme) == "string" then
        return Themes[theme] or Themes.RJTheme3
    end

    if type(theme) == "table" then
        return {
            SchemeColor = theme.SchemeColor or Themes.RJTheme3.SchemeColor,
            Background = theme.Background or Themes.RJTheme3.Background,
            Header = theme.Header or Themes.RJTheme3.Header,
            TextColor = theme.TextColor or Themes.RJTheme3.TextColor,
            ElementColor = theme.ElementColor or Themes.RJTheme3.ElementColor,
        }
    end

    return Themes.RJTheme3
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 5)
    c.Parent = parent
    return c
end

local function padding(parent, l, r, t, b)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, l or 0)
    p.PaddingRight = UDim.new(0, r or 0)
    p.PaddingTop = UDim.new(0, t or 0)
    p.PaddingBottom = UDim.new(0, b or 0)
    p.Parent = parent
    return p
end

local function tweenObject(instance, duration, properties, easingStyle, easingDirection)
    local info = TweenInfo.new(
        duration,
        easingStyle or Enum.EasingStyle.Quad,
        easingDirection or Enum.EasingDirection.Out
    )

    local t = TweenService:Create(instance, info, properties)
    t:Play()

    return t
end

local function getRoot()
    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

