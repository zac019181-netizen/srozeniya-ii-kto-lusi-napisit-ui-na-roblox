                    21

                local Bar =
                    Instance.new(
                        "Frame"
                    )

                Bar.Size =
                    UDim2.new(
                        1,
                        -20,
                        0,
                        6
                    )

                Bar.Position =
                    UDim2.new(
                        0,
                        10,
                        1,
                        -13
                    )

                Bar.BackgroundColor3 =
                    Color3.fromRGB(
                        55,
                        55,
                        55
                    )

                Bar.Parent =
                    Slider

                Bar.ZIndex =
                    21

                corner(
                    Bar,
                    5
                )

                local Fill =
                    Instance.new(
                        "Frame"
                    )

                Fill.BackgroundColor3 =
                    theme.SchemeColor

                Fill.Parent =
                    Bar

                Fill.ZIndex =
                    22

                corner(
                    Fill,
                    5
                )

                local function redraw()

                    local alpha

                    if max == min then

                        alpha = 1

                    else

                        alpha =
                            (
                                Value - min
                            )
                            /
                            (
                                max - min
                            )

                    end

                    alpha =
                        math.clamp(
                            alpha,
                            0,
                            1
                        )

                    Fill.Size =
                        UDim2.new(
                            alpha,
                            0,
                            1,
                            0
                        )

                    ValueLabel.Text =
                        tostring(
                            Value
                        )

                end

                local function updateFromMouse(
                    mouseX,
                    callCallback
                )

                    local left =
                        Bar.AbsolutePosition.X

                    local width =
                        Bar.AbsoluteSize.X

                    if width <= 0 then
                        return
                    end

                    local alpha =
                        math.clamp(
                            (
                                mouseX -
                                left
                            )
                            /
                            width,
                            0,
                            1
                        )

                    if max == min then

                        Value =
                            min

                    else

                        Value =
                            min
                            + (
                                max - min
                            )
                            * alpha

                        Value =
                            math.floor(
                                Value + 0.5
                            )

                    end

                    redraw()

                    if callCallback then

                        safeCall(
                            callback,
                            Value
                        )

                    end

                end

                redraw()

                register(
                    Slider,
                    function()

                        local point =
                            getMouseSurfacePosition()

                        if not point then
                            return
                        end

                        ActiveSlider = {
                            Update = function(
                                x
                            )

                                updateFromMouse(
                                    x,
                                    true
                                )

                            end
                        }

                        updateFromMouse(
                            point.X,
                            true
                        )

                    end
                )

                local Object = {
                    Instance =
                        Slider
                }

                function Object:Set(
                    value
                )

                    value =
                        tonumber(value)
                        or min

                    Value =
                        math.clamp(
                            value,
                            min,
                            max
                        )

                    Value =
                        math.floor(
                            Value + 0.5
                        )

                    redraw()

                    safeCall(
                        callback,
                        Value
                    )

                end

                function Object:Get()

                    return Value

                end

                return Object
            end

