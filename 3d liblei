    ----------------------------------------------------------------
    -- REGISTER HITBOX
    ----------------------------------------------------------------

    local Hitboxes = {}

    local function register(gui, callback)
        Hitboxes[gui] = callback

        return gui
    end

    ----------------------------------------------------------------
    -- MOUSE POSITION -> SURFACE
    ----------------------------------------------------------------

    local function getMouseSurfacePosition()
        local mouseLocation = UserInputService:GetMouseLocation()

        local viewportRay = Camera:ViewportPointToRay(
            mouseLocation.X,
            mouseLocation.Y
        )

        local origin = viewportRay.Origin
        local direction = viewportRay.Direction * 500

        local normal = WindowPart.CFrame.LookVector

        local denominator = normal:Dot(direction)

        if math.abs(denominator) < 0.00001 then
            return nil
        end

        local distance =
            normal:Dot(WindowPart.Position - origin)
            / denominator

        if distance < 0 then
            return nil
        end

        local hit = origin + direction.Unit * distance

        local localPoint = WindowPart.CFrame:PointToObjectSpace(hit)

        local halfX = WindowPart.Size.X / 2
        local halfY = WindowPart.Size.Y / 2

        local x = (localPoint.X + halfX) / WindowPart.Size.X
        local y = (-localPoint.Y + halfY) / WindowPart.Size.Y

        if x < 0 or x > 1 or y < 0 or y > 1 then
            return nil
        end

        local absoluteX = x * Surface.AbsoluteSize.X
        local absoluteY = y * Surface.AbsoluteSize.Y

        return Vector2.new(absoluteX, absoluteY)
    end

    ----------------------------------------------------------------
    -- HIT TEST
    ----------------------------------------------------------------

    local function pointInside(gui, point)
        if not gui.Visible then
            return false
        end

        local position = gui.AbsolutePosition
        local size = gui.AbsoluteSize

        return point.X >= position.X
            and point.X <= position.X + size.X
            and point.Y >= position.Y
            and point.Y <= position.Y + size.Y
    end

    local function fireAtPoint(point)
        local best = nil
        local bestZ = -math.huge

        for gui, callback in pairs(Hitboxes) do
            if gui.Parent and gui.Visible then
                if pointInside(gui, point) then
                    local z = gui.ZIndex

                    if z >= bestZ then
                        best = callback
                        bestZ = z
                    end
                end
            end
        end

        if best then
            return best()
        end
    end

    ----------------------------------------------------------------
    -- RIGHT CLICK
    ----------------------------------------------------------------

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseButton2 then
            return
        end

        if not self.Visible then
            return
        end

        local point = getMouseSurfacePosition()

        if not point then
            return
        end

        fireAtPoint(point)
    end)

    ----------------------------------------------------------------
    -- SLIDER DRAG
    ----------------------------------------------------------------

    local ActiveSlider = nil

    UserInputService.InputChanged:Connect(function(input)
        if not ActiveSlider then
            return
        end

        if input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end

        local point = getMouseSurfacePosition()

        if not point then
            return
        end

        ActiveSlider.Update(point.X)
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            ActiveSlider = nil
        end
    end)

    ----------------------------------------------------------------
    -- FADE
    ----------------------------------------------------------------

    local function collectFadeObjects()
        local objects = {}

        for _, object in ipairs(Surface:GetDescendants()) do
            if object:IsA("GuiObject") then
                if object:IsA("TextLabel")
                    or object:IsA("TextButton")
                    or object:IsA("TextBox") then

                    table.insert(objects, {
                        object = object,
                        property = "TextTransparency",
                        hidden = 1,
                        visible = object.TextTransparency
                    })

                elseif object:IsA("ImageLabel")
                    or object:IsA("ImageButton") then

                    table.insert(objects, {
                        object = object,
                        property = "ImageTransparency",
                        hidden = 1,
                        visible = object.ImageTransparency
                    })
                end

                table.insert(objects, {
                    object = object,
                    property = "BackgroundTransparency",
                    hidden = 1,
                    visible = object.BackgroundTransparency
                })
            end
        end

        return objects
    end

    local function setGuiTransparency(alpha)
        for _, object in ipairs(Surface:GetDescendants()) do
            if object:IsA("GuiObject") then

                if object:IsA("TextLabel")
                    or object:IsA("TextButton")
                    or object:IsA("TextBox") then

                    object.TextTransparency = alpha

                elseif object:IsA("ImageLabel")
                    or object:IsA("ImageButton") then

                    object.ImageTransparency = alpha
                end

                if object.BackgroundTransparency < 1 then
                    object.BackgroundTransparency = alpha
                end
            end
        end
    end

    ----------------------------------------------------------------
    -- SHOW
    ----------------------------------------------------------------

    function self:Show()
        if self.Visible then
            return
        end

        self.Visible = true

        WindowPart.Transparency = 1

        setGuiTransparency(1)

        local steps = 10

        for i = steps, 0, -1 do
            local alpha = i / steps

            WindowPart.Transparency = alpha

            setGuiTransparency(alpha)

            task.wait(self.FadeDuration / steps)
        end

        WindowPart.Transparency = 0

        setGuiTransparency(0)
    end

    ----------------------------------------------------------------
    -- HIDE
    ----------------------------------------------------------------

    function self:Hide()
        if not self.Visible then
            return
        end

        self.Visible = false

        local steps = 10

        for i = 0, steps do
            local alpha = i / steps

            WindowPart.Transparency = alpha

            setGuiTransparency(alpha)

            task.wait(self.FadeDuration / steps)
        end

        WindowPart.Transparency = 1

        setGuiTransparency(1)
    end

    function self:ToggleUI()
        if self.Visible then
            self:Hide()
        else
            self:Show()
        end
    end

    ----------------------------------------------------------------
    -- FOLLOW PLAYER WHILE HIDDEN
    ----------------------------------------------------------------

    RunService.RenderStepped:Connect(function()
        if self.Visible then
            return
        end

        local root = getRoot()

        if not root then
            return
        end

        WindowPart.CFrame =
            root.CFrame
            * self.FollowOffset
    end)

