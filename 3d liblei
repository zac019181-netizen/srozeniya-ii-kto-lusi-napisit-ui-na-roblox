                        0,
                        10,
                        1,
                        -13
                    )

                Bar.BackgroundColor3 =
                    Color3.fromRGB(
                        55,
                        55,
                        55
                    )

                Bar.Parent =
                    Slider

                Bar.ZIndex = 6

                addCorner(
                    Bar,
                    5
                )

                local Fill =
                    Instance.new("Frame")

                Fill.BackgroundColor3 =
                    theme.SchemeColor

                Fill.Size =
                    UDim2.new(
                        0,
                        0,
                        1,
                        0
                    )

                Fill.Parent =
                    Bar

                Fill.ZIndex = 7

                addCorner(
                    Fill,
                    5
                )

                local function getPercent()
                    if max == min then
                        return 1
                    end

                    return math.clamp(
                        (Value - min)
                        / (max - min),
                        0,
                        1
                    )
                end

                local function redraw(
                    fire
                )

                    local percent =
                        getPercent()

                    Fill.Size =
                        UDim2.new(
                            percent,
                            0,
                            1,
                            0
                        )

                    ValueLabel.Text =
                        tostring(Value)

                    if fire then

                        safeCallback(
                            callback,
                            Value
                        )

                    end

                end

                local function setFromX(
                    x,
                    fire
                )

                    local left =
                        Bar.AbsolutePosition.X

                    local width =
                        Bar.AbsoluteSize.X

                    if width <= 0 then
                        return
                    end

                    local alpha =
                        math.clamp(
                            (x - left)
                            / width,
                            0,
                            1
                        )

                    if max == min then
                        Value = min
                    else
                        Value =
                            min
                            + (
                                max - min
                            ) * alpha

                        Value =
                            math.floor(
                                Value + 0.5
                            )
                    end

                    redraw(fire)

                end

                redraw(false)

                register(
                    Slider,
                    function()

                        local point =
                            getMouseSurfacePosition()

                        if not point then
                            return
                        end

                        ActiveSlider = {
                            Update = function(x)
                                setFromX(
                                    x,
                                    true
                                )
                            end
                        }

                        setFromX(
                            point.X,
                            true
                        )

                    end
                )

                local Object = {
                    Instance = Slider
                }

                function Object:Set(
                    value
                )

                    value =
                        tonumber(value)
                        or min

                    value =
                        math.clamp(
                            value,
                            min,
                            max
                        )

                    Value =
                        math.floor(
                            value + 0.5
                        )

                    redraw(true)

                end

                function Object:Get()
                    return Value
                end

                return Object

            end

