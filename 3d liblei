    function self:ChangeColor(
        property,
        color
    )

        if self.Theme[property] == nil then
            return
        end

        self.Theme[property] =
            color

        if property == "Background" then
            Main.BackgroundColor3 =
                color
        end

        if property == "Header" then
            Header.BackgroundColor3 =
                color

            Side.BackgroundColor3 =
                color

            HeaderCover.BackgroundColor3 =
                color
        end

        if property == "TextColor" then
            Title.TextColor3 =
                color
        end

        if property == "SchemeColor" then

            for _, object in ipairs(
                Surface:GetDescendants()
            ) do

                if object:IsA(
                    "TextLabel"
                )
                and object.Parent == Side then

                    object.BackgroundColor3 =
                        color

                end
            end

        end

    end

    ------------------------------------------------------------
    -- SETTINGS TAB
    ------------------------------------------------------------

    local SettingsTab =
        self:NewTab("Settings")

    local Settings =
        SettingsTab:NewSection(
            "Interface"
        )

    ------------------------------------------------------------
    -- TOGGLE KEY
    ------------------------------------------------------------

    local ToggleKey =
        Settings:NewKeybind(
            "Toggle UI",
            "Open / close",
            Enum.KeyCode.Tab,
            function(key)

                self:SetToggleKey(key)

            end
        )

    ------------------------------------------------------------
    -- SIZE
    ------------------------------------------------------------

    Settings:NewSlider(
        "GUI Size",
        "Change physical GUI size",
        200,
        50,
        100,
        function(value)

            self:SetSizeMultiplier(
                value / 100
            )

        end
    )

    ------------------------------------------------------------
    -- FADE SPEED
    ------------------------------------------------------------

    Settings:NewSlider(
        "Fade Speed",
        "Animation duration",
        200,
        5,
        25,
        function(value)

            self:SetFadeDuration(
                value / 100
            )

        end
    )

    ------------------------------------------------------------
    -- INFO
    ------------------------------------------------------------

    Settings:NewLabel(
        "RMB = interact"
    )

    Settings:NewLabel(
        "Tab = open / close"
    )

    ------------------------------------------------------------
    -- INITIAL STATE
    ------------------------------------------------------------

    self.Visible = false

    self.Animating = false

    WindowPart.Transparency = 1

    setGuiTransparency(1)

    local initial =
        getFollowCFrame()

    if initial then
        WindowPart.CFrame =
            initial
    end

    return self
end

return Library
