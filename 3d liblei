            ----------------------------------------------------
            -- ELEMENT API
            ----------------------------------------------------

            local Elements = {}

            ----------------------------------------------------
            -- BUTTON
            ----------------------------------------------------

            function Elements:NewButton(
                name,
                tip,
                callback
            )

                callback =
                    callback or function() end

                local Button =
                    Instance.new("TextLabel")

                Button.Name =
                    name or "Button"

                Button.Size =
                    UDim2.new(
                        1,
                        0,
                        0,
                        34
