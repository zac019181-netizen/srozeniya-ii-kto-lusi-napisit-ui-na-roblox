    -- -------------------------------------------------------------
    local isOpen = true
    local currentToggleTween = nil

    local function ToggleUI()
        isOpen = not isOpen
        if currentToggleTween then
            currentToggleTween:Cancel()
        end

        if isOpen then
            MainFrame.Visible = true
            currentToggleTween = TweenService:Create(MainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = OriginalSize
            })
            currentToggleTween:Play()
        else
            currentToggleTween = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Size = ClosedSize
            })
            currentToggleTween:Play()
            currentToggleTween.Completed:Connect(function()
                if not isOpen then
                    MainFrame.Visible = false
                end
            end)
        end
    end

    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.RightShift then
            ToggleUI()
        end
    end)

