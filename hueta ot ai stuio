function Library:CreateWatermark(options)
    options = options or {}
    local config = {
        Enabled = options.Enabled ~= false,
        Icon = true, -- Всегда true, нельзя выключить
        Title = options.Title ~= false,
        FPS = options.FPS ~= false,
        Ping = options.Ping ~= false,
        Player = options.Player ~= false,
        Time = options.Time ~= false,
        Position = options.Position or "Left",
        ScriptName = options.ScriptName or "Moonlight"
    }

    local WatermarkGui = Instance.new("ScreenGui")
    WatermarkGui.Name = "Moonlight_Watermark"
    WatermarkGui.ResetOnSpawn = false
    WatermarkGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    WatermarkGui.Parent = GetGuiParent()

    local Bar = Instance.new("Frame")
    Bar.Name = "WatermarkBar"
    Bar.Size = UDim2.new(0, 0, 0, 26)
    Bar.AutomaticSize = Enum.AutomaticSize.X
    Bar.BackgroundColor3 = self:GetTheme().WatermarkBg
    Bar.BorderSizePixel = 0
    Bar.Visible = config.Enabled
    Bar.Parent = WatermarkGui

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = Bar

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = self:GetTheme().Border
    Stroke.Thickness = 1
    Stroke.Parent = Bar

    local Layout = Instance.new("UIListLayout")
    Layout.FillDirection = Enum.FillDirection.Horizontal
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    Layout.VerticalAlignment = Enum.VerticalAlignment.Center
    Layout.Padding = UDim.new(0, 8)
    Layout.Parent = Bar

    local Padding = Instance.new("UIPadding")
    Padding.PaddingLeft = UDim.new(0, 8)
    Padding.PaddingRight = UDim.new(0, 10)
    Padding.Parent = Bar

    self:RegisterThemeObject(Bar, "BackgroundColor3", "WatermarkBg")
    self:RegisterThemeObject(Stroke, "Color", "Border")

    -- Constant Moon Icon (Нельзя скрыть)
    local Icon = Instance.new("ImageLabel")
    Icon.Name = "ConstantIcon"
    Icon.Size = UDim2.new(0, 14, 0, 14)
    Icon.BackgroundTransparency = 1
    Icon.Image = "rbxassetid://6031075931" -- Clean Moon icon
    Icon.ImageColor3 = Color3.fromRGB(240, 240, 245)
    Icon.Parent = Bar

    local TextDisplay = Instance.new("TextLabel")
    TextDisplay.Name = "Metrics"
    TextDisplay.Font = Enum.Font.GothamMedium
    TextDisplay.TextSize = 12
    TextDisplay.TextColor3 = self:GetTheme().Text
    TextDisplay.BackgroundTransparency = 1
    TextDisplay.Size = UDim2.new(0, 0, 1, 0)
    TextDisplay.AutomaticSize = Enum.AutomaticSize.X
    TextDisplay.Parent = Bar
    self:RegisterThemeObject(TextDisplay, "TextColor3", "Text")

    local function updatePosition()
        if config.Position == "Right" then
            Bar.AnchorPoint = Vector2.new(1, 0)
            Bar.Position = UDim2.new(1, -20, 0, 15)
        else
            Bar.AnchorPoint = Vector2.new(0, 0)
            Bar.Position = UDim2.new(0, 20, 0, 15)
        end
    end
    updatePosition()

    -- Metrics loop (FPS / Ping calculation)
    local fps = 60
    local frameCount = 0
    local lastCheck = tick()

    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local now = tick()
        if now - lastCheck >= 1 then
            fps = frameCount
            frameCount = 0
            lastCheck = now
        end
    end)

    task.spawn(function()
        while Bar and Bar.Parent do
            if config.Enabled then
                local parts = {}
                if config.Title then
                    table.insert(parts, config.ScriptName)
                end
                if config.Player then
                    table.insert(parts, LocalPlayer.DisplayName or LocalPlayer.Name)
                end
                if config.FPS then
                    table.insert(parts, tostring(fps) .. " fps")
                end
                if config.Ping then
                    local ping = math.floor(LocalPlayer:GetNetworkPing() * 1000)
                    table.insert(parts, tostring(ping) .. " ms")
                end
                if config.Time then
                    table.insert(parts, os.date("%X"))
                end

                TextDisplay.Text = table.concat(parts, "  |  ")
            end
            task.wait(0.5)
        end
    end)

    local WatermarkController = {}
    function WatermarkController:SetPosition(pos)
        config.Position = pos
        updatePosition()
    end
    function WatermarkController:SetVisible(val)
        config.Enabled = val
        Bar.Visible = val
    end
    function WatermarkController:ToggleSection(section, val)
        if section ~= "Icon" and config[section] ~= nil then
            config[section] = val
        end
    end
    return WatermarkController
end

