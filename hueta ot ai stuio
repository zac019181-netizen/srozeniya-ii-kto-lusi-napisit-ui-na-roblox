            -- selected config
        end
    })

    SettingsTab:AddButton({
        Name = "Save Selected Config",
        Callback = function()
            local cfg = Library.Flags["Configuration"] or "Default"
            Library:SaveConfig(cfg)
            configDropdown:Refresh(Library:GetConfigList())
        end
    })

    SettingsTab:AddButton({
        Name = "Load Selected Config",
        Callback = function()
            local cfg = Library.Flags["Configuration"] or "Default"
            Library:LoadConfig(cfg)
        end
    })

    SettingsTab:AddButton({
        Name = "Delete Selected Config",
        Callback = function()
            local cfg = Library.Flags["Configuration"] or "Default"
            Library:DeleteConfig(cfg)
            configDropdown:Refresh(Library:GetConfigList())
        end
    })

    return WindowController
end

return Library
