function Library:GetTheme()
    return self.Themes[self.CurrentTheme] or self.Themes["Default Dark"]
end

function Library:RegisterThemeObject(instance, property, themeKey)
    table.insert(self.ThemeObjects, {
        Instance = instance,
        Property = property,
        Key = themeKey
    })
    local currentTheme = self:GetTheme()
    if currentTheme[themeKey] then
        instance[property] = currentTheme[themeKey]
    end
end

function Library:SetTheme(themeName)
    if not self.Themes[themeName] then return end
    self.CurrentTheme = themeName
    local theme = self:GetTheme()
    for _, obj in ipairs(self.ThemeObjects) do
        if obj.Instance and obj.Instance.Parent and theme[obj.Key] then
            TweenService:Create(obj.Instance, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                [obj.Property] = theme[obj.Key]
            }):Play()
        end
    end
end

-- ====================================================================
-- 💾 CONFIG SYSTEM
-- ====================================================================
local ConfigFolder = "MoonlightConfigs"
local function HasFileSystem()
    return pcall(function()
        return makefolder and isfolder and writefile and readfile and isfile and listfiles
    end) and makefolder ~= nil
end

if HasFileSystem() and not isfolder(ConfigFolder) then
    pcall(makefolder, ConfigFolder)
end

function Library:SaveConfig(name)
    if not name or name == "" then return false end
    local data = {}
    for flag, value in pairs(self.Flags) do
        data[flag] = value
    end
    local json = HttpService:JSONEncode(data)
    if HasFileSystem() then
        pcall(writefile, ConfigFolder .. "/" .. name .. ".json", json)
    else
        self.Configs[name] = json
    end
    self:Notify({ Title = "Config", Text = "Configuration '" .. name .. "' saved successfully!", Duration = 3 })
    return true
end

function Library:LoadConfig(name)
    if not name or name == "" then return false end
    local json = nil
    if HasFileSystem() then
        local path = ConfigFolder .. "/" .. name .. ".json"
        if isfile(path) then
            pcall(function() json = readfile(path) end)
        end
    else
        json = self.Configs[name]
    end

    if not json then
        self:Notify({ Title = "Config Error", Text = "Config not found!", Duration = 3 })
        return false
    end

    local success, data = pcall(function() return HttpService:JSONDecode(json) end)
    if success and type(data) == "table" then
        for flag, value in pairs(data) do
            if self.Elements[flag] and self.Elements[flag].Set then
                self.Elements[flag]:Set(value, true)
            else
                self.Flags[flag] = value
            end
        end
        self:Notify({ Title = "Config", Text = "Configuration loaded!", Duration = 3 })
        return true
    end
    return false
end

function Library:DeleteConfig(name)
    if HasFileSystem() then
        local path = ConfigFolder .. "/" .. name .. ".json"
        if isfile(path) then
            pcall(delfile, path)
        end
    else
        self.Configs[name] = nil
    end
    self:Notify({ Title = "Config", Text = "Configuration '" .. name .. "' deleted.", Duration = 3 })
end

function Library:GetConfigList()
    local list = {}
    if HasFileSystem() then
        local files = pcall(listfiles, ConfigFolder) and listfiles(ConfigFolder) or {}
        for _, file in ipairs(files) do
            local cleanName = file:match("([^/\\]+)%.json$")
            if cleanName then table.insert(list, cleanName) end
        end
    else
        for name, _ in pairs(self.Configs) do
            table.insert(list, name)
        end
    end
    if #list == 0 then table.insert(list, "Default") end
    return list
end

