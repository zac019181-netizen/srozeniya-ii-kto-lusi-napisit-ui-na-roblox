            ValLabel.Size = UDim2.new(0, 56, 0, 14)
            ValLabel.Parent = Container

            local Track = Instance.new("Frame")
            Track.Size = UDim2.new(1, -28, 0, 6)
            Track.Position = UDim2.new(0, 14, 0, 32)
            Track.BackgroundColor3 = Library:GetTheme().SliderBackground
            Track.BorderSizePixel = 0
            Track.Parent = Container

            local TrackCorner = Instance.new("UICorner")
            TrackCorner.CornerRadius = UDim.new(1, 0)
            TrackCorner.Parent = Track

            local Fill = Instance.new("Frame")
            local initPct = (Default - Min) / (Max - Min)
            Fill.Size = UDim2.new(initPct, 0, 1, 0)
            Fill.BackgroundColor3 = Library:GetTheme().SliderFill
            Fill.BorderSizePixel = 0
            Fill.Parent = Track

            local FillCorner = Instance.new("UICorner")
            FillCorner.CornerRadius = UDim.new(1, 0)
            FillCorner.Parent = Fill

            local Thumb = Instance.new("Frame")
            Thumb.Size = UDim2.new(0, 12, 0, 12)
            Thumb.AnchorPoint = Vector2.new(0.5, 0.5)
            Thumb.Position = UDim2.new(initPct, 0, 0.5, 0)
            Thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Thumb.BorderSizePixel = 0
            Thumb.Parent = Track

            Instance.new("UICorner", Thumb).CornerRadius = UDim.new(1, 0)

            Library:RegisterThemeObject(Container, "BackgroundColor3", "Element")
            Library:RegisterThemeObject(Stroke, "Color", "Border")
            Library:RegisterThemeObject(Title, "TextColor3", "TextDark")
            Library:RegisterThemeObject(ValLabel, "TextColor3", "Text")
            Library:RegisterThemeObject(Track, "BackgroundColor3", "SliderBackground")
            Library:RegisterThemeObject(Fill, "BackgroundColor3", "SliderFill")

            local function SetValue(val, skipCallback)
                val = math.clamp(math.round((val - Min) / Increment) * Increment + Min, Min, Max)
                CurrentVal = val
                Library.Flags[Flag] = CurrentVal
                ValLabel.Text = tostring(CurrentVal)

                local pct = (CurrentVal - Min) / (Max - Min)
                TweenService:Create(Fill, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Size = UDim2.new(pct, 0, 1, 0)
                }):Play()
                TweenService:Create(Thumb, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    Position = UDim2.new(pct, 0, 0.5, 0)
                }):Play()

                if not skipCallback then
                    Callback(CurrentVal)
                end
            end

            local isDragging = false
            local function ProcessInput(input)
                local pct = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                SetValue(Min + ((Max - Min) * pct))
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    isDragging = true
                    ProcessInput(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    isDragging = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if isDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    ProcessInput(input)
                end
            end)

            local Item = {
                Set = function(_, v, skip) SetValue(v, skip) end
            }
            Library.Elements[Flag] = Item
            return Item
        end

